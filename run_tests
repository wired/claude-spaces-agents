# The real script, in a terminal: it builds the window, lists the sessions,
# survives a detach, and is attached to again without a second server.
test_e2e_launch_detach_reattach() {
  fake_add aaaaaaa1 done idle "Fix the login bug" "$(e2e_project a)"
  e2e_launch a
  e2e_wait_up a || { fail "the picker never came up: $(e2e_outer_text | tail -3)"; return 1; }
  local inner st panes
  inner=$(e2e_inner a)
  st=$(e2e_state a)
  panes=$(tmux -L "${inner}" list-panes -a | wc -l | tr -d ' ')
  assert_eq "panes" "${panes}" "2" || return 1
  local i
  for ((i = 0; i < 40; i++)); do
    e2e_picker_text a | grep -q "Fix the login bug" && break
    sleep 0.1
  done
  e2e_picker_text a | grep -q "Fix the login bug" || { fail "the session is not listed"; return 1; }
  assert_eq "picker width" "$(tmux -L "${inner}" display-message -p -t "$(cat "${st}/picker_pane")" '#{pane_width}')" "30" || return 1
  assert_eq "title recording is on" "$(tmux -L "${inner}" show -gwv allow-set-title)" "on" || return 1

  # Enter shows the session
  e2e_keys a Enter
  wait_for "${FAKE_CLAUDE_DIR}/attach.log" || { fail "Enter did not show the session"; return 1; }
  assert_eq "displayed" "$(cat "${st}/displayed")" "aaaaaaa1" || return 1

  local picker
  picker=$(cat "${st}/picker_pane")
  tmux -L "${inner}" select-pane -t "${picker}"
  e2e_keys a Q
  e2e_wait_outer "launcher exit=0" || { fail "the launcher did not exit on detach"; return 1; }
  tmux -L "${inner}" has-session 2>/dev/null || { fail "detaching ended the server"; return 1; }

  e2e_launch a
  for ((i = 0; i < 50; i++)); do
    [[ "$(tmux -L "${inner}" list-clients 2>/dev/null | wc -l | tr -d ' ')" == "1" ]] && break
    sleep 0.1
  done
  assert_eq "clients after relaunch" "$(tmux -L "${inner}" list-clients | wc -l | tr -d ' ')" "1" || return 1
  assert_eq "the same picker pane" "$(cat "${st}/picker_pane")" "${picker}" || return 1
  assert_eq "still displayed" "$(cat "${st}/displayed")" "aaaaaaa1"
}

# The prefix table: the keys this tool binds, and none it should not.
test_e2e_prefix_table() {
  e2e_launch a
  e2e_wait_up a || { fail "the picker never came up"; return 1; }
  local keys
  keys=$(tmux -L "$(e2e_inner a)" list-keys -T prefix | sed 's/  */ /g')
  local want
  for want in 'prefix v send-keys' 'prefix x send-keys' 'prefix D send-keys' 'prefix c send-keys' \
              'prefix ` send-keys' 'prefix Tab send-keys' 'prefix q send-keys' 'prefix t send-keys'; do
    [[ "${keys}" == *"${want}"* ]] || { fail "not bound: ${want}"; return 1; }
  done
  [[ "${keys}" == *'prefix a send-keys `'* ]] || { fail "prefix a is not the literal grave"; return 1; }
  if [[ "${keys}" == *"prefix f "* ]]; then
    fail "prefix f is still bound"
    return 1
  fi
}

# A Claude that cannot list sessions: say so, and start nothing.
test_e2e_preflight_refuses() {
  touch "${FAKE_CLAUDE_DIR}/fail"
  e2e_launch a
  e2e_wait_outer "launcher exit=1" || { fail "the launcher did not refuse: $(e2e_outer_text | tail -3)"; return 1; }
  e2e_outer_text | grep -q "simulated failure" || { fail "Claude's message is not shown"; return 1; }
  if tmux -L "$(e2e_inner a)" has-session 2>/dev/null; then
    fail "a server was started anyway"
    return 1
  fi
}

# New code in front of an old server: the picker stops the server and the
# launcher explains, instead of running against a layout it did not build.
test_e2e_compat_gate() {
  e2e_launch a
  e2e_wait_up a || { fail "the picker never came up"; return 1; }
  echo "0" > "$(e2e_state a)/compat_version"
  e2e_keys a R
  e2e_wait_outer "layout changed" || { fail "the launcher did not explain: $(e2e_outer_text | tail -3)"; return 1; }
  if tmux -L "$(e2e_inner a)" has-session 2>/dev/null; then
    fail "the old server is still running"
    return 1
  fi
  [[ ! -f "$(e2e_state a)/restart_required" ]] || { fail "the marker was not consumed"; return 1; }
}

# Parking with a real client attached. A new window takes the client's size, so
# the slot has to be pinned for the terminal to move into it without a resize.
# A resize of the real terminal afterwards does not reach a parked terminal.
test_e2e_parking_keeps_terminal_size() {
  fake_add aaaaaaa1 done idle "Alpha" "$(e2e_project a)"
  fake_add aaaaaaa2 done idle "Beta" "$(e2e_project a)"
  e2e_launch a
  e2e_wait_up a || { fail "the picker never came up"; return 1; }
  local inner st i first tp size
  inner=$(e2e_inner a)
  st=$(e2e_state a)
  for ((i = 0; i < 40; i++)); do
    e2e_picker_text a | grep -q "Beta" && break
    sleep 0.1
  done
  # show the first row's session and open its terminal
  e2e_keys a Enter
  for ((i = 0; i < 40; i++)); do
    [[ -s "${st}/displayed" ]] && break
    sleep 0.1
  done
  first=$(cat "${st}/displayed")
  [[ -n "${first}" ]] || { fail "Enter showed nothing"; return 1; }
  e2e_keys a '`'
  wait_for "${st}/term/${first}" || { fail "the terminal key opened nothing"; return 1; }
  tp=$(cat "${st}/term/${first}")
  sleep 0.3
  size=$(tmux -L "${inner}" display-message -p -t "${tp}" '#{pane_width}x#{pane_height}')
  # the other session: the terminal is parked
  e2e_keys a j Enter
  for ((i = 0; i < 40; i++)); do
    [[ "$(cat "${st}/displayed")" != "${first}" ]] && break
    sleep 0.1
  done
  [[ "$(cat "${st}/displayed")" != "${first}" ]] || { fail "the second session was not shown"; return 1; }
  sleep 0.3
  local main_win
  main_win=$(tmux -L "${inner}" display-message -p -t "$(cat "${st}/picker_pane")" '#{window_id}')
  [[ "$(tmux -L "${inner}" display-message -p -t "${tp}" '#{window_id}')" != "${main_win}" ]] \
    || { fail "the terminal was not parked"; return 1; }
  assert_eq "the terminal's size once parked" \
    "$(tmux -L "${inner}" display-message -p -t "${tp}" '#{pane_width}x#{pane_height}')" "${size}" || return 1

  tmux -L "${E2E_OUTER}" resize-window -t o -x 110 -y 32
  for ((i = 0; i < 40; i++)); do
    [[ "$(tmux -L "${inner}" display-message -p -t "$(cat "${st}/picker_pane")" '#{window_width}')" == "110" ]] && break
    sleep 0.1
  done
  assert_eq "the resize reached the view" \
    "$(tmux -L "${inner}" display-message -p -t "$(cat "${st}/picker_pane")" '#{window_width}')" "110" || return 1
  sleep 0.3
  assert_eq "the parked terminal's size after the real terminal was resized" \
    "$(tmux -L "${inner}" display-message -p -t "${tp}" '#{pane_width}x#{pane_height}')" "${size}"
}

# Selecting another project's session hops to that project's own view, which is
# started for the occasion, and shows the session there.
test_e2e_hop() {
  fake_add bbbbbbb1 done idle "Over there" "$(e2e_project b)"
  e2e_launch a
  e2e_wait_up a || { fail "the picker never came up"; return 1; }
  local i
  for ((i = 0; i < 40; i++)); do
    e2e_picker_text a | grep -q "Over there" && break
    sleep 0.1
  done
  e2e_picker_text a | grep -q "Over there" || { fail "the other project's session is not listed"; return 1; }
  # the cursor starts on the project row; the session is the next one
  e2e_keys a j Enter
  e2e_wait_up b || { fail "the other project's view never came up: $(e2e_outer_text | tail -3)"; return 1; }
  local stb
  stb=$(e2e_state b)
  for ((i = 0; i < 60; i++)); do
    [[ "$(cat "${stb}/displayed" 2>/dev/null)" == "bbbbbbb1" ]] && break
    sleep 0.1
  done
  assert_eq "displayed in the other project" "$(cat "${stb}/displayed" 2>/dev/null)" "bbbbbbb1" || return 1
  assert_eq "attached" "$(tail -1 "${FAKE_CLAUDE_DIR}/attach.log")" "bbbbbbb1" || return 1
  [[ ! -f "${stb}/pending_load" ]] || { fail "pending_load was not consumed"; return 1; }
  [[ ! -f "$(e2e_state a)/switch_target" ]] || { fail "switch_target was not consumed"; return 1; }
  tmux -L "$(e2e_inner a)" has-session 2>/dev/null || { fail "the first project's server was ended by the hop"; return 1; }
}

