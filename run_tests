}

cs_test_teardown() {
  e2e_cleanup
  _tmux kill-server 2>/dev/null || true
  # tmux leaves the socket file of a server that ended
  rm -f "${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)/${TMUX_SERVER}"
  rm -rf "${TEST_TMP}"
}

cs_test_reset() {
  e2e_cleanup
  rm -rf "${FAKE_CLAUDE_DIR}" "${SEEN_DIR}" "${PROJECTS_DIR}/proj" "${STATE_DIR}/term"
  mkdir -p "${FAKE_CLAUDE_DIR}" "${SEEN_DIR}" "${PROJECTS_DIR}/proj" "${STATE_DIR}/term"
  rm -rf "${PWD}/.claude"
  echo '[]' > "${FAKE_CLAUDE_DIR}/list.json"
  rm -f "${STATE_DIR}/displayed" "${STATE_DIR}/new_session" "${STATE_DIR}/poll.err"
  rm -f "${STATE_DIR}/switch_target" "${STATE_DIR}/pending_load"
  rm -f "${CS_STATE_ROOT}/agents.json"
  : > "${CONFIG_FILE}"
  : > "${PROJECT_NAMES_FILE}"

  AG_IDS=()
  AG_STATE=(); AG_STATUS=(); AG_SID=(); AG_CWD=(); AG_NAME=(); AG_STARTED=()
  AG_TPATH=(); AG_TMTIME=(); AG_ACT=(); AG_ACT_SRC=()
  SEEN_AT=(); UNSEEN_SET=(); SEEN_ABSENT=(); TERM_ABSENT=()
  PROJECT_NAMES=()
  REMOTE_SERVERS=()
  OTHER_PROJECTS_KEY=""
  POLL_ERROR=""
  POLLED=0
  LAST_POLL=0
  FOOTER_MSG=""
  DISPLAYED=""
  SHOWN=""
  WINDOW_FOCUSED=1
  PICKER_WIDTH="30"
  PICKER_SIDE="right"
  RECENT_THRESHOLD=10
  TERMINAL_HEIGHT="35%"
  TERMINAL_WIDTH="45%"
  # The 120-column test window can't fit a side terminal next to the default minimum (60)
  MIN_CLAUDE_WIDTH=10
  MIN_CLAUDE_HEIGHT=10
  cs_entry_clear
  SELECTED=0
  SCROLL=0

  # every pane but the picker and the client: terminals, parked or not, and
  # anything a test left behind
  local p
  cs_read_state_into CLIENT_PANE client_pane
  while read -r p; do
    [[ -n "${p}" ]] || continue
    [[ "${p}" == "${PICKER_PANE}" || "${p}" == "${CLIENT_PANE}" ]] && continue
    _tmux kill-pane -t "${p}" 2>/dev/null || true
  done < <(_tmux list-panes -a -F '#{pane_id}' 2>/dev/null)
  _tmux resize-window -t "${PICKER_PANE}" -x 120 -y 40 2>/dev/null || true

  # a test may have killed the client pane
  cs_client_ensure
  cs_show_welcome
  _tmux resize-pane -t "${PICKER_PANE}" -x "${PICKER_WIDTH}" 2>/dev/null || true
  _tmux select-pane -t "${PICKER_PANE}"
  sleep 0.1
}

# ── Test runner ──────────────────────────────────
run_test() {
  local name="$1"
  shift
  if [[ -n "${ONLY}" && "$1" != "${ONLY}" ]]; then
    return 0
  fi
  cs_test_reset
  echo -n "  ${name} ... "
  local output
  if output=$("$@" 2>&1) && output+=$(csa_assert_consistent "after $1" 2>&1); then
    echo -e "${GREEN}PASS${RESET}"
    ((PASS_COUNT++))
  else
    echo -e "${RED}FAIL${RESET}"
    [[ -n "${output}" ]] && echo "${output}"
    ((FAIL_COUNT++))
  fi
}

