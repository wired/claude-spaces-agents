  SEARCH_ACTIVE=1
  SEARCH_TERM="be"
  SEARCH_FIELD_FOCUSED=1
  screen_rows 40 20 colors
  [[ "${row[1]}" =~ ${cell} ]] || { fail "no cell right after the term: $(printf '%q' "${row[1]}")"; return 1; }

