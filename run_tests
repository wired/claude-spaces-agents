# A slot is a window pinned to the size of the terminal it is made for. One that
# a failed switch left behind is swept; a parked terminal is not.
test_slot_sweep() {
  fake_add aaaaaaa1 done idle "alpha"
  fake_add aaaaaaa2 done idle "beta"
  cs_poll 1 || { fail "poll failed"; return 1; }
  show_with_terminal aaaaaaa1 bottom || { fail "setup failed"; return 1; }
  local tp slot
  tp=$(term_pane_of aaaaaaa1)
  # made while the terminal is in the main window, at the size it really has
  cs_refresh_geom
  slot=$(cs_slot_for "${tp}")
  [[ -n "${slot}" ]] || { fail "no slot was made"; return 1; }
  assert_eq "the slot is pinned to the terminal's size" "$(pane_size "${slot}")" "$(pane_size "${tp}")" || return 1
  # the switch parks the terminal in a slot of its own: the one above is left over
  cs_show_session aaaaaaa2 || { fail "switch failed"; return 1; }
  cs_slot_sweep
  if pane_is_alive "${slot}"; then
    fail "the slot survived the sweep"
    return 1
  fi
  pane_is_alive "${tp}" || { fail "the sweep killed a parked terminal"; return 1; }
}

