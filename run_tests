  cs_show_session aaaaaaa1 || { fail "cs_show_session failed"; return 1; }
  wait_for "${FAKE_CLAUDE_DIR}/attach.log" || { fail "the client never ran"; return 1; }
  assert_eq "attached" "$(cat "${FAKE_CLAUDE_DIR}/attach.log")" "aaaaaaa1" || return 1
