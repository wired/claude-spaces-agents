# ── State ─────────────────────────────────────────
cs_sanitize_path() {
  local p="${1//\//-}"
  echo "${p//_/-}"
}
PWD_SANITIZED=$(cs_sanitize_path "${PWD}")

# Refuse to operate on a malformed STATE_DIR. Used before any rm -rf.
cs_assert_state_dir_safe() {
  if [[ -z "${PWD_SANITIZED}" \
        || "${STATE_DIR}" == "${CS_STATE_ROOT}" \
        || "${STATE_DIR}" == "${CS_STATE_ROOT}/" \
        || "${PWD_SANITIZED}" == "/" \
        || "${PWD_SANITIZED}" == "." ]]; then
    echo "ERROR: refusing to operate on malformed STATE_DIR='${STATE_DIR}'" >&2
    exit 1
  fi
}

cs_init_state() {
  # Guard CS_STATE_ROOT against pre-existing symlink/wrong-owner attacks.
  [[ -L "${CS_STATE_ROOT}" ]] && { echo "ERROR: ${CS_STATE_ROOT} is a symlink — aborting" >&2; exit 1; }
  [[ -e "${CS_STATE_ROOT}" && ! -O "${CS_STATE_ROOT}" ]] && { echo "ERROR: ${CS_STATE_ROOT} not owned by current user" >&2; exit 1; }
  # SC2174: -m only applies to the deepest component. A custom state_root may
  # need intermediate dirs, whose mode is left to umask; the leaf mode is
  # enforced by the chmod below.
  # shellcheck disable=SC2174
  mkdir -m 700 -p "${CS_STATE_ROOT}" || { echo "ERROR: cannot create state root ${CS_STATE_ROOT} (check state_root in ${CONFIG_FILE})" >&2; exit 1; }
  chmod 700 "${CS_STATE_ROOT}" || { echo "ERROR: chmod 700 ${CS_STATE_ROOT} failed" >&2; exit 1; }
  [[ -L "${CS_STATE_ROOT}" || ! -O "${CS_STATE_ROOT}" ]] && { echo "ERROR: ${CS_STATE_ROOT} swapped after mkdir" >&2; exit 1; }

  PWD_SANITIZED=$(cs_sanitize_path "${PWD}")
  local sanitized="${PWD_SANITIZED}"
  STATE_DIR="${CS_STATE_ROOT}/${sanitized}"
  cs_assert_state_dir_safe
  # If picker pane from previous run is dead, wipe stale state
  cs_refresh_pane_cache
  local old_picker
  old_picker=$(cs_read_state picker_pane)
  if [[ -n "${old_picker}" ]] && ! cs_pane_alive "${old_picker}"; then
    rm -rf "${STATE_DIR}"
  fi
  mkdir -p "${STATE_DIR}"
  echo "${PWD}" > "${STATE_DIR}/project_path"
  # Stamp compat_version exactly when there is no live picker — i.e. we are the ones about to
  # build this server's topology. Keying this on "is the dir fresh" instead would never
  # stamp a dir that exists without a picker_pane (picker_pane is written by the picker
  # itself, later), and the gate would then kill every server it starts: a boot loop.
  # A LIVE picker means some other version built this server — leave it unstamped so
  # the gate can see the mismatch.
  if [[ -z "${old_picker}" ]] || ! cs_pane_alive "${old_picker}"; then
    echo "${CS_COMPAT_VERSION}" > "${STATE_DIR}/compat_version"
  fi
}

cs_read_state_into() {
  local _v=""
  { _v=$(< "${STATE_DIR}/$2"); } 2>/dev/null
  printf -v "$1" '%s' "${_v}"
}
cs_read_state() { local _rs; cs_read_state_into _rs "$1"; printf '%s' "${_rs}"; }

cs_rename_pane_window() {
  local pane="$1" name="$2"
  if ((${#name} > WINDOW_NAME_LEN)); then
    name="${name:0:${WINDOW_NAME_LEN}}"
  fi
  _tmux rename-window -t "${pane}" "${name}" 2>/dev/null || true
  _tmux set-option -t "${pane}" -w automatic-rename off 2>/dev/null || true
}

LIVE_PANES=""
PICKER_ACTIVE=""
CLIENT_PANE=""
CLIENT_TITLE=""
SESSION_ATTACHED=1
# One tmux call per scan: live panes, every pane's title, picker focus and the
# number of attached clients. Titles come from list-panes, not display-message,
# which silently answers for the active pane when its target is gone.
cs_refresh_pane_cache() {
  PICKER_ACTIVE=""
  CLIENT_TITLE=""
  if [[ -z "${PICKER_PANE:-}" ]]; then
    LIVE_PANES=$(_tmux list-panes -a -F '#{pane_id}' 2>/dev/null || true)
    return 0
  fi
  local _o _last _rest
  _o=$(_tmux list-panes -a -F '#{pane_id}' \; \
             list-panes -a -F 'T#{pane_id} #{pane_title}' \; \
             display-message -t "${PICKER_PANE}" -p 'F#{pane_active} #{session_attached}' 2>/dev/null || true)
  _last="${_o##*$'\n'}"
  if [[ "${_last}" == F* ]]; then
    _last="${_last#F}"
    PICKER_ACTIVE="${_last%% *}"
    [[ "${_last##* }" =~ ^[0-9]+$ ]] && SESSION_ATTACHED="${_last##* }"
    _o="${_o%$'\n'*}"
  fi
  if [[ -n "${CLIENT_PANE}" ]]; then
    _rest="${_o#*$'\n'"T${CLIENT_PANE} "}"
    [[ "${_rest}" != "${_o}" ]] && CLIENT_TITLE="${_rest%%$'\n'*}"
  fi
  LIVE_PANES="${_o%%$'\n'T%*}"
}
cs_pane_alive() {
  [[ $'\n'"${LIVE_PANES}"$'\n' == *$'\n'"$1"$'\n'* ]]
}

# ── Entry Helpers ─────────────────────────────────
# Parallel arrays, one row each: ID is the job id, SID the session UUID, MTIME the
# last activity (epoch), STATUS the state from Claude, PATH the session's cwd.
cs_entry_append() {
  if [[ -n "${CS_TESTING:-}" ]] && (($# != 7)); then
    echo "FATAL: cs_entry_append called with $# args, expected 7" >&2; exit 1
  fi
  ENTRIES_ID+=("$1"); ENTRIES_NAME+=("$2"); ENTRIES_MTIME+=("$3")
  ENTRIES_STATUS+=("$4"); ENTRIES_SID+=("$5"); ENTRIES_TYPE+=("$6"); ENTRIES_PATH+=("$7")
}

cs_entry_prepend() {
  if [[ -n "${CS_TESTING:-}" ]] && (($# != 7)); then
    echo "FATAL: cs_entry_prepend called with $# args, expected 7" >&2; exit 1
  fi
  ENTRIES_ID=("$1" "${ENTRIES_ID[@]}"); ENTRIES_NAME=("$2" "${ENTRIES_NAME[@]}")
  ENTRIES_MTIME=("$3" "${ENTRIES_MTIME[@]}"); ENTRIES_STATUS=("$4" "${ENTRIES_STATUS[@]}")
  ENTRIES_SID=("$5" "${ENTRIES_SID[@]}"); ENTRIES_TYPE=("$6" "${ENTRIES_TYPE[@]}")
  ENTRIES_PATH=("$7" "${ENTRIES_PATH[@]}")
}

cs_entry_clear() {
  ENTRIES_ID=(); ENTRIES_NAME=(); ENTRIES_MTIME=(); ENTRIES_STATUS=()
  ENTRIES_SID=(); ENTRIES_TYPE=(); ENTRIES_PATH=()
}

