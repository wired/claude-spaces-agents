#!/usr/bin/env bash
# ══════════════════════════════════════════════════
# claude-spaces-agents tests
#
#   run_tests               lint, then every test
#   run_tests <test_name>   that one test only, no lint
#
# Same approach as claude-spaces' run_tests: an isolated tmux server and the
# script's functions evaluated up to its entrypoint. Claude is a fake `claude` on
# PATH, so no real session is ever started. The launcher tests run the real
# script in a terminal: a pane of a second, outer tmux server.
#
# After every test an invariant check looks at the panes, windows and state
# files that are left (csa_assert_consistent).
# ══════════════════════════════════════════════════

# Re-exec under bash 4.4+ on macOS if needed
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  for _bash in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [[ -x "$_bash" ]] && exec "$_bash" "$0" "$@"
  done
  echo "ERROR: bash 4.4+ required (found ${BASH_VERSION})."
  exit 1
fi

SCRIPT_UNDER_TEST="${SCRIPT_UNDER_TEST:-$(dirname "$(readlink -f "$0")")/claude-spaces-agents}"
SCRIPT_UNDER_TEST=$(readlink -f "${SCRIPT_UNDER_TEST}")
ONLY="${1:-}"

RED='\033[31m'
GREEN='\033[32m'
RESET='\033[0m'

PASS_COUNT=0
FAIL_COUNT=0

# ── Lint ─────────────────────────────────────────
phase_shellcheck() {
  echo "Running shellcheck..."
  if ! shellcheck -S warning "${SCRIPT_UNDER_TEST}"; then
    echo -e "${RED}shellcheck failed${RESET}"
    exit 1
  fi
  echo -e "${GREEN}shellcheck passed${RESET}"
  echo ""
}

phase_arg_checks() {
  echo "Running arg checks..."
  local errors=0
  for func_sig in "cs_entry_append:7" "cs_entry_prepend:7"; do
    local func="${func_sig%%:*}"
    local expected="${func_sig##*:}"
    while IFS=: read -r linenum content; do
      local count
      count=$(echo "${content}" | grep -o '"' | wc -l)
      count=$((count / 2))
      if ((count != expected)); then
        echo -e "  ${RED}Line ${linenum}: ${func} has ${count} args (expected ${expected})${RESET}"
        ((errors++))
      fi
    done < <(grep -n "${func} " "${SCRIPT_UNDER_TEST}" | grep -v '^\s*#' | grep -v "${func}()" | grep -v "${func}() {" | grep -v "echo.*${func}")
  done
  if ((errors > 0)); then
    echo -e "${RED}arg checks failed${RESET}"
    exit 1
  fi
  echo -e "${GREEN}arg checks passed${RESET}"
  echo ""
}

# ── Source functions ──────────────────────────────
load_functions() {
  eval "$(sed -n '1,/^# ── Entrypoint/p' "${SCRIPT_UNDER_TEST}" | sed '$d')"
}

# ── Fake claude ──────────────────────────────────
# State lives in $FAKE_CLAUDE_DIR:
#   list.json      what `agents --json` prints
#   fail           present: `agents --json` fails
#   pending.json   a dispatched session, listed after `delay` more polls
#   quiet          present: `--bg` prints no id
#   untrusted      present: `--bg` refuses, as in a directory never opened before
#   slow_agents    present: agent view takes two seconds to set its title
#   attach.log     one line per `attach <id>` / `agents`
#   attach.pid     pid of the last fake client
#   cmd.log        one line per --bg / stop / rm
#   winch.<id>     one line per SIGWINCH a fake client received
write_fake_claude() {
  cat > "$1" << 'FAKE'
#!/usr/bin/env bash
D="${FAKE_CLAUDE_DIR:?}"
list="${D}/list.json"
case "${1:-}" in
  --version)
    echo "2.1.325 (Claude Code)"
    ;;
  agents)
    if [[ "${2:-}" == "--json" ]]; then
      if [[ -f "${D}/fail" ]]; then
        echo "simulated failure" >&2
        exit 1
      fi
      if [[ -f "${D}/pending.json" ]]; then
        left=$(cat "${D}/delay" 2>/dev/null || echo 0)
        if ((left <= 0)); then
          jq -s '.[0] + .[1]' "${list}" "${D}/pending.json" > "${list}.tmp" && mv "${list}.tmp" "${list}"
          rm -f "${D}/pending.json"
        else
          echo $((left - 1)) > "${D}/delay"
        fi
      fi
      cat "${list}"
    else
      echo "agents" >> "${D}/attach.log"
      echo $$ > "${D}/attach.pid"
      [[ -f "${D}/slow_agents" ]] && sleep 2
      printf '\033]2;%s\033\\' "claude agents"
      while :; do
        sleep 0.2
      done
    fi
    ;;
  attach)
    # Like the real one: sets no title.
    echo "${2:-}" >> "${D}/attach.log"
    echo $$ > "${D}/attach.pid"
    trap 'echo WINCH >> "${D}/winch.${2:-}"' WINCH
    while :; do
      sleep 0.2
    done
    ;;
  --bg)
    echo "bg $*" >> "${D}/cmd.log"
    if [[ -f "${D}/untrusted" ]]; then
      echo "Workspace not trusted: open this directory in Claude Code once." >&2
      exit 1
    fi
    n=$(cat "${D}/counter" 2>/dev/null || echo 0)
    n=$((n + 1))
    echo "${n}" > "${D}/counter"
    id=$(printf 'f%07x' "${n}")
    jq -n --arg id "${id}" --arg cwd "${PWD}" \
      '[{id: $id, kind: "background", cwd: $cwd, state: "blocked", status: "idle",
         sessionId: ($id + "-0000-4000-8000-000000000000"), name: $id,
         startedAt: 1700000000000, pid: 4242}]' > "${D}/pending.json"
    if [[ -f "${D}/quiet" ]]; then
      echo "backgrounded"
    else
      echo "backgrounded · ${id} (idle — send a prompt to start)"
    fi
    ;;
  stop)
    echo "stop ${2:-}" >> "${D}/cmd.log"
    jq --arg id "${2:-}" 'map(if .id == $id then del(.pid, .status) else . end)' "${list}" > "${list}.tmp" && mv "${list}.tmp" "${list}"
    echo "stopped ${2:-}"
    ;;
  rm)
    echo "rm ${2:-}" >> "${D}/cmd.log"
    jq --arg id "${2:-}" 'map(select(.id != $id))' "${list}" > "${list}.tmp" && mv "${list}.tmp" "${list}"
    echo "removed ${2:-}"
    ;;
esac
FAKE
  chmod +x "$1"
}

# Stand-in for the user's shell in a terminal pane. Records the directory it
# started in and every SIGWINCH it receives, under the pane's number.
write_fake_shell() {
  cat > "$1" << 'FAKE'
#!/usr/bin/env bash
D="${FAKE_CLAUDE_DIR:?}"
n="${TMUX_PANE#%}"
pwd > "${D}/termcwd.${n}"
trap 'echo WINCH >> "${D}/termwinch.${n}"' WINCH
while :; do
  sleep 0.2
done
FAKE
  chmod +x "$1"
}

# ── Fixtures ─────────────────────────────────────
# fake_add <id> <state> <status> <name> [cwd] [kind]
fake_add() {
  local id="$1" state="$2" status="$3" name="$4" cwd="${5:-${PWD}}" kind="${6:-background}"
  local list="${FAKE_CLAUDE_DIR}/list.json"
  jq --arg id "${id}" --arg state "${state}" --arg status "${status}" --arg name "${name}" \
     --arg cwd "${cwd}" --arg kind "${kind}" \
    '. + [({id: $id, kind: $kind, cwd: $cwd, state: $state,
            sessionId: ($id + "-0000-4000-8000-000000000000"), name: $name,
            startedAt: 1700000000000}
           + (if $status == "" then {} else {status: $status, pid: 4242} end))]' \
    "${list}" > "${list}.tmp" && mv "${list}.tmp" "${list}"
}

# fake_set <id> <state> <status>
fake_set() {
  local list="${FAKE_CLAUDE_DIR}/list.json"
  jq --arg id "$1" --arg state "$2" --arg status "$3" \
    'map(if .id == $id then .state = $state | .status = $status else . end)' \
    "${list}" > "${list}.tmp" && mv "${list}.tmp" "${list}"
}

# fake_drop <id> — as if it had been removed somewhere else
fake_drop() {
  local list="${FAKE_CLAUDE_DIR}/list.json"
  jq --arg id "$1" 'map(select(.id != $id))' "${list}" > "${list}.tmp" && mv "${list}.tmp" "${list}"
}

iso_at() {
  date -u -d "@$1" '+%Y-%m-%dT%H:%M:%S.123Z'
}

transcript_of() {
  echo "${PROJECTS_DIR}/proj/$1-0000-4000-8000-000000000000.jsonl"
}

# fake_transcript <id> <epoch the last turn ended>
fake_transcript() {
  local f
  f=$(transcript_of "$1")
  {
    echo '{"type":"mode","sessionId":"x"}'
    echo "{\"type\":\"user\",\"timestamp\":\"$(iso_at $(($2 - 5)))\"}"
    echo "{\"type\":\"assistant\",\"timestamp\":\"$(iso_at $(($2 - 1)))\"}"
    echo "{\"type\":\"system\",\"subtype\":\"turn_duration\",\"timestamp\":\"$(iso_at "$2")\"}"
  } > "${f}"
}

# What Claude appends when a process stops, restarts or is attached after a
# while: records with no timestamp, and an away_summary that has one.
fake_housekeeping() {
  local f
  f=$(transcript_of "$1")
  {
    echo '{"type":"cost-state"}'
    echo '{"type":"last-prompt"}'
    echo "{\"type\":\"system\",\"subtype\":\"away_summary\",\"timestamp\":\"$(iso_at "$(date +%s)")\"}"
    echo '{"type":"ai-title"}'
  } >> "${f}"
}

# seen_at <id> <epoch>
seen_at() {
  touch -d "@$2" "${SEEN_DIR}/$1"
}

# ── Test helpers ─────────────────────────────────
fail() {
  echo -e "    ${RED}FAIL${RESET} $*"
  return 1
}

# assert_eq <label> <actual> <expected>
assert_eq() {
  if [[ "$2" != "$3" ]]; then
    fail "$1: got '$2', expected '$3'"
    return 1
  fi
}

client_title() {
  _tmux display-message -p -t "${CLIENT_PANE}" '#{pane_title}'
}

set_client_title() {
  _tmux select-pane -t "${CLIENT_PANE}" -T "$1"
}

pane_pid() {
  _tmux display-message -p -t "$1" '#{pane_pid}'
}

pane_size() {
  _tmux display-message -p -t "$1" '#{pane_width}x#{pane_height}'
}

pane_window() {
  _tmux display-message -p -t "$1" '#{window_id}'
}

# True when pane $1 sits in the picker's window.
in_main() {
  [[ "$(pane_window "$1")" == "$(pane_window "${PICKER_PANE}")" ]]
}

pane_is_alive() {
  cs_refresh_pane_cache
  cs_pane_alive "$1"
}

term_pane_of() {
  cat "${STATE_DIR}/term/$1" 2>/dev/null
}

# How many SIGWINCH the terminal in pane $1 has received.
term_winch() {
  local f="${FAKE_CLAUDE_DIR}/termwinch.${1#%}"
  if [[ -f "${f}" ]]; then
    wc -l < "${f}" | tr -d ' '
  else
    echo 0
  fi
}

# How many SIGWINCH the fake clients attached to session $1 have received.
client_winch() {
  local f="${FAKE_CLAUDE_DIR}/winch.$1"
  if [[ -f "${f}" ]]; then
    wc -l < "${f}" | tr -d ' '
  else
    echo 0
  fi
}

# Long enough for a stand-in sleeping 0.2 s at a time to run its trap.
settle() {
  sleep 0.6
}

# One scan's worth of looking at the client pane.
look() {
  cs_refresh_pane_cache
  cs_follow
}

# wait_for <file> — until it exists and is not empty, two seconds at most
wait_for() {
  local i
  for ((i = 0; i < 40; i++)); do
    [[ -s "$1" ]] && return 0
    sleep 0.05
  done
  return 1
}

# Draw the picker at $1 columns by $2 rows on a real tmux pane and print what
# that screen then shows, one line per row. With "colors" as $3 the colour
# sequences are kept. tput is told the size through the environment, and bash is
# kept from putting the real terminal's size back there.
screen_of_render() {
  local cols="$1" rows="$2" pane tty out
  pane=$(_tmux new-window -d -P -F '#{pane_id}' "sleep 99999")
  _tmux resize-window -t "${pane}" -x "${cols}" -y "${rows}"
  tty=$(_tmux display-message -p -t "${pane}" '#{pane_tty}')
  out=$(shopt -u checkwinsize; export COLUMNS="${cols}" LINES="${rows}"; cs_picker_render)
  printf '%s' "${out}" > "${tty}"
  sleep 0.2
  if [[ "${3:-}" == "colors" ]]; then
    _tmux capture-pane -e -p -t "${pane}"
  else
    _tmux capture-pane -p -t "${pane}"
  fi
  _tmux kill-pane -t "${pane}"
}

# The same, into the array `row`, numbered like the screen: row[1] is the top.
screen_rows() {
  mapfile -t row < <(screen_of_render "$@")
  row=("" "${row[@]}")
}

# $1 as cs_print_centered puts it on a line 40 columns wide.
centered40() {
  printf '%*s%s' "$(( (40 - ${#1}) / 2 ))" "" "$1"
}

# Show session $1 and open its terminal in orientation $2, then let it settle.
show_with_terminal() {
  cs_show_session "$1" || return 1
  cs_term_smart "${2:-bottom}"
  local tp
  tp=$(term_pane_of "$1")
  [[ -n "${tp}" ]] || return 1
  wait_for "${FAKE_CLAUDE_DIR}/termcwd.${tp#%}"
}

# ── State invariant checker ──────────────────────
# What must hold whenever the picker is idle, whatever the test did.
csa_assert_consistent() {
  local label="$1" errors=0
  local pp cp displayed
  pp=$(cat "${STATE_DIR}/picker_pane" 2>/dev/null)
  cp=$(cat "${STATE_DIR}/client_pane" 2>/dev/null)
  displayed=$(cat "${STATE_DIR}/displayed" 2>/dev/null)

  local -A win tagged
  local p w t
  while read -r p w t; do
    [[ -n "${p}" ]] || continue
    win["${p}"]="${w}"
    tagged["${p}"]="${t}"
  done < <(_tmux list-panes -a -F '#{pane_id} #{window_id} #{?@csa_placeholder,1,0}' 2>/dev/null)

  # 1. the picker pane is alive and was never respawned
  if [[ -z "${pp}" || -z "${win[${pp}]:-}" ]]; then
    echo -e "    ${RED}FAIL${RESET} [${label}] picker pane '${pp}' is gone"
    return 1
  fi
  if [[ "$(pane_pid "${pp}")" != "${PICKER_PID0}" ]]; then
    echo -e "    ${RED}FAIL${RESET} [${label}] the picker pane was respawned"
    ((errors++))
  fi

  # 2. exactly one client pane, alive, beside the picker
  if [[ -z "${cp}" || -z "${win[${cp}]:-}" ]]; then
    echo -e "    ${RED}FAIL${RESET} [${label}] client pane '${cp}' is gone"
    ((errors++))
  elif [[ "${win[${cp}]}" != "${win[${pp}]}" || "${cp}" == "${pp}" ]]; then
    echo -e "    ${RED}FAIL${RESET} [${label}] client pane '${cp}' is not beside the picker"
    ((errors++))
  fi

  # 3. no placeholder is left anywhere
  for p in "${!tagged[@]}"; do
    if [[ "${tagged[${p}]}" == "1" ]]; then
      echo -e "    ${RED}FAIL${RESET} [${label}] placeholder pane ${p} left behind"
      ((errors++))
    fi
  done

  # 4. terminals: every one tracked is alive; at most one is in the main window,
  #    and it belongs to the displayed session
  local -A tracked
  local f id tp in_main_count=0
  for f in "${STATE_DIR}"/term/*; do
    [[ -f "${f}" ]] || continue
    id="${f##*/}"
    if [[ "${id}" == *.shown ]]; then
      if [[ ! -f "${f%.shown}" ]]; then
        echo -e "    ${RED}FAIL${RESET} [${label}] term/${id} exists but the terminal does not"
        ((errors++))
      fi
      continue
    fi
    [[ "${id}" == *.* ]] && continue
    tp=$(cat "${f}" 2>/dev/null)
    if [[ -z "${tp}" || -z "${win[${tp}]:-}" ]]; then
      echo -e "    ${RED}FAIL${RESET} [${label}] term/${id} references dead pane '${tp}'"
      ((errors++))
      continue
    fi
    tracked["${tp}"]="${id}"
    if [[ "${win[${tp}]}" == "${win[${pp}]}" ]]; then
      ((in_main_count++))
      if [[ "${id}" != "${displayed}" ]]; then
        echo -e "    ${RED}FAIL${RESET} [${label}] terminal of '${id}' is in the main window but '${displayed}' is displayed"
        ((errors++))
      fi
      if [[ ! -f "${f}.shown" ]]; then
        echo -e "    ${RED}FAIL${RESET} [${label}] terminal of '${id}' is in the main window but is marked hidden"
        ((errors++))
      fi
    fi
  done
  if ((in_main_count > 1)); then
    echo -e "    ${RED}FAIL${RESET} [${label}] ${in_main_count} terminals in the main window"
    ((errors++))
  fi

  # 5. the displayed session's terminal, when marked shown, is in the main window
  if [[ -n "${displayed}" && -f "${STATE_DIR}/term/${displayed}.shown" ]]; then
    tp=$(cat "${STATE_DIR}/term/${displayed}" 2>/dev/null)
    if [[ -n "${tp}" && -n "${win[${tp}]:-}" && "${win[${tp}]}" != "${win[${pp}]}" ]]; then
      echo -e "    ${RED}FAIL${RESET} [${label}] terminal of the displayed session is parked"
      ((errors++))
    fi
  fi

  # 6. the main window holds the picker, the client, and that one terminal at most
  local main_panes=0
  for p in "${!win[@]}"; do
    [[ "${win[${p}]}" == "${win[${pp}]}" ]] && ((main_panes++))
  done
  if ((main_panes != 2 + in_main_count)); then
    echo -e "    ${RED}FAIL${RESET} [${label}] main window has ${main_panes} panes (expected $((2 + in_main_count)))"
    ((errors++))
  fi

  # 7. every other pane is a tracked, parked terminal alone in its window
  local -A per_window
  for p in "${!win[@]}"; do
    per_window["${win[${p}]}"]=$(( ${per_window["${win[${p}]}"]:-0} + 1 ))
  done
  for p in "${!win[@]}"; do
    [[ "${win[${p}]}" == "${win[${pp}]}" ]] && continue
    if [[ -z "${tracked[${p}]:-}" ]]; then
      echo -e "    ${RED}FAIL${RESET} [${label}] untracked pane ${p} in window ${win[${p}]}"
      ((errors++))
    elif ((per_window["${win[${p}]}"] != 1)); then
      echo -e "    ${RED}FAIL${RESET} [${label}] parked terminal ${p} shares its window"
      ((errors++))
    fi
  done

  return "${errors}"
}

# ── Launcher harness ─────────────────────────────
# The real script, launched in a terminal: a pane of an outer tmux server, with
# a scratch HOME. Projects are ${TEST_TMP}/e2e/a and /b.
e2e_project() {
  echo "${TEST_TMP}/e2e/$1"
}

e2e_inner() {
  cs_server_name "$(e2e_project "$1")"
}

e2e_state() {
  echo "${TEST_TMP}/e2e/run/claude-spaces-agents/$(cs_sanitize_path "$(e2e_project "$1")")"
}

e2e_cleanup() {
  local sockdir p
  sockdir="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"
  tmux -L "${E2E_OUTER}" kill-server 2>/dev/null
  rm -f "${sockdir}/${E2E_OUTER}"
  for p in a b; do
    tmux -L "$(e2e_inner "${p}")" kill-server 2>/dev/null
    rm -f "${sockdir}/$(e2e_inner "${p}")"
  done
  rm -rf "${TEST_TMP}/e2e"
}

# e2e_launch <project> — start the launcher there, in the outer server's pane
e2e_launch() {
  mkdir -p "${TEST_TMP}/e2e/home" "${TEST_TMP}/e2e/run" "$(e2e_project a)" "$(e2e_project b)"
  # A user's tmux.conf can turn title recording off; following depends on it.
  echo 'set -gw allow-set-title off' > "${TEST_TMP}/e2e/home/.tmux.conf"
  local cmd
  cmd="cd $(e2e_project "$1") && ${SCRIPT_UNDER_TEST}; echo \"launcher exit=\$?\"; exec sleep 99999"
  if tmux -L "${E2E_OUTER}" has-session 2>/dev/null; then
    tmux -L "${E2E_OUTER}" respawn-pane -k -t o "${cmd}"
  else
    env -i HOME="${TEST_TMP}/e2e/home" USER="$(id -un)" LANG="${LANG:-C.UTF-8}" TERM=xterm-256color \
      SHELL=/bin/bash PATH="${PATH}" XDG_RUNTIME_DIR="${TEST_TMP}/e2e/run" \
      FAKE_CLAUDE_DIR="${FAKE_CLAUDE_DIR}" \
      tmux -L "${E2E_OUTER}" -f /dev/null new-session -d -s o -x 150 -y 40 "${cmd}"
  fi
}

e2e_outer_text() {
  tmux -L "${E2E_OUTER}" capture-pane -p -t o 2>/dev/null
}

# e2e_wait_outer <text> — until the outer pane shows it, ten seconds at most
e2e_wait_outer() {
  local i
  for ((i = 0; i < 100; i++)); do
    e2e_outer_text | grep -q -- "$1" && return 0
    sleep 0.1
  done
  return 1
}

# e2e_wait_up <project> — until that project's picker has built its window
e2e_wait_up() {
  local i st
  st=$(e2e_state "$1")
  for ((i = 0; i < 100; i++)); do
    if [[ -s "${st}/picker_pane" && -s "${st}/client_pane" ]] \
       && tmux -L "$(e2e_inner "$1")" has-session 2>/dev/null; then
      sleep 0.3
      return 0
    fi
    sleep 0.1
  done
  return 1
}

# e2e_keys <project> <key>... — type into that project's picker
e2e_keys() {
  local proj="$1" k
  shift
  for k in "$@"; do
    tmux -L "$(e2e_inner "${proj}")" send-keys -t "$(cat "$(e2e_state "${proj}")/picker_pane")" "${k}"
    sleep 0.3
  done
}

e2e_picker_text() {
  tmux -L "$(e2e_inner "$1")" capture-pane -p -t "$(cat "$(e2e_state "$1")/picker_pane")" 2>/dev/null
}

# ── Setup / teardown ─────────────────────────────
cs_test_setup() {
  TEST_TMP=$(mktemp -d)
  TEST_SESSION="csa-test-$$"
  TMUX_SERVER="csa-test-$$"
  E2E_OUTER="csa-test-outer-$$"
  export TERM="${TERM:-xterm}"

  mkdir -p "${TEST_TMP}/state/term" "${TEST_TMP}/state-root" "${TEST_TMP}/claude/projects/proj"
  mkdir -p "${TEST_TMP}/config" "${TEST_TMP}/data/seen" "${TEST_TMP}/fake" "${TEST_TMP}/bin"
  mkdir -p "${TEST_TMP}/project"

  CLAUDE_DIR="${TEST_TMP}/claude"
  PROJECTS_DIR="${CLAUDE_DIR}/projects"
  CS_CONFIG_DIR="${TEST_TMP}/config"
  CS_DATA_DIR="${TEST_TMP}/data"
  CONFIG_FILE="${CS_CONFIG_DIR}/config"
  PROJECT_NAMES_FILE="${CS_DATA_DIR}/project_names"
  SEEN_DIR="${CS_DATA_DIR}/seen"
  STATE_DIR="${TEST_TMP}/state"
  CS_STATE_ROOT="${TEST_TMP}/state-root"
  : > "${CONFIG_FILE}"
  : > "${PROJECT_NAMES_FILE}"

  PWD="${TEST_TMP}/project"
  PWD_SANITIZED=$(cs_sanitize_path "${PWD}")

  # The fake has to be what the panes run too, so it goes on PATH before the
  # tmux server starts and inherits the environment.
  export FAKE_CLAUDE_DIR="${TEST_TMP}/fake"
  echo '[]' > "${FAKE_CLAUDE_DIR}/list.json"
  write_fake_claude "${TEST_TMP}/bin/claude"
  write_fake_shell "${TEST_TMP}/bin/termshell"
  export PATH="${TEST_TMP}/bin:${PATH}"

  POLL_INTERVAL=0
  CS_NEW_WAIT_STEP=0.05

  _tmux new-session -d -s "${TEST_SESSION}" -x 120 -y 40 "sleep 99999"
  sleep 0.05
  # Terminals run $SHELL. Point it at the stand-in only now: tmux takes its own
  # default shell from the environment the server started in.
  SHELL="${TEST_TMP}/bin/termshell"
  PICKER_PANE=$(_tmux list-panes -t "${TEST_SESSION}" -F '#{pane_id}' | head -1)
  PICKER_PID0=$(pane_pid "${PICKER_PANE}")
  echo "${PICKER_PANE}" > "${STATE_DIR}/picker_pane"

  SELECTED=0
  SCROLL=0
  DIRTY=0
  NOW=$(date +%s)

