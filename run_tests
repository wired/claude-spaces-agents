  [[ -z "${v}" && ${rc} -eq 0 ]] || { fail "cs_read_state missing: '${v}' rc=${rc}"; return 1; }
  rm -f "${STATE_DIR}/rsi_multi"
}

# The welcome and client scripts are written with the project's name and path in
# them. Neither may be run as code.
test_scripts_injection_safe() {
  local marker="${TEST_TMP}/SCRIPT_PWNED"
  local saved_pwd="${PWD}" saved_san="${PWD_SANITIZED}"
  # a project name that closes the echo string and runs a command
  PROJECT_NAMES[${PWD_SANITIZED}]='x"; touch '"'${marker}.name'"'; echo "'
  # and a project directory whose name does the same to `cd`
  local evil="${TEST_TMP}/evil \$(touch ${marker}.path); \`touch ${marker}.tick\`"
  mkdir -p "${evil}"
  PWD="${evil}"
  cs_client_write_scripts
  PWD="${saved_pwd}"
  PWD_SANITIZED="${saved_san}"
  fake_add aaaaaaa1 done idle "alpha"
  cs_poll 1
  cs_show_welcome
  sleep 0.3
  cs_show_session aaaaaaa1
  sleep 0.4
  unset "PROJECT_NAMES[${PWD_SANITIZED}]"
  local leaked=""
  [[ -e "${marker}.name" ]] && leaked+="name "
  [[ -e "${marker}.path" ]] && leaked+="path "
  [[ -e "${marker}.tick" ]] && leaked+="backtick "
  # put the real scripts back for the tests that follow
  cs_client_write_scripts
  cs_show_welcome
  rm -rf "${evil}" "${marker}".*
  assert_eq "ran as code" "${leaked}" ""
}

test_config_injection_safe() {
  local marker="${TEST_TMP}/PWNED_CONFIG"
  # bash arithmetic evaluates recursively: a[$(cmd)] runs cmd when the value is
  # later used in $((...))
  local key
  for key in recent_threshold poll_interval min_claude_width min_claude_height show_index; do
    echo "${key}=a[\$(>${marker}.${key})]" >> "${CONFIG_FILE}"
  done
  echo "terminal_height=a[\$(>${marker}.th)]" >> "${CONFIG_FILE}"
  echo "picker_width=a[\$(>${marker}.pw)]" >> "${CONFIG_FILE}"
  cs_load_config 2>/dev/null
  : $((RECENT_THRESHOLD + POLL_INTERVAL + MIN_CLAUDE_WIDTH + MIN_CLAUDE_HEIGHT + SHOW_INDEX))
  [[ "${TERMINAL_HEIGHT}" == *% ]] || : $((TERMINAL_HEIGHT + 0))
  local fired
  fired=$(find "${TEST_TMP}" -maxdepth 1 -name 'PWNED_CONFIG.*' | wc -l | tr -d ' ')
  rm -f "${marker}".*
  assert_eq "config values run as code" "${fired}" "0"
}

