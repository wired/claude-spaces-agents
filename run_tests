test_term_hide_and_show() {
  fake_add aaaaaaa1 done idle "alpha"
  cs_poll 1 || { fail "poll failed"; return 1; }
  show_with_terminal aaaaaaa1 bottom || { fail "setup failed"; return 1; }
  local tp size t0
  tp=$(term_pane_of aaaaaaa1)
  size=$(pane_size "${tp}")
  settle
  t0=$(term_winch "${tp}")
  cs_term_toggle
  settle
  [[ ! -f "${STATE_DIR}/term/aaaaaaa1.shown" ]] || { fail "still marked shown after hiding"; return 1; }
  pane_is_alive "${tp}" || { fail "hiding killed the terminal"; return 1; }
  if in_main "${tp}"; then
    fail "still in the main window after hiding"
    return 1
  fi
  assert_eq "size while hidden" "$(pane_size "${tp}")" "${size}" || return 1
  assert_eq "SIGWINCH on hiding" "$(term_winch "${tp}")" "${t0}" || return 1
  assert_eq "window name" "$(_tmux display-message -p -t "${tp}" '#{window_name}')" "csa:term" || return 1

  cs_term_toggle
  settle
  assert_eq "the same pane" "$(term_pane_of aaaaaaa1)" "${tp}" || return 1
  in_main "${tp}" || { fail "not back in the main window"; return 1; }
  assert_eq "size after showing" "$(pane_size "${tp}")" "${size}" || return 1
  assert_eq "SIGWINCH on showing" "$(term_winch "${tp}")" "${t0}" || return 1

  # hidden stays hidden across a switch
  fake_add aaaaaaa2 done idle "beta"
  cs_poll 1
  cs_term_toggle
  cs_show_session aaaaaaa2 || { fail "switch away failed"; return 1; }
  cs_show_session aaaaaaa1 || { fail "switch back failed"; return 1; }
  if in_main "${tp}"; then
    fail "a hidden terminal came back on a switch"
    return 1
  fi
}

