  assert_eq "displayed file" "$(cat "${STATE_DIR}/displayed")" "aaaaaaa1" || return 1
  assert_eq "client title" "$(client_title)" "${CS_T_SWITCHING}" || return 1
  cs_show_session aaaaaaa2 || { fail "second switch failed"; return 1; }
  settle
  assert_eq "attached, in order" "$(tr '\n' ' ' < "${FAKE_CLAUDE_DIR}/attach.log")" "aaaaaaa1 aaaaaaa2 " || return 1
  assert_eq "SIGWINCH to the session shown" "$(client_winch aaaaaaa2)" "0"
