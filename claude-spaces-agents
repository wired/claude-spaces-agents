# ── Preflight ─────────────────────────────────────
cs_preflight() {
  local ok=1
  command -v tmux &>/dev/null || { echo "ERROR: tmux not found. Please install using your package manager."; ok=0; }
  command -v jq &>/dev/null || { echo "ERROR: jq not found. Please install using your package manager."; ok=0; }
  command -v claude &>/dev/null || { echo "ERROR: claude not found. Install from https://docs.anthropic.com/en/docs/claude-code"; ok=0; }
  ((ok)) || exit 1
}

# Every claude call goes through here. It gets no stdin, so nothing can turn
# interactive inside the picker: with a terminal, `claude --bg` shows a trust dialog.
cs_claude() {
  claude "$@" < /dev/null
}

# True when dotted version $1 is at least $2.
cs_version_ge() {
  local -a a b
  IFS=. read -ra a <<< "$1"
  IFS=. read -ra b <<< "$2"
  local i x y
  for i in 0 1 2; do
    x="${a[i]:-0}"
    y="${b[i]:-0}"
    [[ "${x}" =~ ^[0-9]+$ && "${y}" =~ ^[0-9]+$ ]] || return 1
    ((x > y)) && return 0
    ((x < y)) && return 1
  done
  return 0
}

# Run before a server is created: a Claude that cannot list background sessions
# would leave the picker with nothing but an error.
cs_preflight_claude() {
  local ver out
  ver=$(cs_claude --version 2>/dev/null) || ver=""
  ver="${ver%% *}"
  if ! cs_version_ge "${ver}" "${CS_MIN_CLAUDE}"; then
    echo "ERROR: claude-spaces-agents needs Claude Code ${CS_MIN_CLAUDE} or newer (found '${ver:-unknown}')."
    return 1
  fi
  if ! out=$(cs_claude agents --json 2>&1 >/dev/null); then
    echo "ERROR: 'claude agents --json' failed:"
    echo "  ${out%%$'\n'*}"
    return 1
  fi
}

# ── Portability ───────────────────────────────────
