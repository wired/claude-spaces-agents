test_sort_memo() {
  local lines=("3 1 beta" "1 0 alpha" "2 1 alpha" "0 1 -n flag" "4 0 back\\slash" "5 1   spaced  out" "6 1 ünïcode" "8 1 _under" "9 1 a-b")
  local in="" l out expect
  for l in "${lines[@]}"; do in+="${in:+$'\n'}${l}"; done

  expect=$(printf '%s\n' "${lines[@]}" | sort -t' ' -k2,2 -k3)
  cs_sort_memo out t "${in}" -t' ' -k2,2 -k3
  [[ "${out}" == "${expect}" ]] || { fail "miss: output differs from sort"; return 1; }

  # served from the memo (tampered to prove sort didn't run)
  SORT_MEMO_OUT[t]="from-memo"
  cs_sort_memo out t "${in}" -t' ' -k2,2 -k3
  assert_eq "hit" "${out}" "from-memo" || return 1

  expect=$(printf '%s\n' "${lines[@]}" "7 0 aaa" | sort -t' ' -k2,2 -k3)
  cs_sort_memo out t "${in}"$'\n'"7 0 aaa" -t' ' -k2,2 -k3
  [[ "${out}" == "${expect}" ]] || { fail "changed input: not recomputed"; return 1; }

  local nums=("100 0" "300 1" "300 2" "50 3" "300 10")
  in=""
  for l in "${nums[@]}"; do in+="${in:+$'\n'}${l}"; done
  expect=$(printf '%s\n' "${nums[@]}" | sort -rnk1)
  cs_sort_memo out n "${in}" -rnk1
  [[ "${out}" == "${expect}" ]] || { fail "numeric: output differs from sort"; return 1; }
}

# One tmux call gives the live panes, the picker's focus, the number of attached
# clients and the client pane's title.
test_pane_cache() {
  local plain direct
  plain=$(_tmux list-panes -a -F '#{pane_id}')
  direct=$(_tmux display-message -t "${PICKER_PANE}" -p '#{pane_active}')
  set_client_title "some title: with spaces"

  cs_refresh_pane_cache
  assert_eq "live panes" "${LIVE_PANES}" "${plain}" || return 1
  assert_eq "picker focus" "${PICKER_ACTIVE}" "${direct}" || return 1
  assert_eq "client title" "${CLIENT_TITLE}" "some title: with spaces" || return 1
  assert_eq "attached clients" "${SESSION_ATTACHED}" "0" || return 1

  local saved="${PICKER_PANE}"
  PICKER_PANE=""
  cs_refresh_pane_cache
  PICKER_PANE="${saved}"
  assert_eq "live panes, no picker yet" "${LIVE_PANES}" "${plain}" || return 1
  assert_eq "picker focus, no picker yet" "${PICKER_ACTIVE}" "" || return 1

  PICKER_PANE="%999999"
  cs_refresh_pane_cache
  PICKER_PANE="${saved}"
  assert_eq "live panes, dead picker" "${LIVE_PANES}" "${plain}" || return 1
  assert_eq "picker focus, dead picker" "${PICKER_ACTIVE}" "" || return 1

  # a dead client pane has no title: tmux must not answer for another pane
  local saved_client="${CLIENT_PANE}"
  CLIENT_PANE="%999999"
  cs_refresh_pane_cache
  CLIENT_PANE="${saved_client}"
  assert_eq "title of a dead client pane" "${CLIENT_TITLE}" ""
}

