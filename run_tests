# The focus hooks carry the state dir's path. It must reach the shell as data.
test_hook_injection_safe() {
  local marker="${TEST_TMP}/PWNED_HOOK"
  local orig_state="${STATE_DIR}"
  STATE_DIR="${TEST_TMP}/state-\$(touch ${marker})"
  mkdir -p "${STATE_DIR}"
  cs_install_focus_hook
  local hooks
  hooks=$(_tmux show-hooks -g 2>/dev/null)
  cs_remove_focus_hook
  rm -rf "${STATE_DIR}"
  STATE_DIR="${orig_state}"
  if [[ "${hooks}" == *"touch ${marker}"* ]]; then
    fail "the hook string contains the raw payload"
    return 1
  fi
  [[ ! -e "${marker}" ]] || { fail "the payload ran while the hook was installed"; return 1; }
}

