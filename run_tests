# seen/ is swept: a file whose session has been gone for five successful polls is
# removed. A failed poll proves nothing and does not count.
test_seen_sweep() {
  fake_add aaaaaaa1 done idle "alive"
  seen_at aaaaaaa1 "$(date +%s)"
  seen_at dddddddd "$(date +%s)"
  local i
  for i in 1 2 3 4; do
    cs_poll 1 || { fail "poll ${i} failed"; return 1; }
  done
  [[ -e "${SEEN_DIR}/dddddddd" ]] || { fail "swept after only four polls"; return 1; }
  touch "${FAKE_CLAUDE_DIR}/fail"
  cs_poll 1
  cs_poll 1
  rm -f "${FAKE_CLAUDE_DIR}/fail"
  [[ -e "${SEEN_DIR}/dddddddd" ]] || { fail "swept on failed polls"; return 1; }
  cs_poll 1 || { fail "fifth poll failed"; return 1; }
  [[ ! -e "${SEEN_DIR}/dddddddd" ]] || { fail "not swept after five polls"; return 1; }
  [[ -e "${SEEN_DIR}/aaaaaaa1" ]] || { fail "a live session's file was swept"; return 1; }
}

