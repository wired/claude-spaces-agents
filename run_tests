# Geometry never changes while a client is attached. In the one tmux call that
# makes a switch, a placeholder takes the old client's place before any terminal
# moves, and the new client is started last. A resize in the first moments of a
# client's life cannot be seen from outside, so the order itself is checked.
test_switch_chain_order() {
  fake_add aaaaaaa1 done idle "alpha"
  fake_add aaaaaaa2 done idle "beta"
  fake_add aaaaaaa3 done idle "gamma"
  fake_add aaaaaaa4 done idle "delta"
  cs_poll 1 || { fail "poll failed"; return 1; }
  show_with_terminal aaaaaaa1 bottom || { fail "setup A failed"; return 1; }
  show_with_terminal aaaaaaa2 side || { fail "setup B failed"; return 1; }
  cs_show_session aaaaaaa1 || { fail "back to A failed"; return 1; }
  show_with_terminal aaaaaaa3 bottom || { fail "setup C failed"; return 1; }

  # record every tmux call that starts a client
  eval "$(declare -f _tmux | sed '1s/^_tmux/_tmux_real/')"
  _tmux() {
    if [[ "$*" == *"client.sh attach"* ]]; then
      {
        printf '%s\n' "$@"
        echo "--call--"
      } >> "${TEST_TMP}/chains"
    fi
    _tmux_real "$@"
  }
  # C to B: bottom to side, the client pane changes shape
  cs_show_session aaaaaaa2
  # B to A, A to C: C and A are both bottom, at the same size
  cs_show_session aaaaaaa1
  cs_show_session aaaaaaa3
  # C to D: D has no terminal
  cs_show_session aaaaaaa4
  eval "$(declare -f _tmux_real | sed '1s/^_tmux_real/_tmux/')"

  # one line per call: the tmux commands in it, in order
  local -a calls=()
  local word verbs="" start=1 last=""
  while IFS= read -r word; do
    if [[ "${word}" == "--call--" ]]; then
      calls+=("${verbs}| ${last}")
      verbs=""
      start=1
      continue
    fi
    if ((start)); then
      verbs+="${word} "
      start=0
    fi
    [[ "${word}" == ";" ]] && start=1
    last="${word}"
  done < "${TEST_TMP}/chains"
  rm -f "${TEST_TMP}/chains"

  assert_eq "tmux calls for four switches" "${#calls[@]}" "4" || return 1
  assert_eq "different layouts" "${calls[0]}" \
    "select-pane respawn-pane swap-pane kill-pane join-pane resize-pane respawn-pane | ${STATE_DIR}/client.sh attach aaaaaaa2" || return 1
  assert_eq "different layouts, back" "${calls[1]}" \
    "select-pane respawn-pane swap-pane kill-pane join-pane resize-pane respawn-pane | ${STATE_DIR}/client.sh attach aaaaaaa1" || return 1
  assert_eq "the same layout" "${calls[2]}" \
    "select-pane swap-pane respawn-pane | ${STATE_DIR}/client.sh attach aaaaaaa3" || return 1
  assert_eq "to a session with no terminal" "${calls[3]}" \
    "select-pane respawn-pane swap-pane kill-pane resize-pane respawn-pane | ${STATE_DIR}/client.sh attach aaaaaaa4"
}

