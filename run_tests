# ── Tests: what the picker draws ─────────────────

# A note (a command's own line, or a failing poll) has rows of its own between
# the key hints and the version: centered, in the bell colour, on two rows when
# it is longer than the pane, with an empty row above and below. The version
# stays, below it.
test_footer_note() {
  fake_add aaaaaaa1 done idle "alpha"
  fake_add aaaaaaa2 done idle "beta"
  cs_poll 1 || { fail "poll failed"; return 1; }
  cs_rescan
  local -a row
  local hints version note
  hints=$(centered40 "Q:detach  ?:help")
  version=$(centered40 "spaces-agents v${VERSION}")

  # 40 columns by 20 rows: 1 header, 2-3 sessions, 4 empty, 5-6 key hints
  screen_rows 40 20
  assert_eq "key hints" "${row[6]}" "${hints}" || return 1
  assert_eq "no note: the row under the key hints" "${row[7]}" "" || return 1
  assert_eq "no note: the version" "${row[8]}" "${version}" || return 1

  FOOTER_MSG="stopped aaaaaaa1"
  note=$(centered40 "${FOOTER_MSG}")
  screen_rows 40 20
  assert_eq "key hints, with a note" "${row[6]}" "${hints}" || return 1
  assert_eq "the row above the note" "${row[7]}" "" || return 1
  assert_eq "the note" "${row[8]}" "${note}" || return 1
  assert_eq "the row below the note" "${row[9]}" "" || return 1
  assert_eq "the version, with a note" "${row[10]}" "${version}" || return 1
  assert_eq "the row below the version" "${row[11]}" "" || return 1
  screen_rows 40 20 colors
  [[ "${row[8]}" == *$'\e[31m'*"stopped aaaaaaa1"* ]] || { fail "the note is not in the bell colour: $(printf '%q' "${row[8]}")"; return 1; }

  # Longer than the pane: two rows, split at the last space that fits, each
  # centered. The version goes one row lower.
  local long="kept aaaaaaa1: the session still has work that is not saved"
  local long1 long2
  long1=$(centered40 "kept aaaaaaa1: the session still has")
  long2=$(centered40 "work that is not saved")
  FOOTER_MSG="${long}"
  screen_rows 40 20
  assert_eq "a long note: key hints" "${row[6]}" "${hints}" || return 1
  assert_eq "a long note: the row above" "${row[7]}" "" || return 1
  assert_eq "a long note: the first row" "${row[8]}" "${long1}" || return 1
  assert_eq "a long note: the second row" "${row[9]}" "${long2}" || return 1
  assert_eq "a long note: the row below" "${row[10]}" "" || return 1
  assert_eq "a long note: the version" "${row[11]}" "${version}" || return 1
  assert_eq "a long note: the row below the version" "${row[12]}" "" || return 1

  # a space right after the last column: the first row is full
  FOOTER_MSG="0123456789 123456789 123456789 123456789 tail"
  screen_rows 40 20
  assert_eq "a full first row" "${row[8]}" "0123456789 123456789 123456789 123456789" || return 1
  assert_eq "the row after a full first row" "${row[9]}" "$(centered40 "tail")" || return 1

  # no space to split at: split at the last column
  FOOTER_MSG="0123456789012345678901234567890123456789ABCDEFGHIJKLMNOPQRST"
  screen_rows 40 20
  assert_eq "no space: the first row" "${row[8]}" "0123456789012345678901234567890123456789" || return 1
  assert_eq "no space: the second row" "${row[9]}" "$(centered40 "ABCDEFGHIJKLMNOPQRST")" || return 1
  assert_eq "no space: the row below" "${row[10]}" "" || return 1

  # too long for two rows: the second is cut, there is no third
  FOOTER_MSG="0123456789012345678901234567890123456789abcdefghijklmnopqrstuvwxyzabcdefghijklmnCUT"
  screen_rows 40 20
  assert_eq "too long: the second row" "${row[9]}" "abcdefghijklmnopqrstuvwxyzabcdefghijklmn" || return 1
  assert_eq "too long: the row below" "${row[10]}" "" || return 1

  # a failing poll is the note, before any command's line
  FOOTER_MSG="stopped aaaaaaa1"
  POLL_ERROR="simulated failure"
  screen_rows 40 20
  assert_eq "a failing poll" "${row[8]}" "$(centered40 "simulated failure")" || return 1
  POLL_ERROR=""

  # A list that fills the pane: 16 sessions, where 15 rows fit. While a note is
  # shown the list gives up two rows, so the note still has its three.
  local i
  for i in 03 04 05 06 07 08 09 0a 0b 0c 0d 0e 0f 10; do
    fake_add "aaaaaa${i}" done idle "session ${i}"
  done
  cs_poll 1 || { fail "second poll failed"; return 1; }
  cs_rescan
  SELECTED=0
  SCROLL=0
  screen_rows 40 20
  assert_eq "full list: key hints" "${row[17]}" "${hints}" || return 1
  assert_eq "full list: the row above the note" "${row[18]}" "" || return 1
  assert_eq "full list: the note" "${row[19]}" "${note}" || return 1
  assert_eq "full list: the row below the note" "${row[20]}" "" || return 1
  # a note on two rows takes one more row from the list
  FOOTER_MSG="${long}"
  screen_rows 40 20
  assert_eq "full list, two rows: key hints" "${row[16]}" "${hints}" || return 1
  assert_eq "full list, two rows: the row above" "${row[17]}" "" || return 1
  assert_eq "full list, two rows: the first row" "${row[18]}" "${long1}" || return 1
  assert_eq "full list, two rows: the second row" "${row[19]}" "${long2}" || return 1
  assert_eq "full list, two rows: the row below" "${row[20]}" "" || return 1
