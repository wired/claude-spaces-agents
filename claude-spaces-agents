# ── Search / Filter ──────────────────────────────
SEARCH_ACTIVE=0
SEARCH_TERM=""
SEARCH_FIELD_FOCUSED=0
FULL_ENTRIES_ID=(); FULL_ENTRIES_NAME=(); FULL_ENTRIES_MTIME=()
FULL_ENTRIES_STATUS=(); FULL_ENTRIES_SID=(); FULL_ENTRIES_TYPE=(); FULL_ENTRIES_PATH=()

cs_search_save_full() {
  FULL_ENTRIES_ID=("${ENTRIES_ID[@]}")
  FULL_ENTRIES_NAME=("${ENTRIES_NAME[@]}")
  FULL_ENTRIES_MTIME=("${ENTRIES_MTIME[@]}")
  FULL_ENTRIES_STATUS=("${ENTRIES_STATUS[@]}")
  FULL_ENTRIES_SID=("${ENTRIES_SID[@]}")
  FULL_ENTRIES_TYPE=("${ENTRIES_TYPE[@]}")
  FULL_ENTRIES_PATH=("${ENTRIES_PATH[@]}")
}

cs_search_apply_filter() {
  # Capture selected ID for preservation (only when in results, not search field)
  local selected_id=""
  if ((!SEARCH_FIELD_FOCUSED)) && ((${#ENTRIES_ID[@]} > 0)) && ((SELECTED < ${#ENTRIES_ID[@]})); then
    selected_id="${ENTRIES_ID[${SELECTED}]}"
  fi

  cs_entry_clear

  if [[ -z "${SEARCH_TERM}" ]]; then
    ENTRIES_ID=("${FULL_ENTRIES_ID[@]}")
    ENTRIES_NAME=("${FULL_ENTRIES_NAME[@]}")
    ENTRIES_MTIME=("${FULL_ENTRIES_MTIME[@]}")
    ENTRIES_STATUS=("${FULL_ENTRIES_STATUS[@]}")
    ENTRIES_SID=("${FULL_ENTRIES_SID[@]}")
    ENTRIES_TYPE=("${FULL_ENTRIES_TYPE[@]}")
    ENTRIES_PATH=("${FULL_ENTRIES_PATH[@]}")
  else
    local term="${SEARCH_TERM,,}"
    local n=${#FULL_ENTRIES_ID[@]}

    # Pass 1: mark matching entries
    local -a match=()
    local i
    for ((i = 0; i < n; i++)); do
      local type="${FULL_ENTRIES_TYPE[${i}]}"
      if [[ "${type}" == "header" || "${type}" == "spacer" ]]; then
        match+=(0)
      else
        local name="${FULL_ENTRIES_NAME[${i}],,}"
        if [[ "${name}" == *"${term}"* ]]; then
          match+=(1)
        else
          match+=(0)
        fi
      fi
    done

    # Pass 2: copy matches, include spacer/header only if section has matches
    for ((i = 0; i < n; i++)); do
      local type="${FULL_ENTRIES_TYPE[${i}]}"
      if [[ "${type}" == "spacer" || "${type}" == "header" ]]; then
        # Look ahead: any match before next spacer or end?
        local has_child=0 j
        for ((j = i + 1; j < n; j++)); do
          [[ "${FULL_ENTRIES_TYPE[${j}]}" == "spacer" ]] && break
          ((match[j])) && { has_child=1; break; }
        done
        if ((has_child)); then
          cs_entry_append "${FULL_ENTRIES_ID[${i}]}" "${FULL_ENTRIES_NAME[${i}]}" "${FULL_ENTRIES_MTIME[${i}]}" "${FULL_ENTRIES_STATUS[${i}]}" "${FULL_ENTRIES_SID[${i}]}" "${FULL_ENTRIES_TYPE[${i}]}" "${FULL_ENTRIES_PATH[${i}]}"
        fi
      elif ((match[i])); then
        cs_entry_append "${FULL_ENTRIES_ID[${i}]}" "${FULL_ENTRIES_NAME[${i}]}" "${FULL_ENTRIES_MTIME[${i}]}" "${FULL_ENTRIES_STATUS[${i}]}" "${FULL_ENTRIES_SID[${i}]}" "${FULL_ENTRIES_TYPE[${i}]}" "${FULL_ENTRIES_PATH[${i}]}"
      fi
    done
  fi

  # Restore selection
  local new_n=${#ENTRIES_ID[@]}
  if [[ -n "${selected_id}" ]]; then
    local idx
    cs_find_entry_index "${selected_id}" idx
    if [[ "${idx}" != "-1" ]]; then
      SELECTED=${idx}
      SCROLL=0
      return
    fi
  fi
  # Fallback: clamp and skip to nearest selectable
  if ((new_n == 0)); then
    SELECTED=0
  elif ((SELECTED >= new_n)); then
    SELECTED=$((new_n - 1))
  fi
  # Skip past headers/spacers
  local start=${SELECTED}
  while ((new_n > 0)) && [[ "${ENTRIES_TYPE[${SELECTED}]}" == "header" || "${ENTRIES_TYPE[${SELECTED}]}" == "spacer" ]]; do
    SELECTED=$(( (SELECTED + 1) % new_n ))
    ((SELECTED == start)) && break
  done
  SCROLL=0
}

cs_search_enter() {
  SEARCH_ACTIVE=1
  SEARCH_TERM=""
  SEARCH_FIELD_FOCUSED=1
  DIRTY=1
}

cs_search_exit() {
  # Capture selected ID before restoring full entries
  local selected_id=""
  if ((!SEARCH_FIELD_FOCUSED)) && ((${#ENTRIES_ID[@]} > 0)) && ((SELECTED < ${#ENTRIES_ID[@]})); then
    selected_id="${ENTRIES_ID[${SELECTED}]}"
  fi

  SEARCH_ACTIVE=0
  SEARCH_TERM=""
  SEARCH_FIELD_FOCUSED=0

  # Restore full entries
  ENTRIES_ID=("${FULL_ENTRIES_ID[@]}")
  ENTRIES_NAME=("${FULL_ENTRIES_NAME[@]}")
  ENTRIES_MTIME=("${FULL_ENTRIES_MTIME[@]}")
  ENTRIES_STATUS=("${FULL_ENTRIES_STATUS[@]}")
  ENTRIES_SID=("${FULL_ENTRIES_SID[@]}")
  ENTRIES_TYPE=("${FULL_ENTRIES_TYPE[@]}")
  ENTRIES_PATH=("${FULL_ENTRIES_PATH[@]}")

  # Remap SELECTED in the full list
  if [[ -n "${selected_id}" ]]; then
    local idx
    cs_find_entry_index "${selected_id}" idx
    if [[ "${idx}" != "-1" ]]; then
      SELECTED=${idx}
      DIRTY=1
      return
    fi
  fi
  # Fallback: clamp and skip
  local n=${#ENTRIES_ID[@]}
  if ((n == 0)); then
    SELECTED=0
  elif ((SELECTED >= n)); then
    SELECTED=$((n - 1))
  fi
  local start=${SELECTED}
  while ((n > 0)) && [[ "${ENTRIES_TYPE[${SELECTED}]}" == "header" || "${ENTRIES_TYPE[${SELECTED}]}" == "spacer" ]]; do
    SELECTED=$(( (SELECTED + 1) % n ))
    ((SELECTED == start)) && break
  done
  DIRTY=1
}

cs_search_handle_key() {
  local key="$1"
  case "${key}" in
    $'\e')
      local seq=""
      read -rsn2 -t 0.1 seq || true
      case "${seq}" in
        '[A') cs_search_move_up; DIRTY=1 ;;
        '[B') cs_search_move_down; DIRTY=1 ;;
        '') cs_search_exit; DIRTY=1 ;;
      esac
      ;;
    '')  # Enter
      local n=${#ENTRIES_ID[@]}
      # Count selectable entries
      local selectable=0 first_sel=-1 i
      for ((i = 0; i < n; i++)); do
        if [[ "${ENTRIES_TYPE[${i}]}" != "header" && "${ENTRIES_TYPE[${i}]}" != "spacer" ]]; then
          ((selectable++))
          ((first_sel == -1)) && first_sel=${i}
        fi
      done
      if ((selectable == 1)); then
        SEARCH_FIELD_FOCUSED=0
        SELECTED=${first_sel}
        cs_search_exit
        cs_activate_selected
        cs_focus_session
        DIRTY=1
      elif ((selectable > 1)); then
        SEARCH_FIELD_FOCUSED=0
        SELECTED=0
        # Skip to first selectable
        while [[ "${ENTRIES_TYPE[${SELECTED}]}" == "header" || "${ENTRIES_TYPE[${SELECTED}]}" == "spacer" ]] && ((SELECTED < n - 1)); do
          ((SELECTED++))
        done
        DIRTY=1
      fi
      ;;
    $'\177'|$'\b')  # Backspace
      if ((${#SEARCH_TERM} > 0)); then
        SEARCH_TERM="${SEARCH_TERM%?}"
        cs_search_apply_filter
      fi
      DIRTY=1
      ;;
    *)
      # Only append printable characters
      if [[ "${key}" == [[:print:]] ]]; then
        SEARCH_TERM+="${key}"
        cs_search_apply_filter
        DIRTY=1
      fi
      ;;
  esac
}

cs_search_move_down() {
  local n=${#ENTRIES_ID[@]}
  # Count selectable entries
  local selectable=0 i
  for ((i = 0; i < n; i++)); do
    [[ "${ENTRIES_TYPE[${i}]}" != "header" && "${ENTRIES_TYPE[${i}]}" != "spacer" ]] && ((selectable++))
  done
  ((selectable == 0)) && { SEARCH_FIELD_FOCUSED=1; return; }

  if ((SEARCH_FIELD_FOCUSED)); then
    SEARCH_FIELD_FOCUSED=0
    SELECTED=0
    while [[ "${ENTRIES_TYPE[${SELECTED}]}" == "header" || "${ENTRIES_TYPE[${SELECTED}]}" == "spacer" ]] && ((SELECTED < n - 1)); do
      ((SELECTED++))
    done
  else
    local old=${SELECTED}
    cs_move_down
    if ((SELECTED <= old)); then
      SEARCH_FIELD_FOCUSED=1
    fi
  fi
}

cs_search_move_up() {
  local n=${#ENTRIES_ID[@]}
  # Count selectable entries
  local selectable=0 i
  for ((i = 0; i < n; i++)); do
    [[ "${ENTRIES_TYPE[${i}]}" != "header" && "${ENTRIES_TYPE[${i}]}" != "spacer" ]] && ((selectable++))
  done
  ((selectable == 0)) && { SEARCH_FIELD_FOCUSED=1; return; }

  if ((SEARCH_FIELD_FOCUSED)); then
    SEARCH_FIELD_FOCUSED=0
    SELECTED=$((n - 1))
    while [[ "${ENTRIES_TYPE[${SELECTED}]}" == "header" || "${ENTRIES_TYPE[${SELECTED}]}" == "spacer" ]] && ((SELECTED > 0)); do
      ((SELECTED--))
    done
  else
    local old=${SELECTED}
    cs_move_up
    if ((SELECTED >= old)); then
      SEARCH_FIELD_FOCUSED=1
    fi
  fi
}

cs_fingerprint() {
  local _out="$1" _pf="${2:-}"
  [[ -n "${_pf}" ]] || _pf=$(_tmux display-message -t "${PICKER_PANE}" -p '#{pane_active}' 2>/dev/null || echo "1")
  local _fpv="focus:${_pf}|menu:${MENU_ACTIVE}|search:${SEARCH_ACTIVE}:${SEARCH_TERM}:${SEARCH_FIELD_FOCUSED}|"
  _fpv+="shown:${SHOWN}|msg:${FOOTER_MSG}|err:${POLL_ERROR}|"
  local i
  for ((i = 0; i < ${#ENTRIES_ID[@]}; i++)); do
    _fpv+="${ENTRIES_ID[${i}]}:${ENTRIES_STATUS[${i}]}:${ENTRIES_MTIME[${i}]}:${ENTRIES_NAME[${i}]}:"
    _fpv+="${UNSEEN_SET[${ENTRIES_ID[${i}]}]:-0}:${AG_STATUS[${ENTRIES_ID[${i}]}]:+proc}|"
  done
  printf -v "${_out}" '%s' "${_fpv}"
}

# ── Age Formatting ────────────────────────────────
cs_format_age() {
  local diff=$((NOW - $1)) _out="$2"
  if ((diff < 60)); then
    printf -v "${_out}" '%s' "<1m"
  elif ((diff < 3600)); then
    printf -v "${_out}" '%s' "$((diff / 60))m"
  elif ((diff < 86400)); then
    printf -v "${_out}" '%s' "$((diff / 3600))h"
  elif ((diff < 604800)); then
    printf -v "${_out}" '%s' "$((diff / 86400))d"
  else
    printf -v "${_out}" '%s' "$((diff / 604800))w"
  fi
}

# ── Client Pane ───────────────────────────────────
# One pane next to the picker shows whatever is being looked at: the welcome
# screen, a session (`claude attach`) or agent view (`claude agents`). It lives as
# long as the server. Claude's supervisor owns the sessions; killing the client
# never stops one.

# Write the two scripts the client pane runs. The project path is baked in, so
# only the fixed words `attach`/`agents` and a validated id ever reach a command line.
cs_client_write_scripts() {
  local welcome="${STATE_DIR}/welcome.sh" client="${STATE_DIR}/client.sh"
  {
    echo '#!/usr/bin/env bash'
    echo "printf '\\033]2;%s\\033\\\\' '${CS_T_WELCOME}'"
    echo 'clear'
    echo 'echo ""'
    echo 'echo "  claude-spaces-agents"'
    echo 'echo "  ────────────────────"'
    local _wname="${PROJECT_NAMES[${PWD_SANITIZED}]:-${DISPLAY_NAMES[${PWD}]:-${PWD##*/}}}"
    printf 'echo %q\n' "  Project: ${_wname} (${PWD})"
    echo 'echo ""'
    echo 'echo "  Select a session in the picker, or press :c for a new one."'
    echo 'echo "  :v opens agent view; /resume there brings back older conversations."'
    echo 'echo ""'
    cs_help_text | while IFS= read -r line; do
      line="${line//\\/\\\\}"
      line="${line//\"/\\\"}"
      line="${line//\`/\\\`}"
      line="${line//\$/\\\$}"
      line="${line//>/\\>}"
      echo "echo \"${line}\""
    done
    echo "${CS_SLEEP_CMD}"
  } > "${welcome}"
  {
    echo '#!/usr/bin/env bash'
    echo '# $1 = attach | agents, $2 = job id'
    echo 'export CLAUDE_CODE_DISABLE_AGENT_VIEW=0'
    # From the project root: /resume in agent view lists the repository it was opened from.
    printf 'if cd %q; then\n' "${PWD}"
    echo '  if [[ "$1" == "agents" ]]; then'
    echo '    claude agents'
    echo '  else'
    echo '    claude attach "$2"'
    echo '  fi'
    echo '  rc=$?'
    echo 'else'
    echo '  rc=1'
    echo 'fi'
    # tmux keeps the title after claude exits; without this the picker would go on
    # believing the session is shown.
    echo "printf '\\033]2;%s\\033\\\\' '${CS_T_WELCOME}'"
    echo 'if ((rc)); then'
    echo '  # a client that failed leaves its message on screen'
    echo "  ${CS_SLEEP_CMD}"
    echo 'fi'
    printf 'exec %q\n' "${welcome}"
  } > "${client}"
  chmod +x "${welcome}" "${client}"
}

cs_set_displayed() {
  DISPLAYED="$1"
  echo "${DISPLAYED}" > "${STATE_DIR}/displayed"
}

# Create the client pane beside the picker if it is missing or dead.
cs_client_ensure() {
  cs_read_state_into CLIENT_PANE client_pane
  cs_refresh_pane_cache
  if [[ -n "${CLIENT_PANE}" ]] && cs_pane_alive "${CLIENT_PANE}"; then
    return 0
  fi
  CLIENT_PANE=""
  # split-window -t "" splits the ACTIVE pane.
  [[ -n "${PICKER_PANE:-}" ]] || return 1
  local side_flag=""
  [[ "${PICKER_SIDE}" == "right" ]] && side_flag="-b"
  local pane
  pane=$(_tmux split-window -h ${side_flag} -d -t "${PICKER_PANE}" \
          -P -F '#{pane_id}' "${STATE_DIR}/welcome.sh" 2>/dev/null) || return 1
  [[ -n "${pane}" ]] || return 1
  CLIENT_PANE="${pane}"
  echo "${CLIENT_PANE}" > "${STATE_DIR}/client_pane"
  _tmux select-pane -t "${CLIENT_PANE}" -T "${CS_T_WELCOME}" \; \
        resize-pane -t "${PICKER_PANE}" -x "${PICKER_WIDTH}" 2>/dev/null || true
  cs_set_displayed ""
  SHOWN=""
}

# The only way the client pane is ever respawned. The marker title is set in the
# same tmux call: tmux keeps a title across respawn-pane, and a stale one would
# make cs_follow adopt the session that was just left.
cs_client_respawn() {
  local marker="$1" cmd="$2"
  # respawn-pane -t "" and select-pane -t "" both act on the ACTIVE pane, which
  # can be the picker.
  [[ -n "${CLIENT_PANE:-}" && -n "${marker}" && -n "${cmd}" ]] || return 1
  [[ "${CLIENT_PANE}" != "${PICKER_PANE:-}" ]] || return 1
  _tmux select-pane -t "${CLIENT_PANE}" -T "${marker}" \; \
        respawn-pane -k -t "${CLIENT_PANE}" "${cmd}" 2>/dev/null
}

cs_show_welcome() {
  cs_set_displayed ""
  SHOWN=""
  cs_client_respawn "${CS_T_WELCOME}" "${STATE_DIR}/welcome.sh" || cs_client_ensure
  # Only now, with no client attached, does the terminal leave the window.
  cs_term_park_shown
}

# Show session $1 in the client pane. `claude attach` sets no title, so the
# switching marker stays and shown is set here, not read back from tmux.
cs_show_session() {
  local id="$1"
  [[ "${id}" =~ ${ID_RE} ]] || return 1
  [[ "${id}" == "${SHOWN}" ]] && return 0
  [[ -n "${SHOWN}" ]] && cs_mark_seen "${SHOWN}"
  local cmd="${STATE_DIR}/client.sh attach ${id}"
  if ! cs_switch_chain "${id}" "${cmd}"; then
    # tmux stopped part-way: a placeholder may be all that is left in the client
    # pane. Back to the welcome screen, with nothing displayed and no slot left.
    cs_show_welcome
    cs_slot_sweep
    return 1
  fi
  cs_set_displayed "${id}"
  SHOWN="${id}"
  cs_cleanup_new_session "${id}"
  return 0
}

# Agent view is not an exit: displayed stays, and only shown goes empty.
cs_open_agents() {
  [[ -n "${SHOWN}" ]] && cs_mark_seen "${SHOWN}"
  if cs_client_respawn "${CS_T_AGENTS}" "${STATE_DIR}/client.sh agents"; then
    SHOWN=""
    _tmux select-pane -t "${CLIENT_PANE}" 2>/dev/null || true
  else
    cs_client_ensure
    return 1
  fi
}

# Focus the client pane
cs_focus_session() {
  if [[ -n "${CLIENT_PANE}" ]] && cs_pane_alive "${CLIENT_PANE}"; then
    _tmux select-pane -t "${CLIENT_PANE}"
  fi
}

# What the client shows when the picker starts, which includes a reload. After a
# switch the title is still the switching marker, so only `displayed` remembers it.
cs_shown_at_startup() {
  if [[ "${CLIENT_TITLE}" == "${CS_T_SWITCHING}" ]]; then
    SHOWN="${DISPLAYED}"
  else
    SHOWN=""
  fi
}

# Read what the client pane shows from its title. The left arrow takes the client
# to agent view, where any session can be opened without the picker knowing.
cs_follow() {
  local title="${CLIENT_TITLE}"
  [[ -n "${title}" ]] || return 0
  local prev="${SHOWN}"
  case "${title}" in
    "${CS_T_SWITCHING}")
      # a switch made here: shown was set by it
      return 0
      ;;
    "${CS_T_WELCOME}")
      # the welcome screen, or a client that exited
      SHOWN=""
      if [[ -n "${DISPLAYED}" ]]; then
        cs_set_displayed ""
        cs_term_park_shown
        _tmux select-pane -t "${PICKER_PANE}" 2>/dev/null || true
      fi
      ;;
    "${CS_T_AGENTS}"|"claude agents"|*" · claude agents")
      SHOWN=""
      ;;
    *)
      # A session opened from agent view carries its name as title. One that is
      # attached in the middle of a tool call sets its own title right after: the
      # name behind a status glyph. Anything else, or a name two sessions share,
      # means nothing: leave shown as it is.
      case "${title}" in
        "✳ "*|"◐ "*|"◑ "*) title="${title#* }" ;;
      esac
      local id found="" count=0
      for id in "${AG_IDS[@]}"; do
        if [[ "${AG_NAME[${id}]}" == "${title}" ]]; then
          found="${id}"
          count=$((count + 1))
        fi
      done
      if ((count == 1)); then
        SHOWN="${found}"
        if [[ "${AG_CWD[${found}]%%/.claude/worktrees/*}" == "${PWD}" && "${found}" != "${DISPLAYED}" ]]; then
          # Adopt it, and bring its terminal. The attach already happened, so the
          # session is resized once; there is no way around that here.
          cs_term_park_shown
          cs_set_displayed "${found}"
          if cs_term_is_shown "${found}"; then
            local _fo
            cs_term_orient _fo "${found}"
            cs_term_show "${found}" "${_fo}" || true
          fi
        fi
      fi
      ;;
  esac
  if [[ "${prev}" != "${SHOWN}" ]]; then
    # once more as it stops being shown, so a turn that ended in the last second
    # the user was looking is not flagged
    [[ -n "${prev}" ]] && cs_mark_seen "${prev}"
    DIRTY=1
  fi
}

# One scan: read tmux, follow the client, refresh the list when due, rebuild rows.
cs_tick() {
  cs_refresh_pane_cache
  if [[ -z "${CLIENT_PANE}" ]] || ! cs_pane_alive "${CLIENT_PANE}"; then
    cs_client_ensure
    cs_refresh_pane_cache
  fi
  cs_term_reconcile
  cs_follow
  if [[ -n "${SHOWN}" ]] && ((WINDOW_FOCUSED)); then
    cs_mark_seen "${SHOWN}"
  fi
  cs_poll_tick
  # The displayed session left the list (removed somewhere else).
  if [[ -n "${DISPLAYED}" && -z "${POLL_ERROR}" ]] && ((POLLED)) && [[ ! -v "AG_STATE[${DISPLAYED}]" ]]; then
    cs_show_welcome
    _tmux select-pane -t "${PICKER_PANE}" 2>/dev/null || true
  fi
  # A new session that got its first prompt is no longer ours to clean up.
  local nid
  cs_read_state_into nid new_session
  if [[ -n "${nid}" && -v "AG_STATE[${nid}]" ]]; then
    if [[ "${AG_STATE[${nid}]}" != "blocked" || "${AG_STATUS[${nid}]}" != "idle" ]]; then
      rm -f "${STATE_DIR}/new_session"
    fi
  fi
  cs_rescan
}

# ── Terminal Panes ────────────────────────────────
# One terminal per session, keyed by job id. Only the displayed session's terminal
# is in the main window, split off the client pane. Every other one is parked in a
# hidden window pinned to the terminal's own size. A terminal only ever moves
# between cells of its own size, so parking and switching never resize it.
#
# State, in ${STATE_DIR}/term/:
#   <id>          the terminal's pane id
#   <id>.shown    present: visible whenever its session is displayed
#   <id>.orient   bottom | side
#   <id>.height   saved share, e.g. 35% (only with a percentage setting)
#   <id>.width
#   <id>.keep     present: a fixed-size terminal that was opened without room
#   <id>.area     the client pane's size without the terminal, WxH, when the
#                 terminal was last in the main window

declare -gA PANE_W PANE_H PANE_WIN
declare -gA TERM_ABSENT
TERM_HOW=()
FULL_W=0
FULL_H=0

# Size and window of every pane, from one list-panes call. display-message -t
# answers for the active pane when its target is gone, so it is no use here.
cs_refresh_geom() {
  PANE_W=()
  PANE_H=()
  PANE_WIN=()
  local p w h win
  while read -r p w h win; do
    [[ -n "${p}" ]] || continue
    PANE_W["${p}"]="${w}"
    PANE_H["${p}"]="${h}"
    PANE_WIN["${p}"]="${win}"
  done < <(_tmux list-panes -a -F '#{pane_id} #{pane_width} #{pane_height} #{window_id}' 2>/dev/null)
}

# True when pane $1 exists and sits in the picker's window. Needs cs_refresh_geom.
cs_term_in_main() {
  [[ -n "${1:-}" && -n "${PANE_WIN[$1]:-}" && "${PANE_WIN[$1]}" == "${PANE_WIN[${PICKER_PANE}]:-none}" ]]
}

cs_term_is_shown() {
  [[ -f "${STATE_DIR}/term/$1.shown" ]]
}

# Orientation of session $2's terminal, into the variable named $1.
cs_term_orient() {
  local _to
  cs_read_state_into _to "term/$2.orient"
  [[ "${_to}" == "side" ]] || _to="bottom"
  printf -v "$1" '%s' "${_to}"
}

# The tmux flags that put a terminal beside the client pane: below it, or on the
# side away from the picker. Into TERM_HOW.
cs_term_how() {
  if [[ "$1" == "side" ]]; then
    TERM_HOW=(-h)
    [[ "${PICKER_SIDE}" == "right" ]] && TERM_HOW+=(-b)
  else
    TERM_HOW=(-v)
  fi
}

# What a new terminal runs: a shell in the session's own directory, so a session
# working in a worktree gets a shell in that worktree.
cs_term_command() {
  local dir="${AG_CWD[$1]:-}" _sh="${SHELL:-/bin/bash}"
  [[ -d "${dir}" ]] || dir="${PWD}"
  printf 'cd %s && exec %s' "${dir@Q}" "${_sh@Q}"
}

# Height of session $1's bottom terminal when the client pane is $2 rows tall
# without it.
cs_term_compute_height() {
  local id="$1" pane_h="$2"
  local h="${TERMINAL_HEIGHT}" saved
  if [[ "${h}" == *% ]]; then
    cs_read_state_into saved "term/${id}.height"
    [[ "${saved}" =~ ^[0-9]+%$ ]] && h="${saved}"
  fi
  if [[ "${h}" == *% ]]; then
    h=$(( (pane_h * ${h%\%} + 50) / 100 ))
  fi
  local max_h=$(( pane_h - MIN_CLAUDE_HEIGHT - 1 ))
  rm -f "${STATE_DIR}/term/${id}.keep"
  if (( h > max_h )); then
    h="${max_h}"
    # a fixed size opened without room: a resize squeezes it instead of hiding it
    [[ "${TERMINAL_HEIGHT}" == *% ]] || echo "1" > "${STATE_DIR}/term/${id}.keep"
  fi
  (( h < 3 )) && h=3
  echo "${h}"
}

# Width of session $1's side terminal when the client pane is $2 columns wide
# without it.
cs_term_compute_width() {
  local id="$1" pane_w="$2"
  local w="${TERMINAL_WIDTH}" saved
  if [[ "${w}" == *% ]]; then
    cs_read_state_into saved "term/${id}.width"
    [[ "${saved}" =~ ^[0-9]+%$ ]] && w="${saved}"
  fi
  if [[ "${w}" == *% ]]; then
    w=$(( (pane_w * ${w%\%} + 50) / 100 ))
  fi
  local max_w=$(( pane_w - MIN_CLAUDE_WIDTH - 1 ))
  rm -f "${STATE_DIR}/term/${id}.keep"
  if (( w > max_w )); then
    w="${max_w}"
    [[ "${TERMINAL_WIDTH}" == *% ]] || echo "1" > "${STATE_DIR}/term/${id}.keep"
  fi
  (( w < 10 )) && w=10
  echo "${w}"
}

# Size for session $1's terminal in orientation $2 when the client pane, with no
# terminal beside it, is $3 x $4. A parked terminal ($5) keeps its own size as
# long as that area is the one it was parked from, and it was parked in this
# orientation: recomputing from the saved share can land a cell off, and that
# would resize it on every switch. After the window changed, its size is stale
# and is computed again.
cs_term_place_size() {
  local id="$1" orient="$2" full_w="$3" full_h="$4" tp="${5:-}" area=""
  if [[ -n "${tp}" ]]; then
    cs_read_state_into area "term/${id}.area"
    [[ "${area}" == "${full_w}x${full_h}" ]] || tp=""
  fi
  if [[ "${orient}" == "side" ]]; then
    if [[ -n "${tp}" && "${PANE_H[${tp}]:-}" == "${full_h}" ]]; then
      echo "${PANE_W[${tp}]}"
      return 0
    fi
    cs_term_compute_width "${id}" "${full_w}"
  else
    if [[ -n "${tp}" && "${PANE_W[${tp}]:-}" == "${full_w}" ]]; then
      echo "${PANE_H[${tp}]}"
      return 0
    fi
    cs_term_compute_height "${id}" "${full_h}"
  fi
}

# The size the client pane has with no terminal beside it, into FULL_W and
# FULL_H. $1 is the terminal now in the main window ("" for none), $2 its
# orientation. Needs cs_refresh_geom.
cs_client_full_size() {
  FULL_W="${PANE_W[${CLIENT_PANE}]:-0}"
  FULL_H="${PANE_H[${CLIENT_PANE}]:-0}"
  [[ -n "${1:-}" && -n "${PANE_W[$1]:-}" ]] || return 0
  if [[ "$2" == "side" ]]; then
    FULL_W=$(( FULL_W + PANE_W[$1] + 1 ))
  else
    FULL_H=$(( FULL_H + PANE_H[$1] + 1 ))
  fi
}

# Remember the area session $1's terminal sits in, and the share of it the
# terminal takes, so a resize of the outer terminal keeps it. Only a percentage
# setting has its share saved, and never a split that has squeezed Claude to its
# minimum. Needs cs_refresh_geom.
cs_term_save_size() {
  local id="$1" tp orient
  cs_read_state_into tp "term/${id}"
  cs_term_in_main "${tp}" || return 0
  [[ -n "${PANE_W[${CLIENT_PANE}]:-}" ]] || return 0
  cs_term_orient orient "${id}"
  cs_client_full_size "${tp}" "${orient}"
  echo "${FULL_W}x${FULL_H}" > "${STATE_DIR}/term/${id}.area"
  if [[ "${orient}" == "side" ]]; then
    [[ "${TERMINAL_WIDTH}" == *% ]] || return 0
    local tw="${PANE_W[${tp}]}" sw="${PANE_W[${CLIENT_PANE}]}"
    if (( tw + sw > 0 && sw > MIN_CLAUDE_WIDTH )); then
      echo "$(( tw * 100 / (tw + sw) ))%" > "${STATE_DIR}/term/${id}.width"
    fi
  else
    [[ "${TERMINAL_HEIGHT}" == *% ]] || return 0
    local th="${PANE_H[${tp}]}" sh="${PANE_H[${CLIENT_PANE}]}"
    if (( th + sh > 0 && sh > MIN_CLAUDE_HEIGHT )); then
      echo "$(( th * 100 / (th + sh) ))%" > "${STATE_DIR}/term/${id}.height"
    fi
  fi
}

# A hidden window holding one tagged placeholder, pinned to the size of pane $1.
# Prints the placeholder's pane id.
cs_slot_for() {
  local tp="$1" slot
  [[ -n "${tp}" && -n "${PANE_W[${tp}]:-}" ]] || return 1
  slot=$(_tmux new-window -d -P -F '#{pane_id}' "${CS_SLEEP_CMD}" 2>/dev/null) || return 1
  [[ -n "${slot}" ]] || return 1
  # An untagged placeholder is invisible to cs_slot_sweep — never leave one.
  if ! _tmux set -p -t "${slot}" @csa_placeholder 1 \; \
             resize-window -t "${slot}" -x "${PANE_W[${tp}]}" -y "${PANE_H[${tp}]}" 2>/dev/null; then
    _tmux kill-pane -t "${slot}" 2>/dev/null || true
    return 1
  fi
  printf '%s\n' "${slot}"
}

cs_slot_discard() {
  # kill-pane -t "" kills the ACTIVE pane.
  [[ -n "${1:-}" ]] || return 0
  _tmux kill-pane -t "$1" 2>/dev/null || true
}

# Kill windows whose panes are all tagged placeholders: a slot left behind by a
# chain that failed. A parked terminal is never tagged, so its window is spared.
cs_slot_sweep() {
  local -A wtot wtag wrep
  local wid pid flag
  while read -r wid pid flag; do
    [[ -n "${wid}" ]] || continue
    wtot["${wid}"]=$(( ${wtot["${wid}"]:-0} + 1 ))
    if [[ "${flag}" == "1" ]]; then
      wtag["${wid}"]=$(( ${wtag["${wid}"]:-0} + 1 ))
      wrep["${wid}"]="${pid}"
    fi
  done < <(_tmux list-panes -a -F '#{window_id} #{pane_id} #{?@csa_placeholder,1,0}' 2>/dev/null)
  for wid in "${!wtot[@]}"; do
    (( wtot["${wid}"] == ${wtag["${wid}"]:-0} )) || continue
    [[ -n "${wrep["${wid}"]:-}" ]] || continue
    _tmux kill-window -t "${wrep["${wid}"]}" 2>/dev/null || true
  done
}

# Park terminal pane $1 in a hidden window pinned to its own size. It moves by
# swap-pane into a cell of exactly that size, so it is not resized. break-pane
# would put it in a full-size window, and resizing the window afterwards does not
# undo that. Needs cs_refresh_geom.
cs_term_park() {
  local tp="$1" slot
  slot=$(cs_slot_for "${tp}") || return 1
  if ! _tmux swap-pane -d -s "${tp}" -t "${slot}" \; kill-pane -t "${slot}" 2>/dev/null; then
    cs_slot_discard "${slot}"
    return 1
  fi
  cs_rename_pane_window "${tp}" "csa:term"
}

# Park whatever terminal is in the main window. Call it when no client is
# attached (the welcome screen, a client that exited), or when the resize it
# causes cannot be avoided (a session opened from agent view).
cs_term_park_shown() {
  local f id tp
  cs_refresh_geom
  for f in "${STATE_DIR}"/term/*; do
    [[ -f "${f}" ]] || continue
    id="${f##*/}"
    [[ "${id}" == *.* ]] && continue
    { tp=$(< "${f}"); } 2>/dev/null
    cs_term_in_main "${tp}" || continue
    cs_term_save_size "${id}"
    cs_term_park "${tp}" || true
  done
}

# Forget session $1's terminal: its state files, not the pane.
cs_term_forget() {
  [[ "$1" =~ ${ID_RE} ]] || return 0
  rm -f "${STATE_DIR}/term/$1"{,.shown,.height,.width,.orient,.keep,.area}
}

# Kill session $1's terminal and forget it.
cs_term_kill() {
  local id="$1" tp
  [[ "${id}" =~ ${ID_RE} ]] || return 0
  cs_read_state_into tp "term/${id}"
  # kill-pane -t "" kills the ACTIVE pane.
  if [[ -n "${tp}" ]]; then
    _tmux kill-pane -t "${tp}" 2>/dev/null || true
  fi
  cs_term_forget "${id}"
}

# Drop the state of terminals whose shell has exited: closing the shell closes
# the terminal. Needs a fresh cs_refresh_pane_cache.
cs_term_reconcile() {
  # an empty pane list is a failed tmux call, not a server with no panes
  cs_pane_alive "${PICKER_PANE:-none}" || return 0
  local f id tp
  for f in "${STATE_DIR}"/term/*; do
    [[ -f "${f}" ]] || continue
    id="${f##*/}"
    [[ "${id}" == *.* ]] && continue
    { tp=$(< "${f}"); } 2>/dev/null
    if [[ -z "${tp}" ]] || ! cs_pane_alive "${tp}"; then
      cs_term_forget "${id}"
    fi
  done
}

# Kill the terminals of sessions that are gone for good: missing from five
# successful polls in a row. A terminal can hold a running process, so one
# missing entry proves nothing, and neither does a failed poll: this is called
# only after a successful one.
cs_term_sweep() {
  local f id
  for f in "${STATE_DIR}"/term/*; do
    [[ -f "${f}" ]] || continue
    id="${f##*/}"
    [[ "${id}" == *.* ]] && continue
    if [[ -v "AG_STATE[${id}]" ]]; then
      unset "TERM_ABSENT[${id}]"
      continue
    fi
    TERM_ABSENT["${id}"]=$(( ${TERM_ABSENT[${id}]:-0} + 1 ))
    if ((TERM_ABSENT[${id}] >= 5)); then
      cs_term_kill "${id}"
      unset "TERM_ABSENT[${id}]"
    fi
  done
}

# Put session $1's terminal in the main window in orientation $2: create it,
# bring it out of its parking window, or move it to the other side. A client is
# attached while this runs, so the session is resized once; that is the user's
# own action. The terminal itself is resized only when its shape changes.
cs_term_show() {
  local id="$1" orient="$2" tp cur size
  [[ "${id}" =~ ${ID_RE} ]] || return 1
  # split-window -t "" and join-pane -t "" act on the ACTIVE pane.
  [[ -n "${CLIENT_PANE}" ]] || return 1
  cs_refresh_pane_cache
  cs_term_reconcile
  cs_refresh_geom
  cs_read_state_into tp "term/${id}"
  if cs_term_in_main "${tp}"; then
    cs_term_orient cur "${id}"
    if [[ "${cur}" == "${orient}" ]]; then
      echo "1" > "${STATE_DIR}/term/${id}.shown"
      return 0
    fi
    # the other orientation: out, then back in
    cs_term_save_size "${id}"
    cs_term_park "${tp}" || return 1
    cs_refresh_geom
  fi
  cs_client_full_size "" ""
  size=$(cs_term_place_size "${id}" "${orient}" "${FULL_W}" "${FULL_H}" "${tp}")
  cs_term_how "${orient}"
  if [[ -n "${tp}" ]]; then
    _tmux join-pane "${TERM_HOW[@]}" -d -s "${tp}" -t "${CLIENT_PANE}" -l "${size}" 2>/dev/null || return 1
  else
    tp=$(_tmux split-window "${TERM_HOW[@]}" -d -t "${CLIENT_PANE}" -l "${size}" \
          -P -F '#{pane_id}' "$(cs_term_command "${id}")" 2>/dev/null) || return 1
    [[ -n "${tp}" ]] || return 1
    echo "${tp}" > "${STATE_DIR}/term/${id}"
  fi
  echo "1" > "${STATE_DIR}/term/${id}.shown"
  echo "${orient}" > "${STATE_DIR}/term/${id}.orient"
  _tmux resize-pane -t "${PICKER_PANE}" -x "${PICKER_WIDTH}" 2>/dev/null || true
  # the share it starts with, so the WINCH handler can keep it
  cs_refresh_geom
  cs_term_save_size "${id}"
}

# Hide session $1's terminal: park it, and remember that it is hidden.
cs_term_hide() {
  local id="$1" tp
  [[ "${id}" =~ ${ID_RE} ]] || return 0
  rm -f "${STATE_DIR}/term/${id}.shown"
  cs_refresh_geom
  cs_read_state_into tp "term/${id}"
  cs_term_in_main "${tp}" || return 0
  cs_term_save_size "${id}"
  cs_term_park "${tp}"
}

# Hide a terminal a resize left no room for. Focus goes to Claude if it was there.
cs_term_autohide() {
  local id="$1" tp="$2" active
  active=$(_tmux display-message -p '#{pane_id}' 2>/dev/null || true)
  cs_term_hide "${id}"
  # the resize squeezed it before it was hidden: that size is not one to keep
  rm -f "${STATE_DIR}/term/${id}.area"
  if [[ "${active}" == "${tp}" ]]; then
    _tmux select-pane -t "${CLIENT_PANE}" 2>/dev/null || true
  fi
}

# Toggle the displayed session's terminal on and off.
cs_term_toggle() {
  local id="${DISPLAYED}" orient tp
  # nothing displayed: the welcome screen has no terminal
  [[ -n "${id}" ]] || return 0
  if cs_term_is_shown "${id}"; then
    cs_term_hide "${id}"
  else
    cs_term_orient orient "${id}"
    cs_term_show "${id}" "${orient}" || return 0
    cs_read_state_into tp "term/${id}"
    if [[ -n "${tp}" ]]; then
      _tmux select-pane -t "${tp}" 2>/dev/null || true
    fi
  fi
  _tmux resize-pane -t "${PICKER_PANE}" -x "${PICKER_WIDTH}" 2>/dev/null || true
}

# Smart terminal key for the displayed session: closed or in the other
# orientation → open it there and focus it; focused → focus Claude; open but not
# focused → focus it. $1 is the orientation asked for, empty for the saved one.
cs_term_smart() {
  local orient="${1:-}" id="${DISPLAYED}" cur tp active
  [[ -n "${id}" ]] || return 0
  cs_term_orient cur "${id}"
  [[ -n "${orient}" ]] || orient="${cur}"
  if ! cs_term_is_shown "${id}" || [[ "${cur}" != "${orient}" ]]; then
    cs_term_show "${id}" "${orient}" || return 0
    cs_read_state_into tp "term/${id}"
    if [[ -n "${tp}" ]]; then
      _tmux select-pane -t "${tp}" 2>/dev/null || true
    fi
    return 0
  fi
  cs_read_state_into tp "term/${id}"
  [[ -n "${tp}" ]] || return 0
  active=$(_tmux display-message -p '#{pane_id}' 2>/dev/null || true)
  if [[ "${active}" == "${tp}" ]]; then
    _tmux select-pane -t "${CLIENT_PANE}" 2>/dev/null || true
  else
    _tmux select-pane -t "${tp}" 2>/dev/null || true
  fi
}

# Run the one tmux call that puts session $1 in the client pane with command $2.
# Which call depends on the terminals of the session being left and the one
# being shown:
#   neither has one in play     respawn the client
#   same orientation and size   the two terminals trade places, then respawn
#   anything else               the client pane's size has to change, so a
#                               placeholder holds it while the terminals move
# A switch never changes geometry while a client is attached, and never resizes
# a terminal. It must stay ONE tmux call: split up, the placeholder is visible
# and the pane's old title can be read.
cs_switch_chain() {
  local id="$1" cmd="$2"
  cs_refresh_pane_cache
  if [[ -z "${CLIENT_PANE}" ]] || ! cs_pane_alive "${CLIENT_PANE}"; then
    cs_client_ensure || return 1
    cs_refresh_pane_cache
  fi
  cs_term_reconcile
  cs_refresh_geom

  local out="${DISPLAYED}" out_tp="" out_orient="bottom" in_tp="" in_orient="bottom"
  if [[ -n "${out}" && "${out}" != "${id}" ]]; then
    cs_read_state_into out_tp "term/${out}"
    cs_term_in_main "${out_tp}" || out_tp=""
    cs_term_orient out_orient "${out}"
  fi
  if [[ "${out}" != "${id}" ]] && cs_term_is_shown "${id}"; then
    cs_read_state_into in_tp "term/${id}"
    cs_term_orient in_orient "${id}"
    # a parked terminal is the only thing to bring in
    if [[ -z "${PANE_W[${in_tp:-none}]:-}" ]] || cs_term_in_main "${in_tp}"; then
      in_tp=""
    fi
  fi

  local -a chain=(select-pane -t "${CLIENT_PANE}" -T "${CS_T_SWITCHING}" ';')
  local slot="" size
  if [[ -z "${out_tp}" && -z "${in_tp}" ]]; then
    :
  elif [[ -n "${out_tp}" && -n "${in_tp}" && "${in_orient}" == "${out_orient}" \
          && "${PANE_W[${in_tp}]}" == "${PANE_W[${out_tp}]}" \
          && "${PANE_H[${in_tp}]}" == "${PANE_H[${out_tp}]}" ]]; then
    cs_term_save_size "${out}"
    chain+=(swap-pane -d -s "${in_tp}" -t "${out_tp}" ';')
  else
    cs_client_full_size "${out_tp}" "${out_orient}"
    chain+=(respawn-pane -k -t "${CLIENT_PANE}" "${CS_SLEEP_CMD}" ';')
    if [[ -n "${out_tp}" ]]; then
      cs_term_save_size "${out}"
      slot=$(cs_slot_for "${out_tp}") || return 1
      chain+=(swap-pane -d -s "${out_tp}" -t "${slot}" ';' kill-pane -t "${slot}" ';')
    fi
    if [[ -n "${in_tp}" ]]; then
      size=$(cs_term_place_size "${id}" "${in_orient}" "${FULL_W}" "${FULL_H}" "${in_tp}")
      cs_term_how "${in_orient}"
      chain+=(join-pane "${TERM_HOW[@]}" -d -s "${in_tp}" -t "${CLIENT_PANE}" -l "${size}" ';')
    fi
    chain+=(resize-pane -t "${PICKER_PANE}" -x "${PICKER_WIDTH}" ';')
  fi
  chain+=(respawn-pane -k -t "${CLIENT_PANE}" "${cmd}")

  if ! _tmux "${chain[@]}" 2>/dev/null; then
    cs_slot_discard "${slot}"
    return 1
  fi
  if [[ -n "${out_tp}" ]]; then
    cs_rename_pane_window "${out_tp}" "csa:term"
  fi
  return 0
}

# ── Jump Numbers ──────────────────────────────────
# Ten numbers for the session rows of every project, as in claude-spaces: the
# rows that are not dim first, then the rest. The numbers run in display order.
cs_compute_jump_slots() {
  JUMP_SLOT=()
  JUMP_TARGET=()
  ((SHOW_INDEX)) || return 0
  local n=${#ENTRIES_ID[@]} i marked=0 look

  # Pass 1: mark the rows that are not dim (guaranteed a slot)
  for ((i = 0; i < n && marked < 10; i++)); do
    case "${ENTRIES_TYPE[${i}]}" in
      local|remote) ;;
      *) continue ;;
    esac
    cs_row_look look "${ENTRIES_ID[${i}]}" "${ENTRIES_STATUS[${i}]}"
    [[ "${look}" != "dormant" ]] || continue
    JUMP_SLOT[${i}]=1
    marked=$((marked + 1))
  done

  # Pass 2: fill the remaining marks with the dim rows, list order
  for ((i = 0; i < n && marked < 10; i++)); do
    [[ -v "JUMP_SLOT[${i}]" ]] && continue
    case "${ENTRIES_TYPE[${i}]}" in
      local|remote) ;;
      *) continue ;;
    esac
    JUMP_SLOT[${i}]=1
    marked=$((marked + 1))
  done

  # Pass 3: assign sequential numbers in display order
  local slot=1
  for ((i = 0; i < n && slot <= 10; i++)); do
    [[ -v "JUMP_SLOT[${i}]" ]] || continue
    JUMP_SLOT[${i}]=$((slot % 10))
    JUMP_TARGET[$((slot % 10))]=${i}
    slot=$((slot + 1))
  done
}

cs_jump_to_session() {
  local target="$1"
  cs_compute_jump_slots
  [[ -v "JUMP_TARGET[${target}]" ]] || return 0
  SELECTED=${JUMP_TARGET[${target}]}
  cs_activate_selected
  cs_focus_session
  DIRTY=1
}

# WINCH handler — re-pin picker width on terminal resize.
cs_handle_winch() {
  _tmux resize-pane -t "${PICKER_PANE}" -x "${PICKER_WIDTH}" 2>/dev/null
  DIRTY=1
  # Re-fit the displayed session's terminal: a percentage keeps its share and is
  # squeezed when Claude would drop below its minimum; a fixed size that no
  # longer fits is hidden, unless it was opened without room to begin with.
  local id="${DISPLAYED}" tp orient saved over total want max
  [[ -n "${id}" ]] || return 0
  cs_term_is_shown "${id}" || return 0
  cs_read_state_into tp "term/${id}"
  cs_refresh_geom
  cs_term_in_main "${tp}" || return 0
  [[ -n "${PANE_W[${CLIENT_PANE}]:-}" ]] || return 0
  cs_term_orient orient "${id}"
  if [[ "${orient}" == "side" ]]; then
    saved="${TERMINAL_WIDTH}"
    if [[ "${saved}" == *% ]]; then
      cs_read_state_into over "term/${id}.width"
      [[ "${over}" =~ ^[0-9]+%$ ]] && saved="${over}"
    fi
    total=$(( PANE_W[${tp}] + PANE_W[${CLIENT_PANE}] ))
    ((total > 0)) || return 0
    if [[ "${saved}" == *% ]]; then
      want=$(( (total * ${saved%\%} + 50) / 100 ))
    else
      want="${saved}"
    fi
    max=$(( total - MIN_CLAUDE_WIDTH ))
    if (( want > max )); then
      if [[ "${TERMINAL_WIDTH}" != *% && ! -f "${STATE_DIR}/term/${id}.keep" ]]; then
        cs_term_autohide "${id}" "${tp}"
        return 0
      fi
      want="${max}"
    else
      rm -f "${STATE_DIR}/term/${id}.keep"
    fi
    (( want < 10 )) && want=10
    _tmux resize-pane -t "${tp}" -x "${want}" 2>/dev/null || true
  else
    saved="${TERMINAL_HEIGHT}"
    if [[ "${saved}" == *% ]]; then
      cs_read_state_into over "term/${id}.height"
      [[ "${over}" =~ ^[0-9]+%$ ]] && saved="${over}"
    fi
    total=$(( PANE_H[${tp}] + PANE_H[${CLIENT_PANE}] ))
    ((total > 0)) || return 0
    if [[ "${saved}" == *% ]]; then
      want=$(( (total * ${saved%\%} + 50) / 100 ))
    else
      want="${saved}"
    fi
    max=$(( total - MIN_CLAUDE_HEIGHT ))
    if (( want > max )); then
      if [[ "${TERMINAL_HEIGHT}" != *% && ! -f "${STATE_DIR}/term/${id}.keep" ]]; then
        cs_term_autohide "${id}" "${tp}"
        return 0
      fi
      want="${max}"
    else
      rm -f "${STATE_DIR}/term/${id}.keep"
    fi
    (( want < 3 )) && want=3
    _tmux resize-pane -t "${tp}" -y "${want}" 2>/dev/null || true
  fi
}

# ── Actions ───────────────────────────────────────
# Remove the last session created here if it never got a prompt and is not $1.
# `claude rm` stops work without asking, so the decision is made on a fresh list
# right before the call: still waiting for its first prompt, and no transcript.
cs_cleanup_new_session() {
  local keep="${1:-}" nid
  cs_read_state_into nid new_session
  [[ -n "${nid}" ]] || return 0
  [[ "${nid}" == "${keep}" ]] && return 0
  rm -f "${STATE_DIR}/new_session"
  [[ "${nid}" =~ ${ID_RE} ]] || return 0
  cs_poll 1 || return 0
  [[ "${AG_STATE[${nid}]:-}" == "blocked" && "${AG_STATUS[${nid}]:-}" == "idle" ]] || return 0
  [[ -z "${AG_TPATH[${nid}]:-}" ]] || return 0
  cs_claude rm "${nid}" > /dev/null 2>&1 || true
  cs_poll 1 || true
}

# Start a background session in this project, wait until Claude lists it, and
# show it. It starts with no prompt: the user types the first one in the session.
cs_new_session() {
  cs_cleanup_new_session ""
  local before=" ${AG_IDS[*]} "
  local out rc=0
  out=$(cd "${PWD}" && cs_claude --bg 2>&1) || rc=$?
  local first="${out%%$'\n'*}"
  if ((rc != 0)); then
    FOOTER_MSG="${first:-claude --bg failed}"
    # `claude --bg` has no terminal here and cannot ask. Agent view can: it shows
    # Claude's trust dialog for a directory that was never opened before. The
    # dialog says what the message would, so the message is dropped.
    if [[ "${out,,}" == *"not trusted"* ]]; then
      cs_open_agents && FOOTER_MSG=""
    fi
    return 1
  fi
  # "backgrounded · <id> (...)"
  local id="" cand
  if [[ "${first}" =~ ^backgrounded[^0-9a-f]+([0-9a-f]{8})($|[^0-9a-f]) ]]; then
    id="${BASH_REMATCH[1]}"
  fi
  local deadline=$((SECONDS + 5))
  while ((SECONDS <= deadline)); do
    cs_poll 1 || true
    if [[ -z "${id}" ]]; then
      # no id in the output: the entry for this project that was not there before
      for cand in "${AG_IDS[@]}"; do
        [[ "${before}" == *" ${cand} "* ]] && continue
        [[ "${AG_CWD[${cand}]%%/.claude/worktrees/*}" == "${PWD}" ]] || continue
        id="${cand}"
        break
      done
    fi
    [[ -n "${id}" && -v "AG_STATE[${id}]" ]] && break
    sleep "${CS_NEW_WAIT_STEP:-0.2}"
  done
  if [[ -z "${id}" || ! -v "AG_STATE[${id}]" ]]; then
    FOOTER_MSG="the new session did not appear in the list"
    return 1
  fi
  echo "${id}" > "${STATE_DIR}/new_session"
  cs_rescan
  cs_show_session "${id}"
}

# A prefix key pressed from another pane means the session being looked at, not
# whatever row the cursor was left on. With nothing shown the cursor stays put.
cs_cursor_to_shown() {
  [[ -n "${SHOWN}" ]] || return 1
  local idx
  cs_find_entry_index "${SHOWN}" idx
  [[ "${idx}" != "-1" ]] || return 1
  SELECTED=${idx}
}

# Stop or remove, asked for with a prefix key. The list is drawn again before the
# question, so the row being asked about is the one highlighted.
cs_prefix_end() {
  local _pf
  _pf=$(_tmux display-message -t "${PICKER_PANE}" -p '#{pane_active}' 2>/dev/null || echo "1")
  if [[ "${_pf}" != "1" ]]; then
    cs_cursor_to_shown || true
  fi
  _tmux select-pane -t "${PICKER_PANE}" 2>/dev/null || true
  cs_picker_render
  cs_confirm_end "$@"
}

# Run `claude stop` or `claude rm` on the selected session after a confirmation.
# The command's own line goes to the footer: an idle session's row does not
# change when it is stopped, and `claude rm` can refuse.
cs_confirm_end() {
  local verb="$1" prompt="$2"
  local n=${#ENTRIES_ID[@]}
  ((n == 0)) && return 0
  [[ "${ENTRIES_TYPE[${SELECTED}]}" == "local" ]] || return 0
  local id="${ENTRIES_ID[${SELECTED}]}"
  [[ "${id}" =~ ${ID_RE} ]] || return 0
  cs_confirm "${CS_CLR_PROMPT_WARN}" "${prompt}" || return 0
  if [[ "${id}" == "${SHOWN}" || "${id}" == "${DISPLAYED}" ]]; then
    # welcome first, so the dying client's message is not left on screen
    cs_show_welcome
    _tmux select-pane -t "${PICKER_PANE}" 2>/dev/null || true
  fi
  local out
  out=$(cs_claude "${verb}" "${id}" 2>&1) || true
  FOOTER_MSG="${out%%$'\n'*}"
  if cs_poll 1; then
    # Removed for good: its terminal goes with it. A stopped session is still
    # listed and keeps its terminal.
    [[ -v "AG_STATE[${id}]" ]] || cs_term_kill "${id}"
  fi
  cs_rescan
}

# ── Rendering ─────────────────────────────────────
cs_render_header_bar() {
  local color="$1" text="$2" width="$3"
  printf '\e[1;1H%b%*s\e[0m' "${color}" "${width}" ""
  printf '\e[1;1H%b%s\e[0m' "${color}" "${text}"
}

cs_render_header() {
  local width="$1"
  local pname="${PROJECT_NAMES[${PWD_SANITIZED}]:-}"
  local title_path
  if [[ -n "${pname}" ]]; then
    title_path="${pname}"
  else
    local dname="${DISPLAY_NAMES[${PWD}]:-}"
    local leaf="${PWD##*/}"
    if [[ -n "${dname}" && "${dname}" != "${leaf}" ]]; then
      title_path="${dname}"
    else
      title_path="${PWD/#${HOME}/\~$(whoami)}"
    fi
  fi
  local max_title=$((width - 2))
  if ((${#title_path} > max_title)); then
    title_path="...${title_path: -$((max_title - 3))}"
  fi
  local title=" ${title_path} "
  local pad=$(( (width - ${#title}) / 2 ))
  ((pad < 0)) && pad=0
  printf '\e[1;1H%b%*s\e[0m' "${CS_CLR_HEADER_BG}" "${width}" ""
  printf '\e[1;%dH%b%s\e[0m' "$((pad + 1))" "${CS_CLR_HEADER_BG}" "${title}"
}

cs_print_centered() {
  local line="$1" text="$2" w="$3" color="${4-${CS_CLR_CHROME}}"
  local pad=$(( (w - ${#text}) / 2 ))
  ((pad < 0)) && pad=0
  printf '\e[%d;1H\e[K%b%*s%s\e[0m' "${line}" "${color}" "${pad}" "" "${text}"
}

# Split the text $2 for $3 columns into the array named $1: no rows when it is
# empty, one when it fits, else two. The break is the last space that keeps the
# first row within the columns, or the last column when there is none. The
# second row is cut to the columns.
cs_note_split() {
  local -n _rows="$1"
  local text="$2" width="$3"
  _rows=()
  [[ -n "${text}" ]] || return 0
  ((width > 0)) || width=1
  if ((${#text} <= width)); then
    _rows=("${text}")
    return 0
  fi
  local first="${text:0:width + 1}" rest
  if [[ "${first}" == ?*" "* ]]; then
    first="${first% *}"
    rest="${text:${#first}}"
    rest="${rest#"${rest%%[! ]*}"}"
  else
    first="${text:0:width}"
    rest="${text:width}"
  fi
  _rows=("${first}")
  [[ -n "${rest}" ]] && _rows+=("${rest:0:width}")
  return 0
}

# A note is a failing poll or the last command's own line (`stopped <id>`,
# `kept <id> …`). Draw $3 centered from the row after $1, on one row or split
# into two for the width $2, with an empty row above and below. Draws nothing
# and fails when $3 is empty.
cs_render_note() {
  local row="$1" width="$2" i
  local -a rows
  cs_note_split rows "$3" "${width}"
  ((${#rows[@]})) || return 1
  printf '\e[%d;1H\e[K\e[%d;1H\e[K' "${row}" "$((row + ${#rows[@]} + 1))"
  for ((i = 0; i < ${#rows[@]}; i++)); do
    cs_print_centered "$((row + 1 + i))" "${rows[i]}" "${width}" "${CS_CLR_BELL}"
  done
}

# How a session's row looks. Sets the variable named $1 to one of:
#   active   the session the client pane shows
#   bell     needs input, or finished and not looked at since
#   dormant  no process: stopped, failed, or idle and put to sleep by Claude
#   running  everything else
# Stopping an idle session leaves its state `done`; only its process goes away,
# so the process is what tells a closed session from an open one.
cs_row_look() {
  local _out="$1" id="$2" status="$3" _look="running"
  if [[ -n "${SHOWN}" && "${id}" == "${SHOWN}" ]]; then
    _look="active"
  elif [[ "${status}" == "blocked" ]] || [[ -v "UNSEEN_SET[${id}]" ]]; then
    _look="bell"
  elif [[ "${status}" != "working" && -z "${AG_STATUS[${id}]:-}" ]]; then
    _look="dormant"
  fi
  printf -v "${_out}" '%s' "${_look}"
}

# ── Picker TUI ────────────────────────────────────
cs_menu_render() {
  local width="$1" height="$2"

  printf '\e[?25l\e[H'
  cs_render_header_bar "${CS_CLR_HEADER_BG}" "Esc: cancel" "${width}"

  # Blank + highlighted session entry
  local row=2
  printf '\e[%d;1H\e[K' "${row}"
  ((row++))
  if ((SELECTED >= 0 && SELECTED < ${#ENTRIES_ID[@]})); then
    local name="${ENTRIES_NAME[${SELECTED}]}"
    local status="${ENTRIES_STATUS[${SELECTED}]}"
    local color='\e[0m'
    [[ "${status}" == "blocked" ]] && color="${CS_CLR_BELL_MENU}"
    printf '\e[%d;1H\e[K%b  %-*.*s\e[0m' "${row}" "${color}" "$((width - 2))" "$((width - 2))" "${name}"
  else
    printf '\e[%d;1H\e[K' "${row}"
  fi

  # Blank + menu entries
  ((row++))
  printf '\e[%d;1H\e[K' "${row}"
  local i
  for ((i = 0; i < ${#MENU_KEYS[@]}; i++)); do
    ((row++))
    if [[ -z "${MENU_KEYS[${i}]}" ]]; then
      printf '\e[%d;1H\e[K' "${row}"
    else
      printf '\e[%d;1H\e[K  %b%s\e[0m  %b%s\e[0m' "${row}" "${CS_CLR_BOLD}" "${MENU_KEYS[${i}]}" "${CS_CLR_CHROME}" "${MENU_LABELS[${i}]}"
    fi
  done

  # Clear remaining lines
  ((row++))
  printf '\e[%d;1H\e[J' "${row}"

}

cs_picker_render() {
  printf -v NOW '%(%s)T' -1
  local width height avail
  width=$(tput cols)
  height=$(tput lines)

  if ((MENU_ACTIVE)); then
    cs_menu_render "${width}" "${height}"
    return
  fi

  # The search view has no footer to show a note in.
  local note=""
  local -a note_rows
  ((SEARCH_ACTIVE)) || note="${POLL_ERROR:-${FOOTER_MSG}}"
  cs_note_split note_rows "${note}" "${width}"

  avail=$((height - 5))
  # A note takes its one or two rows under the key hints and an empty row on
  # either side, and the footer has one empty row to give. A list that fills the
  # pane gives up the rest.
  ((${#note_rows[@]})) && avail=$((avail - ${#note_rows[@]} - 1))
  ((avail < 1)) && avail=1

  local n=${#ENTRIES_ID[@]}

  # Adjust scroll
  if ((SELECTED < SCROLL)); then
    SCROLL=${SELECTED}
  elif ((SELECTED >= SCROLL + avail)); then
    SCROLL=$((SELECTED - avail + 1))
  fi

  # Hide cursor, home position (no full clear — paint over to avoid flash)
  printf '\e[?25l\e[H'

  local picker_focused
  picker_focused=$(_tmux display-message -t "${PICKER_PANE}" -p '#{pane_active}' 2>/dev/null || echo "1")

  # Header (or search bar when searching)
  if ((SEARCH_ACTIVE)); then
    local search_clr="${CS_CLR_SEARCH_BAR}"
    ((!SEARCH_FIELD_FOCUSED)) && search_clr="${CS_CLR_HEADER_BG}"
    cs_render_header_bar "${search_clr}" "/${SEARCH_TERM}" "${width}"
    local cur_col=$((2 + ${#SEARCH_TERM}))
    if ((SEARCH_FIELD_FOCUSED)) && [[ "${picker_focused}" == "1" ]] && ((cur_col <= width)); then
      printf '\e[1;%dH\e[48;5;231m \e[0m' "${cur_col}"
    fi
  else
    cs_render_header "${width}"
  fi

  if ((n == 0)); then
    local empty_msg=""
    # a failing poll must never look like an empty list
    [[ -n "${POLL_ERROR}" ]] && empty_msg="${POLL_ERROR}"
    ((SEARCH_ACTIVE)) && empty_msg="No matches."
    local -a empty_rows
    cs_note_split empty_rows "${empty_msg}" "$((width - 2))"
    printf '\e[2;1H\e[K%b  %s\e[0m' "${CS_CLR_CHROME}" "${empty_rows[0]:-}"
    # Clear remaining lines
    local cl
    for ((cl = 3; cl < height; cl++)); do
      printf '\e[%d;1H\e[K' "${cl}"
    done
    # The last command's own line. With no list there is no footer to show it
    # in, and a failing poll already has the rows above: one, or two when it is
    # split, and then the note starts a row lower.
    local empty_note_row=3
    if ((${#empty_rows[@]} > 1)); then
      printf '\e[3;1H%b  %s\e[0m' "${CS_CLR_CHROME}" "${empty_rows[1]}"
      empty_note_row=4
    fi
    cs_render_note "${empty_note_row}" "${width}" "${FOOTER_MSG}" || true
    printf '\e[%d;1H\e[K' "${height}"
    return
  fi

  # Session list
  local max_name=$((width - 4))
  ((max_name < 5)) && max_name=5

  cs_compute_jump_slots
  local i
  for ((i = SCROLL; i < SCROLL + avail && i < n; i++)); do
    local line=$((i - SCROLL + 2))
    printf '\e[%d;1H\e[K' "${line}"

    local name="${ENTRIES_NAME[${i}]}"
    local status="${ENTRIES_STATUS[${i}]}"
    local id="${ENTRIES_ID[${i}]}"
    local entry_type="${ENTRIES_TYPE[${i}]}"
    # The age is the last activity read from the transcript. A working session
    # shows a marker instead, and one with no transcript yet shows nothing.
    local age=""
    if [[ "${status}" == "working" ]]; then
      age="…"
    elif [[ -n "${AG_ACT[${id}]:-}" ]]; then
      cs_format_age "${ENTRIES_MTIME[${i}]}" age
      ((ENTRIES_MTIME[i] >= RECENT_CUTOFF)) && age="<${RECENT_THRESHOLD}m"
    fi
    # pad by characters here: printf pads by bytes, and the marker is multibyte
    local age_pad=""
    ((${#age} < 4)) && printf -v age_pad '%*s' "$((4 - ${#age}))" ""
    age="${age_pad}${age}"

    # Header/spacer entries render separately
    if [[ "${entry_type}" == "spacer" ]]; then
      continue
    fi
    if [[ "${entry_type}" == "header" ]]; then
      local hdr="─ ${name} ─"
      local hpad=$(( (width - ${#hdr}) / 2 ))
      ((hpad < 0)) && hpad=0
      printf '%*s%b%s\e[0m' "${hpad}" "" "${CS_CLR_SECTION}" "${hdr}"
      continue
    fi

    # Per-type: indent, color, show_age, prefix, index
    local indent=0 line_color="${CS_CLR_DORMANT}" show_age=1 line_prefix="" idx_prefix="" look=""
    case "${entry_type}" in
      local|remote)
        cs_row_look look "${id}" "${status}"
        case "${look}" in
          active) line_color="${CS_CLR_ACTIVE}" ;;
          bell) line_color="${CS_CLR_BELL}" ;;
          dormant) line_color="${CS_CLR_DORMANT}" ;;
          *) line_color="${CS_CLR_RUNNING}" ;;
        esac
        if [[ "${look}" == "active" && "${picker_focused}" == "0" ]]; then
          if [[ "${PICKER_SIDE}" == "left" ]]; then
            line_prefix="> "
          else
            line_prefix="< "
          fi
        fi
        if [[ "${entry_type}" == "remote" ]] && ((!SHOW_INDEX)); then
          # another project's session: indented under its project. With
          # show_index on, its number or the two blanks stand in for the indent.
          [[ -n "${line_prefix}" ]] || indent=2
        elif ((SHOW_INDEX)); then
          if [[ -v "JUMP_SLOT[${i}]" ]]; then
            if [[ -z "${line_prefix}" ]]; then
              idx_prefix="${JUMP_SLOT[${i}]} "
            fi
          elif [[ -z "${line_prefix}" ]]; then
            idx_prefix="  "
          fi
        fi
        ;;
      project)
        line_color="${CS_CLR_RUNNING}" ; show_age=0
        ;;
    esac

    # Compute available name width
    local name_width=$((max_name - indent - ${#idx_prefix} - ${#line_prefix}))
    if ((! show_age)); then
      name_width=$((name_width + 4))
    fi

    # Truncate name
    if [[ "${entry_type}" == "project" ]]; then
      name_width=$((name_width - 2))
      if ((${#name} > name_width)); then
        name="...${name: -$((name_width - 3))}"
      fi
    elif ((${#name} > name_width)); then
      name="${name:0:$((name_width - 3))}..."
    fi

    # Indent string
    local indent_str=""
    ((indent > 0)) && printf -v indent_str '%*s' "${indent}" ""

    # Selection background (skip for focused or search field focused)
    local sel_bg=""
    if ((i == SELECTED)) && ((!SEARCH_FIELD_FOCUSED)) && [[ "${picker_focused}" == "1" ]]; then
      sel_bg="${CS_CLR_SELECTION}"
      printf '%b' "${sel_bg}"
    fi

    # Render line — bold line_color when selected
    if [[ -n "${sel_bg}" ]]; then
      line_color='\e[1m'"${line_color}"
    fi
    local idx_color="${CS_CLR_CHROME}"
    [[ -n "${sel_bg}" ]] && idx_color="${line_color}"
    if ((show_age)); then
      printf '%s%b%s\e[0m%b%b%s%-*.*s%4s' "${indent_str}" "${idx_color}" "${idx_prefix}" "${sel_bg}" "${line_color}" "${line_prefix}" "${name_width}" "${name_width}" "${name}" "${age}"
    else
      printf '%s%b%s\e[0m%b%b%s%-*.*s' "${indent_str}" "${idx_color}" "${idx_prefix}" "${sel_bg}" "${line_color}" "${line_prefix}" "${name_width}" "${name_width}" "${name}"
    fi
    printf '\e[0m'
  done

  # Footer below session list
  local last_entry_line
  if ((n > SCROLL + avail)); then
    last_entry_line=$((avail + 1))
  else
    last_entry_line=$((n - SCROLL + 1))
  fi

  # Scroll indicator
  if ((n > avail)); then
    local pct=$(( (SCROLL * 100) / (n - avail) ))
    printf '\e[%d;1H\e[K%b%d%%\e[0m' "$((last_entry_line + 1))" "${CS_CLR_CHROME}" "${pct}"
  else
    printf '\e[%d;1H\e[K' "$((last_entry_line + 1))"
  fi

  if ((SEARCH_ACTIVE)); then
    # Clear from after scroll indicator to bottom (search field is in header)
    local cl
    for ((cl = last_entry_line + 2; cl <= height; cl++)); do
      printf '\e[%d;1H\e[K' "${cl}"
    done
  else
    # Centered footer (context-sensitive)
    local footer_line=$((last_entry_line + 2))
    local selected_type="${ENTRIES_TYPE[${SELECTED}]:-local}"
    if [[ "${selected_type}" == "remote" || "${selected_type}" == "project" ]]; then
      cs_print_centered "${footer_line}" "Enter:switch" "${width}"
    else
      cs_print_centered "${footer_line}" ": menu  / search" "${width}"
    fi

    # Quit row
    local quit_line=$((footer_line + 1))
    cs_print_centered "${quit_line}" "Q:detach  ?:help" "${width}"

    # One empty row, then the version. A note goes between them, with an empty
    # row of its own on either side.
    local version_line=$((quit_line + 2))
    if cs_render_note "$((quit_line + 1))" "${width}" "${note}"; then
      version_line=$((quit_line + 3 + ${#note_rows[@]}))
    else
      printf '\e[%d;1H\e[K' "$((quit_line + 1))"
    fi
    cs_print_centered "${version_line}" "spaces-agents v${VERSION}" "${width}"

    # Clear everything below
    printf '\e[%d;1H\e[J' "$((version_line + 1))"
  fi
}

# Put the cursor on the shown session after something changed what is shown.
cs_select_shown() {
  cs_rescan
  cs_sync_highlight_local
}

cs_picker_loop() {
  SELECTED=0
  SCROLL=0
  DIRTY=1
  LAST_FINGERPRINT=""
  WINDOW_FOCUSED=1

  PICKER_PANE=$(_tmux display-message -p '#{pane_id}')
  WINCH_PENDING=0
  trap 'WINCH_PENDING=1' WINCH
  cs_rename_pane_window "${PICKER_PANE}" "csa:picker"
  echo "${PICKER_PANE}" > "${STATE_DIR}/picker_pane"
  echo $$ > "${STATE_DIR}/picker_pid"

  mkdir -p "${SEEN_DIR}" "${STATE_DIR}/term"
  cs_load_project_names
  cs_compute_display_names
  _tmux rename-session "${PROJECT_NAMES[${PWD_SANITIZED}]:-${DISPLAY_NAMES[${PWD}]:-${PWD##*/}}}" 2>/dev/null || true
  # Following reads the client pane's title. The user's tmux.conf is sourced and
  # may have turned this off.
  _tmux set -gw allow-set-title on 2>/dev/null || true

  cs_install_keybindings
  cs_install_focus_hook

  stty -echo discard undef lnext undef 2>/dev/null || true
  stty dsusp undef 2>/dev/null || true
  trap 'stty echo 2>/dev/null; printf "\e[?25h\e[0m"; cs_remove_focus_hook; cs_remove_keybindings' EXIT

  cs_client_write_scripts
  cs_read_state_into DISPLAYED displayed
  cs_read_state_into CLIENT_PANE client_pane
  cs_refresh_pane_cache
  if [[ -z "${CLIENT_PANE}" ]] || ! cs_pane_alive "${CLIENT_PANE}"; then
    cs_client_ensure
    cs_refresh_pane_cache
  fi
  cs_shown_at_startup
  # Terminals whose shell exited while nobody was looking, and slots a failed
  # switch left behind
  cs_term_reconcile
  cs_slot_sweep
  cs_poll 1 || true
  cs_follow
  cs_rescan
  cs_sync_highlight_local
  cs_consume_pending_load
  # Nothing shown: give the picker the focus so the user can navigate at once
  [[ -n "${SHOWN}" ]] || _tmux select-pane -t "${PICKER_PANE}"

  cs_picker_render

  while true; do
    local key=""
    if IFS= read -rsn1 -t 1 key; then
      FOOTER_MSG=""
      if ((MENU_ACTIVE)); then
        case "${key}" in
          $'\e')
            read -rsn2 -t 0.1 _ || true
            MENU_ACTIVE=0; DIRTY=1 ;;
          p) MENU_ACTIVE=0; cs_rename_project; DIRTY=1 ;;
          x) MENU_ACTIVE=0; cs_confirm_end stop "Stop? y/N"; DIRTY=1 ;;
          D) MENU_ACTIVE=0; cs_confirm_end rm "Remove (stops work)? y/N"; DIRTY=1 ;;
          c) MENU_ACTIVE=0; cs_new_session && cs_focus_session; cs_select_shown; DIRTY=1 ;;
          v) MENU_ACTIVE=0; cs_open_agents; DIRTY=1 ;;
          d) MENU_ACTIVE=0; _tmux detach-client ;;
          s) MENU_ACTIVE=0; cs_confirm_shutdown; DIRTY=1 ;;
          *) MENU_ACTIVE=0; DIRTY=1 ;;
        esac
      elif ((SEARCH_ACTIVE)); then
        if ((SEARCH_FIELD_FOCUSED)); then
          cs_search_handle_key "${key}"
        else
          # In search results — limited keyset
          case "${key}" in
            j) cs_search_move_down; DIRTY=1 ;;
            k) cs_search_move_up; DIRTY=1 ;;
            J) cs_search_move_down
               if [[ "${ENTRIES_TYPE[${SELECTED}]}" == "local" ]]; then
                 cs_activate_selected; cs_focus_session
               fi
               DIRTY=1 ;;
            K) cs_search_move_up
               if [[ "${ENTRIES_TYPE[${SELECTED}]}" == "local" ]]; then
                 cs_activate_selected; cs_focus_session
               fi
               DIRTY=1 ;;
            $'\e')
              local seq=""
              read -rsn2 -t 0.1 seq || true
              case "${seq}" in
                '[A') cs_search_move_up; DIRTY=1 ;;
                '[B') cs_search_move_down; DIRTY=1 ;;
                '[C') cs_search_exit; _tmux select-pane -R 2>/dev/null || true; DIRTY=1 ;;
                '[D') cs_search_exit; _tmux select-pane -L 2>/dev/null || true; DIRTY=1 ;;
                '') cs_search_exit; DIRTY=1 ;;
              esac
              ;;
            '')
              cs_search_exit
              cs_activate_selected
              cs_focus_session
              DIRTY=1
              ;;
          esac
        fi
      else
        case "${key}" in
          j) cs_move_down; DIRTY=1 ;;
          k) cs_move_up; DIRTY=1 ;;
          J) local _pf; _pf=$(_tmux display-message -t "${PICKER_PANE}" -p '#{pane_active}' 2>/dev/null || echo "1")
             [[ "${_pf}" == "0" ]] && cs_sync_highlight_local
             cs_move_down 1
             cs_activate_selected; cs_focus_session
             DIRTY=1 ;;
          K) local _pf; _pf=$(_tmux display-message -t "${PICKER_PANE}" -p '#{pane_active}' 2>/dev/null || echo "1")
             [[ "${_pf}" == "0" ]] && cs_sync_highlight_local
             cs_move_up 1
             cs_activate_selected; cs_focus_session
             DIRTY=1 ;;
          H|L) cs_activate_selected; cs_focus_session; DIRTY=1 ;;
          h) _tmux select-pane -L 2>/dev/null || true; DIRTY=1 ;;
          l) _tmux select-pane -R 2>/dev/null || true; DIRTY=1 ;;
          $'\e')
            local seq=""
            read -rsn2 -t 0.1 seq || true
            case "${seq}" in
              '[A') cs_move_up; DIRTY=1 ;;
              '[B') cs_move_down; DIRTY=1 ;;
              '[C') _tmux select-pane -R 2>/dev/null || true; DIRTY=1 ;;
              '[D') _tmux select-pane -L 2>/dev/null || true; DIRTY=1 ;;
            esac
            ;;
          '')
            cs_activate_selected
            cs_focus_session
            DIRTY=1
            ;;
          ' ') cs_activate_selected; DIRTY=1 ;;
          a|i) cs_focus_session; DIRTY=1 ;;
          /) cs_search_enter; DIRTY=1 ;;
          ':') cs_menu_enter ;;
          '?') cs_show_welcome; DIRTY=1 ;;
          Q) _tmux detach-client ;;
          '~') cs_term_toggle; DIRTY=1 ;;
          '`') cs_term_smart; DIRTY=1 ;;
          $'\t') cs_term_smart side; DIRTY=1 ;;
          '_') cs_term_smart bottom; DIRTY=1 ;;
          '|') cs_focus_session; DIRTY=1 ;;
          $'\x01') _tmux select-pane -t "${PICKER_PANE}"; cs_search_enter; DIRTY=1 ;;
          $'\x19') _tmux select-pane -t "${PICKER_PANE}"; cs_rename_project; DIRTY=1 ;;
          $'\x16') _tmux select-pane -t "${PICKER_PANE}"; cs_confirm_shutdown; DIRTY=1 ;;
          $'\x02') _tmux select-pane -t "${PICKER_PANE}"; cs_new_session && cs_focus_session; cs_select_shown; DIRTY=1 ;;
          $'\x05') _tmux select-pane -t "${PICKER_PANE}"; cs_menu_enter ;;
          $'\x06') cs_prefix_end stop "Stop? y/N"; DIRTY=1 ;;
          $'\x14') cs_prefix_end rm "Remove (stops work)? y/N"; DIRTY=1 ;;
          $'\x10') cs_open_agents; DIRTY=1 ;;
          $'\x0e')
            _tmux select-pane -t "${PICKER_PANE}"
            stty echo 2>/dev/null || true
            printf '\e[?25h\e[0m'
            CS_PICKER=1 CS_STATE_DIR="${STATE_DIR}" exec "${SCRIPT_PATH}" ;;
          $'\x0f')
            local _pf
            _pf=$(_tmux display-message -p '#{pane_id}' 2>/dev/null || true)
            if [[ "${_pf}" == "${PICKER_PANE}" ]]; then
              cs_focus_session
            else
              _tmux select-pane -t "${PICKER_PANE}"
            fi
            DIRTY=1
            ;;
          [0-9]) cs_jump_to_session "${key}" ;;
          $'\x12') cs_poll 1 || true; cs_rescan; DIRTY=1 ;;
          R)
            stty echo 2>/dev/null || true
            printf '\e[?25h\e[0m'
            CS_PICKER=1 CS_STATE_DIR="${STATE_DIR}" exec "${SCRIPT_PATH}"
            ;;
        esac
      fi
    else
      # Close menu if picker lost focus
      if ((MENU_ACTIVE)); then
        local _pf
        _pf=$(_tmux display-message -t "${PICKER_PANE}" -p '#{pane_active}' 2>/dev/null || echo "1")
        if [[ "${_pf}" != "1" ]]; then
          MENU_ACTIVE=0
          DIRTY=1
        fi
      fi
      # Timeout — window focus, then one scan
      if [[ -f "${STATE_DIR}/focus_in" ]]; then
        rm -f "${STATE_DIR}/focus_in"
        WINDOW_FOCUSED=1
      fi
      if [[ -f "${STATE_DIR}/focus_out" ]]; then
        rm -f "${STATE_DIR}/focus_out"
        WINDOW_FOCUSED=0
      fi
      cs_tick
      cs_consume_pending_load
      if ((MENU_ACTIVE)) && [[ "${ENTRIES_ID[${SELECTED}]:-}" != "${MENU_TARGET_ID}" ]]; then
        MENU_ACTIVE=0; DIRTY=1
      fi
      # PICKER_ACTIVE is from cs_tick above: nothing between it and here may change focus
      local fp
      cs_fingerprint fp "${PICKER_ACTIVE}"
      if [[ "${fp}" != "${LAST_FINGERPRINT}" ]]; then
        LAST_FINGERPRINT="${fp}"
        DIRTY=1
      fi
    fi
    if ((WINCH_PENDING)); then
      WINCH_PENDING=0
      cs_handle_winch
    fi
    if ((DIRTY)); then
      cs_picker_render
      DIRTY=0
      cs_fingerprint LAST_FINGERPRINT
    fi
  done
}

cs_move_down() {
  local n=${#ENTRIES_ID[@]} local_only=${1:-0}
  ((n == 0)) && return 0
  local start=${SELECTED}
  SELECTED=$(( (SELECTED + 1) % n ))
  if ((local_only)); then
    while [[ "${ENTRIES_TYPE[${SELECTED}]}" != "local" ]] && ((SELECTED != start)); do
      SELECTED=$(( (SELECTED + 1) % n ))
    done
  else
    while [[ "${ENTRIES_TYPE[${SELECTED}]}" == "header" || "${ENTRIES_TYPE[${SELECTED}]}" == "spacer" ]] && ((SELECTED != start)); do
      SELECTED=$(( (SELECTED + 1) % n ))
    done
  fi
}

cs_move_up() {
  local n=${#ENTRIES_ID[@]} local_only=${1:-0}
  ((n == 0)) && return 0
  local start=${SELECTED}
  SELECTED=$(( (SELECTED - 1 + n) % n ))
  if ((local_only)); then
    while [[ "${ENTRIES_TYPE[${SELECTED}]}" != "local" ]] && ((SELECTED != start)); do
      SELECTED=$(( (SELECTED - 1 + n) % n ))
    done
  else
    while [[ "${ENTRIES_TYPE[${SELECTED}]}" == "header" || "${ENTRIES_TYPE[${SELECTED}]}" == "spacer" ]] && ((SELECTED != start)); do
      SELECTED=$(( (SELECTED - 1 + n) % n ))
    done
  fi
}

cs_del_kv() {
  local file="$1" key="$2"
  [[ -f "${file}" ]] || return 0
  local tmp="${file}.tmp"
  grep -v "^${key}=" "${file}" > "${tmp}" 2>/dev/null || true
  mv "${tmp}" "${file}"
}

cs_set_kv() {
  local file="$1" key="$2" value="$3"
  local safe="${value//\\/\\\\}"
  safe="${safe//|/\\|}"
  safe="${safe//&/\\&}"
  if grep -q "^${key}=" "${file}" 2>/dev/null; then
    sed "s|^${key}=.*|${key}=${safe}|" "${file}" > "${file}.tmp" && mv "${file}.tmp" "${file}"
  elif grep -q "^# ${key}=" "${file}" 2>/dev/null; then
    sed "s|^# ${key}=.*|${key}=${safe}|" "${file}" > "${file}.tmp" && mv "${file}.tmp" "${file}"
  else
    echo "${key}=${value}" >> "${file}"
  fi
}

# Put the cursor on the shown session, or on the first row when nothing is shown.
cs_sync_highlight_local() {
  local idx i
  if [[ -n "${SHOWN}" ]]; then
    cs_find_entry_index "${SHOWN}" idx
    if [[ "${idx}" != "-1" ]]; then
      SELECTED=${idx}
      return
    fi
  fi
  for ((i = 0; i < ${#ENTRIES_ID[@]}; i++)); do
    if [[ "${ENTRIES_TYPE[${i}]}" != "header" && "${ENTRIES_TYPE[${i}]}" != "spacer" ]]; then
      SELECTED=${i}
      return
    fi
  done
}

cs_activate_selected() {
  local n=${#ENTRIES_ID[@]}
  ((n == 0)) && return 0
  case "${ENTRIES_TYPE[${SELECTED}]}" in
    local) cs_show_session "${ENTRIES_ID[${SELECTED}]}" ;;
    project)
      cs_switch_to_project "${ENTRIES_PATH[${SELECTED}]}"
      cs_sync_highlight_local
      ;;
    remote)
      cs_switch_to_project "${ENTRIES_PATH[${SELECTED}]}" "${ENTRIES_ID[${SELECTED}]}"
      cs_sync_highlight_local
      ;;
  esac
}

# Hop to another project's view. The launcher reads switch_target once this
# client has detached: the project path, then the session to show there, if any.
# pending_load is not written here. The launcher writes it after it has
# initialized the target's state, because that wipes the state dir of a server
# that is not running, which is the normal case for another project.
cs_switch_to_project() {
  local target_path="$1" id="${2:-}"
  [[ -n "${target_path}" ]] || return 0
  printf '%s\n%s\n' "${target_path}" "${id}" > "${STATE_DIR}/switch_target"
  _tmux detach-client 2>/dev/null || true
}

# A hop from another project's picker asked for a session to be shown here.
cs_consume_pending_load() {
  local pending idx
  cs_read_state_into pending pending_load
  [[ -n "${pending}" ]] || return 0
  rm -f "${STATE_DIR}/pending_load"
  [[ "${pending}" =~ ${ID_RE} ]] || return 0
  cs_poll 1 || true
  cs_rescan
  cs_find_entry_index "${pending}" idx
  [[ "${idx}" != "-1" && "${ENTRIES_TYPE[${idx}]}" == "local" ]] || return 0
  SELECTED=${idx}
  if cs_show_session "${pending}"; then
    cs_focus_session
  fi
  DIRTY=1
}

cs_confirm() {
  local color="$1" text="$2"
  local width
  width=$(tput cols)
  cs_render_header_bar "\e[7m${color}" "${text}" "${width}"
  local confirm=""
  read -rsn1 confirm
  [[ "${confirm}" == "y" ]]
}

cs_read_line() {
  local initial="${1:-}"
  CS_INPUT_RESULT="${initial}"
  printf '%s' "${CS_INPUT_RESULT}"
  while IFS= read -rsn1 ch; do
    case "${ch}" in
      $'\e')
        read -rsn2 -t 0.1 _ || true
        if [[ -z "${CS_INPUT_RESULT}" ]]; then
          return 1
        fi
        local _len=${#CS_INPUT_RESULT}
        printf '%*s' "${_len}" "" | tr ' ' $'\b'
        printf '%*s' "${_len}" ""
        printf '%*s' "${_len}" "" | tr ' ' $'\b'
        CS_INPUT_RESULT=""
        ;;
      $'\x7f'|$'\b')
        if ((${#CS_INPUT_RESULT} > 0)); then
          CS_INPUT_RESULT="${CS_INPUT_RESULT%?}"
          printf '\b \b'
        fi
        ;;
      "") return 0 ;;
      *)
        if [[ "${ch}" == [[:print:]] ]]; then
          CS_INPUT_RESULT+="${ch}"
          printf '%s' "${ch}"
        fi
        ;;
    esac
  done
  return 1
}

# Closes the view. Sessions belong to Claude's supervisor and keep running.
cs_confirm_shutdown() {
  # The terminals live in this server and die with it. Say so when there are any.
  local prompt="Shutdown? y/N" f
  for f in "${STATE_DIR}"/term/*; do
    if [[ -f "${f}" && "${f##*/}" != *.* ]]; then
      prompt="Shutdown, kill terminals? y/N"
      break
    fi
  done
  cs_confirm "${CS_CLR_PROMPT_DANGER}" "${prompt}" || return 0
  stty echo 2>/dev/null || true
  printf '\e[?25h\e[0m'
  cs_remove_focus_hook
  cs_remove_keybindings
  rm -rf "${STATE_DIR}"
  _tmux kill-server 2>/dev/null || true
}

cs_rename_project() {
  local target_path=""
  local entry_type="${ENTRIES_TYPE[${SELECTED}]:-}"
  local sanitized=""
  case "${entry_type}" in
    local|"") target_path="${PWD}"; sanitized="${PWD_SANITIZED}" ;;
    project|remote) target_path="${ENTRIES_PATH[${SELECTED}]}"; sanitized=$(cs_sanitize_path "${target_path}") ;;
    *) return 0 ;;
  esac
  [[ -n "${target_path}" ]] || return 0

  local old_name="${PROJECT_NAMES[${sanitized}]:-}"
  local width
  width=$(tput cols)
  cs_render_header_bar "\e[7m${CS_CLR_PROMPT_WARN}" "Project: " "${width}"
  printf '\e[1;10H\e[7m%b' "${CS_CLR_PROMPT_WARN}"
  printf '\e[?25h'
  if cs_read_line "${old_name}"; then
    if [[ -n "${CS_INPUT_RESULT}" ]]; then
      cs_set_kv "${PROJECT_NAMES_FILE}" "${sanitized}" "${CS_INPUT_RESULT}"
      PROJECT_NAMES["${sanitized}"]="${CS_INPUT_RESULT}"
    elif [[ -n "${old_name}" ]]; then
      cs_del_kv "${PROJECT_NAMES_FILE}" "${sanitized}"
      unset "PROJECT_NAMES[${sanitized}]"
    fi
    cs_rescan
  fi
  printf '\e[?25l\e[0m'
}

# client-focus-in/out tell the picker whether the terminal window has focus. A
# session only counts as seen while it does.
cs_install_focus_hook() {
  _tmux set -s focus-events on
  # Paths reach run-shell via tmux env vars so attacker-controlled characters
  # in STATE_DIR cannot break out of the hook command string.
  _tmux set-environment -g CS_FOCUS_IN "${STATE_DIR}/focus_in"
  _tmux set-environment -g CS_FOCUS_OUT "${STATE_DIR}/focus_out"
  _tmux set-hook -g client-focus-in 'run-shell "touch \"\$CS_FOCUS_IN\""'
  _tmux set-hook -g client-focus-out 'run-shell "touch \"\$CS_FOCUS_OUT\""'
}

cs_remove_focus_hook() {
  _tmux set-hook -gu client-focus-in 2>/dev/null || true
  _tmux set-hook -gu client-focus-out 2>/dev/null || true
  _tmux set-environment -gu CS_FOCUS_IN 2>/dev/null || true
  _tmux set-environment -gu CS_FOCUS_OUT 2>/dev/null || true
}

cs_bind() {
  local action="$1" defaults="$2"
  shift 2
  local tmux_args=("$@")
  local keys="${BIND_OVERRIDES[bind_${action}]:-${defaults}}"
  local key_list key
  IFS=',' read -ra key_list <<< "${keys}"
  for key in "${key_list[@]}"; do
    key="${key// /}"
    _tmux bind-key "${key}" "${tmux_args[@]}"
  done
}

cs_install_keybindings() {
  local user_prefix
  user_prefix=$(_tmux show-options -gv prefix 2>/dev/null || echo "C-b")

  if [[ -n "${CS_PREFIX:-}" ]]; then
    _tmux set-option -g prefix "${CS_PREFIX}"
    user_prefix="${CS_PREFIX}"
  fi

  # Wipe prefix table only (preserves root/mouse/copy-mode)
  _tmux unbind-key -a -T prefix

  # Re-bind send-prefix so double-prefix sends the literal key
  _tmux bind-key "${user_prefix}" send-prefix

  # Focus claude pane (reuses existing | trigger)
  cs_bind focus_claude 'Enter,i' send-keys -t "${PICKER_PANE}" "|"

  # Session navigation (sends J/K to picker = move+activate+focus)
  cs_bind nav_next 'J,S-Down' send-keys -t "${PICKER_PANE}" "J"
  cs_bind nav_prev 'K,S-Up' send-keys -t "${PICKER_PANE}" "K"

  # Pane movement
  cs_bind pane_left 'h,Left,S-Left' select-pane -L
  cs_bind pane_right 'l,Right,S-Right' select-pane -R
  cs_bind pane_up 'k,Up' select-pane -U
  cs_bind pane_down 'j,Down' select-pane -D

  # Smart focus: picker↔claude toggle
  cs_bind focus_picker Space send-keys -t "${PICKER_PANE}" $'\x0f'

  # Detach
  cs_bind detach d detach-client

  # Zoom
  cs_bind zoom z resize-pane -Z

  # Copy/paste
  cs_bind copy_mode '[' copy-mode
  cs_bind paste ']' paste-buffer

  # Refresh/rescan (dedicated trigger)
  cs_bind refresh + send-keys -t "${PICKER_PANE}" $'\x12'

  # Command menu: focus picker + enter menu
  cs_bind menu ':' send-keys -t "${PICKER_PANE}" $'\x05'

  # tmux command prompt (escape hatch)
  _tmux bind-key F12 command-prompt

  # Search and new-session: non-printable triggers, picker handles focus-steal
  cs_bind search / send-keys -t "${PICKER_PANE}" $'\x01'
  cs_bind new_session c send-keys -t "${PICKER_PANE}" $'\x02'
  cs_bind close x send-keys -t "${PICKER_PANE}" $'\x06'
  cs_bind remove D send-keys -t "${PICKER_PANE}" $'\x14'
  cs_bind agents v send-keys -t "${PICKER_PANE}" $'\x10'

  # Terminal
  cs_bind terminal '`' send-keys -t "${PICKER_PANE}" '`'
  cs_bind side_terminal Tab send-keys -t "${PICKER_PANE}" $'\t'
  cs_bind bottom_terminal q send-keys -t "${PICKER_PANE}" '_'
  cs_bind toggle_terminal t send-keys -t "${PICKER_PANE}" "~"
  # With the grave as prefix, prefix+grave is the terminal: this types a literal one
  _tmux bind-key a send-keys '`'
  cs_bind rename_project p send-keys -t "${PICKER_PANE}" $'\x19'
  cs_bind shutdown s send-keys -t "${PICKER_PANE}" $'\x16'
  cs_bind reload R send-keys -t "${PICKER_PANE}" $'\x0e'
  cs_bind help '?' send-keys -t "${PICKER_PANE}" '?'

  _tmux bind-key PPage copy-mode -u
  _tmux bind-key NPage send-keys -X page-down
  _tmux bind-key S-PPage copy-mode '\;' send-keys -X halfpage-up
  _tmux bind-key S-NPage send-keys -X halfpage-down
  _tmux bind-key -T copy-mode-vi S-PPage send-keys -X halfpage-up
  _tmux bind-key -T copy-mode-vi S-NPage send-keys -X halfpage-down
  _tmux bind-key -T copy-mode S-PPage send-keys -X halfpage-up
  _tmux bind-key -T copy-mode S-NPage send-keys -X halfpage-down

  # Resize (M-arrows ×2, C-arrows ×5)
  _tmux bind-key -r M-Up resize-pane -U 2
  _tmux bind-key -r M-Down resize-pane -D 2
  _tmux bind-key -r M-Left resize-pane -L 2
  _tmux bind-key -r M-Right resize-pane -R 2
  _tmux bind-key -r C-Up resize-pane -U 5
  _tmux bind-key -r C-Down resize-pane -D 5
  _tmux bind-key -r C-Left resize-pane -L 5
  _tmux bind-key -r C-Right resize-pane -R 5

  # Jump to Nth session (1-9, 0=10th)
  local n
  for n in 1 2 3 4 5 6 7 8 9 0; do
    _tmux bind-key "${n}" send-keys -t "${PICKER_PANE}" "${n}"
  done
}

cs_remove_keybindings() {
  _tmux unbind-key -a -T prefix 2>/dev/null || true
}

# ── Reset ─────────────────────────────────────────
# Closes the view and clears its state. Sessions keep running.
cs_reset() {
  PWD_SANITIZED=$(cs_sanitize_path "${PWD}")
  STATE_DIR="${CS_STATE_ROOT}/${PWD_SANITIZED}"
  cs_assert_state_dir_safe
  _tmux kill-server 2>/dev/null || true
  rm -rf "${STATE_DIR}"
  echo "Reset complete. Sessions keep running."
}

# ── Launcher ──────────────────────────────────────
cs_launch() {
  # Session a hop asked this project's picker to show
  local pending=""
  while true; do
    cs_load_config
    cs_init_state
    # Only now can the request be left for the picker: cs_init_state has just
    # wiped the state dir if this project's server was not running.
    if [[ -n "${pending}" ]]; then
      echo "${pending}" > "${STATE_DIR}/pending_load"
      pending=""
    fi

    local session_name
    session_name="csa$(cs_sanitize_path "${PWD}")"

    # A live server built by another version can't run this picker. Say so, but never
    # kill it from under the user just because they ran claude-spaces-agents.
    if _tmux has-session 2>/dev/null \
       && [[ "$(cs_read_state compat_version)" != "${CS_COMPAT_VERSION}" ]]; then
      echo
      echo "  claude-spaces-agents was updated, but the running view still uses the old layout —"
      echo "  you're on the previous version until it restarts."
      echo
      echo "    press  prefix+R            (inside the view), or"
      echo "    run    claude-spaces-agents --restart"
      echo
      echo "  Either restarts the view. Sessions keep running; open terminals close."
      echo
      [[ -t 0 ]] && read -rsn1 -p "  Press any key to continue... "
      echo
    fi

    if ! _tmux has-session 2>/dev/null; then
      # Only when a server is about to be created, not on a re-attach.
      cs_preflight_claude || exit 1
      _tmux new-session -d -s "${session_name}" \
        "CS_PICKER=1 CS_STATE_DIR=${STATE_DIR@Q} exec ${SCRIPT_PATH@Q}"
      if [[ -n "${TMUX_CONF}" && -f "${TMUX_CONF}" ]]; then
        _tmux source-file "${TMUX_CONF}" 2>/dev/null || true
      fi
      _tmux set -g window-status-format ''
      _tmux set -g window-status-current-format ''
      _tmux set -g status-left-length 50
      _tmux set -s focus-events on
      _tmux set -s extended-keys on
      _tmux set -gw allow-set-title on
    fi

    # Block until detach (NOT exec — we need control back for project switching)
    command tmux -L "${TMUX_SERVER}" attach-session

    # The picker found an incompatible server and killed it. It couldn't tell the user —
    # it was a pane inside that server — so we do it here, where the shell has the
    # terminal back and the message survives in scrollback.
    if [[ -f "${STATE_DIR}/restart_required" ]]; then
      rm -f "${STATE_DIR}/restart_required"
      echo "claude-spaces-agents was updated and the layout changed, so the view was closed."
      echo "Run claude-spaces-agents again — your sessions kept running."
      break
    fi

    # A hop: the picker left the project to switch to, and maybe a session.
    if [[ -f "${STATE_DIR}/switch_target" ]]; then
      local target_path="" target_id=""
      {
        IFS= read -r target_path
        IFS= read -r target_id
      } < "${STATE_DIR}/switch_target"
      rm -f "${STATE_DIR}/switch_target"
      if [[ -d "${target_path}" ]]; then
        cd "${target_path}" || break
        cs_normalize_pwd
        TMUX_SERVER=$(cs_server_name "$PWD")
        [[ "${target_id}" =~ ${ID_RE} ]] && pending="${target_id}"
        continue
      fi
    fi
    break  # normal detach
  done
}

# ── Entrypoint ────────────────────────────────────
cs_preflight

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  echo "claude-spaces-agents v${VERSION} — tmux picker for Claude Code background sessions"
  echo ""
  echo "Usage:"
  echo "  claude-spaces-agents            Launch picker"
  echo "  claude-spaces-agents --reset    Close the view, clear its state (sessions keep running)"
  echo "  claude-spaces-agents --restart  Reset and relaunch"
  echo "  claude-spaces-agents --help     Show this help"
  echo ""
  cs_help_text
  echo ""
  echo "Config: ${CONFIG_FILE}"
  exit 0
fi

if [[ "${1:-}" == "--reset" ]]; then
  cs_load_config
  cs_reset
  exit 0
fi

if [[ "${1:-}" == "--restart" ]]; then
  cs_load_config
  cs_reset
  exec "${SCRIPT_PATH}"
fi

if [[ "${CS_PICKER:-}" == "1" ]]; then
  STATE_DIR="${CS_STATE_DIR:-}"
  if [[ -z "${STATE_DIR}" ]]; then
    echo "ERROR: CS_STATE_DIR not set"
    exit 1
  fi
  cs_load_config
  # Reached with new code inside an old server after `R` re-execs us. We can't run
  # against a topology we didn't build, and we can't migrate it, so stop the server.
  # Leave a marker for cs_launch to explain — anything printed here dies with the
  # server. Do NOT wipe STATE_DIR, or the marker goes with it.
  if [[ "$(cs_read_state compat_version)" != "${CS_COMPAT_VERSION}" ]]; then
    : > "${STATE_DIR}/restart_required"
    _tmux kill-server 2>/dev/null || true
    exit 0
  fi
  cs_picker_loop
else
  cs_launch "$@"
fi
