#!/usr/bin/env bash
# ══════════════════════════════════════════════════
# claude-spaces-agents break runner
#
# A green test only proves that it can pass. Each break below damages one thing
# in a copy of claude-spaces-agents and names the tests that must go red because
# of it. The real files are never touched.
#
#   run_breaks           every break, then the tests no break names
#   run_breaks <word>    only the breaks whose label or tests contain <word>
#
# A break:
#
#   @@ what is broken | test_name [test_name ...]
#   - a line, exactly as it is in the file (one or more, contiguous)
#   + what goes in its place (none: the lines are deleted)
#   &&
#   - a second place to damage in the same break (optional)
#
# The `-` lines must be in the file exactly once. A header ending in `| harness`
# damages run_tests instead: that is how the check that runs after every
# test is itself seen to fail.
#
# When code changes, a break whose lines are gone is reported, not skipped.
# ══════════════════════════════════════════════════

if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  for _bash in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [[ -x "$_bash" ]] && exec "$_bash" "$0" "$@"
  done
  echo "ERROR: bash 4.4+ required (found ${BASH_VERSION})."
  exit 1
fi

HERE=$(dirname "$(readlink -f "$0")")
SCRIPT=$(readlink -f "${SCRIPT_UNDER_TEST:-${HERE}/claude-spaces-agents}")
TESTS="${HERE}/run_tests"
FILTER="${1:-}"

RED='\033[31m'
GREEN='\033[32m'
RESET='\033[0m'

WORK=$(mktemp -d)
trap 'rm -rf "${WORK}"' EXIT

B_LABEL=()
B_TESTS=()
B_TARGET=()
B_HUNKS=()
declare -A H_OLD H_NEW H_HAS_OLD H_HAS_NEW
declare -A BASE
REASON=""
COPY=""

load_breaks() {
  local line n=-1 h=0 key label rest target
  while IFS= read -r line; do
    case "${line}" in
      "@@ "*)
        n=$((n + 1))
        h=0
        line="${line#@@ }"
        label="${line%% | *}"
        rest="${line#* | }"
        target="script"
        if [[ "${rest}" == *" | harness" ]]; then
          target="harness"
          rest="${rest% | harness}"
        fi
        B_LABEL[n]="${label}"
        B_TESTS[n]="${rest}"
        B_TARGET[n]="${target}"
        B_HUNKS[n]=1
        ;;
      "&&")
        h=$((h + 1))
        B_HUNKS[n]=$((h + 1))
        ;;
      "- "*|"-")
        key="${n}.${h}"
        if [[ -v "H_HAS_OLD[${key}]" ]]; then
          H_OLD[${key}]+=$'\n'"${line:2}"
        else
          H_OLD[${key}]="${line:2}"
          H_HAS_OLD[${key}]=1
        fi
        ;;
      "+ "*|"+")
        key="${n}.${h}"
        if [[ -v "H_HAS_NEW[${key}]" ]]; then
          H_NEW[${key}]+=$'\n'"${line:2}"
        else
          H_NEW[${key}]="${line:2}"
          H_HAS_NEW[${key}]=1
        fi
        ;;
    esac
  done
}

# apply_break <n> — write the damaged copy and set COPY, or set REASON and fail
apply_break() {
  local n="$1" src dst h key i j k hits at
  if [[ "${B_TARGET[n]}" == "harness" ]]; then
    src="${TESTS}"
    dst="${WORK}/run_tests"
  else
    src="${SCRIPT}"
    dst="${WORK}/claude-spaces-agents"
  fi
  local -a lines old new
  mapfile -t lines < "${src}"
  for ((h = 0; h < B_HUNKS[n]; h++)); do
    key="${n}.${h}"
    if [[ ! -v "H_HAS_OLD[${key}]" ]]; then
      REASON="place $((h + 1)) names no lines to damage"
      return 1
    fi
    mapfile -t old <<< "${H_OLD[${key}]}"
    new=()
    if [[ -v "H_HAS_NEW[${key}]" ]]; then
      mapfile -t new <<< "${H_NEW[${key}]}"
    fi
    k=${#old[@]}
    hits=0
    at=-1
    for ((i = 0; i + k <= ${#lines[@]}; i++)); do
      [[ "${lines[i]}" == "${old[0]}" ]] || continue
      for ((j = 1; j < k; j++)); do
        [[ "${lines[i + j]}" == "${old[j]}" ]] || continue 2
      done
      hits=$((hits + 1))
      at=${i}
    done
    if ((hits != 1)); then
      REASON="its lines are in ${src##*/} ${hits} times, not once (place $((h + 1)))"
      return 1
    fi
    lines=("${lines[@]:0:at}" "${new[@]}" "${lines[@]:at + k}")
  done
  printf '%s\n' "${lines[@]}" > "${dst}"
  chmod +x "${dst}"
  if ! bash -n "${dst}" 2>/dev/null; then
    REASON="the damaged copy is not valid bash"
    return 1
  fi
  COPY="${dst}"
}

# run_one <script> <tests file> <test> — prints pass, fail or error
run_one() {
  local out
  out=$(SCRIPT_UNDER_TEST="$1" timeout 180 "$2" "$3" 2>&1 | sed $'s/\x1b\\[[0-9;]*m//g')
  printf '%s\n' "${out}" > "${WORK}/last.out"
  if [[ "${out}" == *$'\n'"1 passed, 0 failed"* ]]; then
    echo "pass"
  elif [[ "${out}" == *$'\n'"0 passed, 1 failed"* ]]; then
    echo "fail"
  else
    echo "error"
  fi
}

# True when test $1 is green on the undamaged files.
baseline() {
  if [[ ! -v "BASE[$1]" ]]; then
    BASE[$1]=$(run_one "${SCRIPT}" "${TESTS}" "$1")
  fi
  [[ "${BASE[$1]}" == "pass" ]]
}

main() {
  echo "claude-spaces-agents breaks"
  echo "══════════════════════════════════"
  echo "script: ${SCRIPT}"
  echo ""
  local n t verdict reds=0 problems=0 breaks=0
  for ((n = 0; n < ${#B_LABEL[@]}; n++)); do
    if [[ -n "${FILTER}" && "${B_LABEL[n]}" != *"${FILTER}"* && "${B_TESTS[n]}" != *"${FILTER}"* ]]; then
      continue
    fi
    breaks=$((breaks + 1))
    if ! apply_break "${n}"; then
      echo -e "  ${RED}BAD BREAK${RESET}  ${B_LABEL[n]}: ${REASON}"
      problems=$((problems + 1))
      continue
    fi
    for t in ${B_TESTS[n]}; do
      if ! baseline "${t}"; then
        echo -e "  ${RED}NOT GREEN${RESET}  ${t} does not pass before anything is broken"
        problems=$((problems + 1))
        continue
      fi
      if [[ "${B_TARGET[n]}" == "harness" ]]; then
        verdict=$(run_one "${SCRIPT}" "${COPY}" "${t}")
      else
        verdict=$(run_one "${COPY}" "${TESTS}" "${t}")
      fi
      case "${verdict}" in
        fail)
          echo -e "  ${GREEN}red${RESET}        ${B_LABEL[n]}  (${t})"
          reds=$((reds + 1))
          ;;
        pass)
          echo -e "  ${RED}STAYED GREEN${RESET}  ${B_LABEL[n]}  (${t})"
          problems=$((problems + 1))
          ;;
        *)
          echo -e "  ${RED}NO VERDICT${RESET}  ${B_LABEL[n]}  (${t}): the run did not end with one test failed"
          tail -5 "${WORK}/last.out" | sed 's/^/      /'
          problems=$((problems + 1))
          ;;
      esac
    done
  done

  # every test has to be named by a break
  if [[ -z "${FILTER}" ]]; then
    local named=" ${B_TESTS[*]} "
    while read -r t; do
      [[ -n "${t}" ]] || continue
      if [[ "${named}" != *" ${t} "* ]]; then
        echo -e "  ${RED}NO BREAK${RESET}   ${t} was never seen failing"
        problems=$((problems + 1))
      fi
    done < <(grep -o '^  run_test "[^"]*" *test_[a-z0-9_]*' "${TESTS}" | grep -o 'test_[a-z0-9_]*$')
  fi

  echo ""
  echo "══════════════════════════════════"
  echo -e "${breaks} breaks, ${reds} ${GREEN}went red${RESET}, ${problems} ${RED}problems${RESET}"
  ((problems == 0 && breaks > 0))
}

