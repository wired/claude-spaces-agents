# The check that runs after every test, tested: it has to notice each kind of
# leftover it is there for, and say nothing about a state that is in order.
test_invariant_check_notices() {
  fake_add aaaaaaa1 done idle "alpha"
  fake_add aaaaaaa2 done idle "beta"
  cs_poll 1 || { fail "poll failed"; return 1; }
  show_with_terminal aaaaaaa1 bottom || { fail "setup failed"; return 1; }
  local out tp stray
  tp=$(term_pane_of aaaaaaa1)
  out=$(csa_assert_consistent "in order") || { fail "a state in order was reported: ${out}"; return 1; }

  # notices <what the check must say> — true when it fails and says it
  notices() {
    if out=$(csa_assert_consistent "probe"); then
      fail "went unnoticed: $1"
      return 1
    fi
    [[ "${out}" == *"$1"* ]] || { fail "reported, but not as '$1': ${out}"; return 1; }
  }

  stray=$(_tmux new-window -d -P -F '#{pane_id}' "sleep 99999")
  notices "untracked pane ${stray}" || return 1
  _tmux set -p -t "${stray}" @csa_placeholder 1
  notices "placeholder pane ${stray}" || return 1
  _tmux kill-pane -t "${stray}"

  echo "aaaaaaa2" > "${STATE_DIR}/displayed"
  notices "terminal of 'aaaaaaa1' is in the main window but 'aaaaaaa2' is displayed" || return 1
  echo "aaaaaaa1" > "${STATE_DIR}/displayed"

  rm -f "${STATE_DIR}/term/aaaaaaa1.shown"
  notices "is marked hidden" || return 1
  echo 1 > "${STATE_DIR}/term/aaaaaaa1.shown"

  echo "%999999" > "${STATE_DIR}/term/aaaaaaa2"
  notices "term/aaaaaaa2 references dead pane" || return 1
  rm -f "${STATE_DIR}/term/aaaaaaa2"

  echo 1 > "${STATE_DIR}/term/aaaaaaa2.shown"
  notices "term/aaaaaaa2.shown exists but the terminal does not" || return 1
  rm -f "${STATE_DIR}/term/aaaaaaa2.shown"

  local saved_client
  saved_client=$(cat "${STATE_DIR}/client_pane")
  echo "%999999" > "${STATE_DIR}/client_pane"
  notices "client pane '%999999' is gone" || return 1
  echo "${saved_client}" > "${STATE_DIR}/client_pane"

  # a second terminal in the main window
  stray=$(_tmux split-window -d -t "${CLIENT_PANE}" -P -F '#{pane_id}' "sleep 99999")
  echo "${stray}" > "${STATE_DIR}/term/aaaaaaa2"
  echo 1 > "${STATE_DIR}/term/aaaaaaa2.shown"
  notices "2 terminals in the main window" || return 1
  _tmux kill-pane -t "${stray}"
  rm -f "${STATE_DIR}/term/aaaaaaa2" "${STATE_DIR}/term/aaaaaaa2.shown"

  # the displayed session's terminal, marked shown, but parked
  cs_refresh_geom
  cs_term_park "${tp}" || { fail "could not park"; return 1; }
  notices "terminal of the displayed session is parked" || return 1
  cs_term_show aaaaaaa1 bottom || { fail "could not bring the terminal back"; return 1; }

  out=$(csa_assert_consistent "put back") || { fail "not in order after putting everything back: ${out}"; return 1; }
}

