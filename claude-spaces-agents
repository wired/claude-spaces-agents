cs_compress_suffix() {
  local suffix="$1"
  local stripped="${suffix//[!\/]/}"
  local slashes=${#stripped}
  if ((slashes <= 1)); then
    echo "${suffix}"
  else
    echo "${suffix%%/*}/.../${suffix##*/}"
  fi
}

cs_resolve_collision_group() {
  local -n _grp=$1
  local n=${#_grp[@]}
  local -a comp_strs=()
  local gi
  for ((gi=0; gi<n; gi++)); do
    local -a _parts
    IFS='/' read -ra _parts <<< "${_grp[gi]}"
    local -a _filtered=()
    local _c
    for _c in "${_parts[@]}"; do
      [[ -n "${_c}" ]] && _filtered+=("${_c}")
    done
    local IFS=$'\n'
    comp_strs+=("${_filtered[*]}")
  done
  local depth=1
  while true; do
    local -A suffix_map
    suffix_map=()
    local -a suffixes=()
    for ((gi=0; gi<n; gi++)); do
      local -a comps
      mapfile -t comps <<< "${comp_strs[gi]}"
      local nc=${#comps[@]}
      local suffix=""
      local di start=$((nc - depth))
      ((start < 0)) && start=0
      for ((di=start; di<nc; di++)); do
        [[ -n "${suffix}" ]] && suffix+="/"
        suffix+="${comps[di]}"
      done
      suffixes+=("${suffix}")
      suffix_map["${suffix}"]=$(( ${suffix_map["${suffix}"]:-0} + 1 ))
    done
    local all_unique=1
    for ((gi=0; gi<n; gi++)); do
      ((suffix_map["${suffixes[gi]}"] > 1)) && { all_unique=0; break; }
    done
    if ((all_unique)); then
      # Compress, then check for display collisions
      local -a compressed=()
      local -A comp_count
      comp_count=()
      for ((gi=0; gi<n; gi++)); do
        local _cs
        _cs=$(cs_compress_suffix "${suffixes[gi]}")
        compressed+=("${_cs}")
        comp_count["${_cs}"]=$(( ${comp_count["${_cs}"]:-0} + 1 ))
      done
      for ((gi=0; gi<n; gi++)); do
        if ((comp_count["${compressed[gi]}"] > 1)); then
          DISPLAY_NAMES["${_grp[gi]}"]="${suffixes[gi]}"
        else
          DISPLAY_NAMES["${_grp[gi]}"]="${compressed[gi]}"
        fi
      done
      return
    fi
    ((depth++))
    if ((depth > 50)); then
      for ((gi=0; gi<n; gi++)); do
        DISPLAY_NAMES["${_grp[gi]}"]="${_grp[gi]}"
      done
      return
    fi
  done
}

cs_compute_display_names() {
  DISPLAY_NAMES=()
  local -a all_paths=()
  local -A seen
  local _p
  for _p in "${PWD}" \
        "${REMOTE_SERVERS[@]/#*|/}" \
        "${INACTIVE_PROJECTS[@]/#*|/}"; do
    [[ -z "${_p}" || -v "seen[${_p}]" ]] && continue
    seen["${_p}"]=1
    all_paths+=("${_p}")
  done
  local -A leaf_count
  for _p in "${all_paths[@]}"; do
    local _leaf="${_p##*/}"
    leaf_count["${_leaf}"]=$(( ${leaf_count["${_leaf}"]:-0} + 1 ))
  done
  local -A leaf_done
  for _p in "${all_paths[@]}"; do
    local _leaf="${_p##*/}"
    if ((leaf_count["${_leaf}"] == 1)); then
      DISPLAY_NAMES["${_p}"]="${_leaf}"
    elif [[ ! -v "leaf_done[${_leaf}]" ]]; then
      leaf_done["${_leaf}"]=1
      local -a group=()
      local _q
      for _q in "${all_paths[@]}"; do
        [[ "${_q##*/}" == "${_leaf}" ]] && group+=("${_q}")
      done
      cs_resolve_collision_group group
    fi
  done
}

# ── Polling ───────────────────────────────────────
# Refresh the session list: from Claude, or from the shared cache when another
# picker refreshed it within the interval. $1=1 bypasses the cache. Returns 1
# when Claude fails; the previous list then stays in place.
cs_agents_refresh() {
  local force="${1:-0}"
  local cache="${CS_STATE_ROOT}/agents.json"
  local now json="" from_cache=0
  printf -v now '%(%s)T' -1
  LAST_POLL=${now}
  if ((!force)) && [[ -f "${cache}" ]]; then
    local cm
    cm=$(_cs_stat "${cache}" 2>/dev/null) || cm=""
    cm="${cm%% *}"
    if [[ "${cm}" =~ ^[0-9]+$ ]] && ((now - cm < POLL_INTERVAL)); then
      { json=$(< "${cache}"); } 2>/dev/null
      [[ -n "${json}" ]] && from_cache=1
    fi
  fi
  if ((!from_cache)); then
    if ! json=$(cs_claude agents --json --all 2>"${STATE_DIR}/poll.err"); then
      { POLL_ERROR=$(< "${STATE_DIR}/poll.err"); } 2>/dev/null
      POLL_ERROR="${POLL_ERROR%%$'\n'*}"
      [[ -n "${POLL_ERROR}" ]] || POLL_ERROR="claude agents --json failed"
      return 1
    fi
  fi
  # One row per background session. Control characters are taken out of the name
  # here, which also guarantees one session per line.
  local rows
  if ! rows=$(jq -r '.[] | select(.kind == "background")
        | [.id, (.state // ""), (.status // ""), (.sessionId // ""), (.cwd // ""),
           ((.startedAt // 0) | tostring), ((.name // "") | gsub("[[:cntrl:]]"; " "))]
        | join("\u001f")' <<< "${json}" 2>/dev/null); then
    POLL_ERROR="could not read the session list from claude"
    return 1
  fi
  if ((!from_cache)); then
    # temp file + mv: another picker reading the cache never sees half of it
    printf '%s\n' "${json}" > "${cache}.$$" 2>/dev/null && mv "${cache}.$$" "${cache}" 2>/dev/null
  fi
  POLL_ERROR=""
  POLLED=1
  AG_IDS=()
  AG_STATE=(); AG_STATUS=(); AG_SID=(); AG_CWD=(); AG_NAME=(); AG_STARTED=()
  local id state status sid cwd started name
  while IFS=$'\x1f' read -r id state status sid cwd started name; do
    # These end up in command lines: nothing but the expected shapes gets through.
    [[ "${id}" =~ ${ID_RE} ]] || continue
    [[ "${sid}" =~ ${UUID_RE} ]] || sid=""
    [[ "${started}" =~ ^[0-9]+$ ]] || started=0
    AG_IDS+=("${id}")
    AG_STATE["${id}"]="${state}"
    AG_STATUS["${id}"]="${status}"
    AG_SID["${id}"]="${sid}"
    AG_CWD["${id}"]="${cwd}"
    AG_STARTED["${id}"]="${started}"
    AG_NAME["${id}"]="${name}"
  done <<< "${rows}"
  return 0
}

# Epoch of the last conversation record in the final $2 bytes of transcript $1:
# a user or assistant message, or the end of a turn. Housekeeping records carry
# no timestamp or are not activity. A line cut in half by the window is skipped.
cs_transcript_last_activity() {
  tail -c "$2" "$1" 2>/dev/null | jq -rRn '
    [inputs | fromjson?
      | select(.type == "user" or .type == "assistant"
               or (.type == "system" and .subtype == "turn_duration"))
      | .timestamp | select(type == "string")]
    | last // empty | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601' 2>/dev/null
}

# Find each session's transcript and read its last activity. The file is found by
# session id, not by a computed directory name, and is read again only when its
# mtime changed. The mtime itself is not the activity time: Claude appends
# housekeeping records when a process stops, restarts or is attached.
cs_activity_refresh() {
  local id sid path cand
  local -a paths=()
  for id in "${AG_IDS[@]}"; do
    sid="${AG_SID[${id}]}"
    [[ -n "${sid}" ]] || continue
    path="${AG_TPATH[${id}]:-}"
    if [[ -z "${path}" || ! -f "${path}" ]]; then
      path=""
      for cand in "${PROJECTS_DIR}"/*/"${sid}.jsonl"; do
        if [[ -f "${cand}" ]]; then
          path="${cand}"
          break
        fi
      done
      AG_TPATH["${id}"]="${path}"
    fi
    [[ -n "${path}" ]] && paths+=("${path}")
  done
  ((${#paths[@]} > 0)) || return 0
  local -A mt=()
  local m f ts
  while read -r m f; do
    mt["${f}"]="${m}"
  done < <(_cs_stat "${paths[@]}" 2>/dev/null)
  for id in "${AG_IDS[@]}"; do
    path="${AG_TPATH[${id}]:-}"
    [[ -n "${path}" ]] || continue
    m="${mt[${path}]:-}"
    [[ -n "${m}" ]] || continue
    [[ "${AG_TMTIME[${id}]:-}" == "${m}" ]] && continue
    AG_TMTIME["${id}"]="${m}"
    ts=$(cs_transcript_last_activity "${path}" 262144)
    [[ -n "${ts}" ]] || ts=$(cs_transcript_last_activity "${path}" 4194304)
    if [[ "${ts}" =~ ^[0-9]+$ ]]; then
      AG_ACT["${id}"]="${ts}"
      AG_ACT_SRC["${id}"]="record"
    else
      # good enough for the age column and the order, never for a bell
      AG_ACT["${id}"]="${m}"
      AG_ACT_SRC["${id}"]="mtime"
    fi
  done
}

# Read when each session was last shown, and sweep the files of sessions that
# are gone. Called only after a successful poll: a failed one proves nothing.
cs_seen_refresh() {
  SEEN_AT=()
  [[ -d "${SEEN_DIR}" ]] || return 0
  local m f id
  while read -r m f; do
    id="${f##*/}"
    [[ "${id}" =~ ${ID_RE} ]] || continue
    SEEN_AT["${id}"]="${m}"
  done < <(_cs_stat "${SEEN_DIR}"/* 2>/dev/null)
  for id in "${!SEEN_AT[@]}"; do
    if [[ -v "AG_STATE[${id}]" ]]; then
      unset "SEEN_ABSENT[${id}]"
      continue
    fi
    SEEN_ABSENT["${id}"]=$(( ${SEEN_ABSENT[${id}]:-0} + 1 ))
    if ((SEEN_ABSENT[${id}] >= 5)); then
      rm -f "${SEEN_DIR}/${id}"
      unset "SEEN_ABSENT[${id}]" "SEEN_AT[${id}]"
    fi
  done
}

# Record that session $1 is being looked at. The redirect updates the file's
# mtime without forking, and the file is never rewritten with content, so two
# pickers cannot lose each other's update.
cs_mark_seen() {
  local id="$1"
  [[ "${id}" =~ ${ID_RE} ]] || return 0
  { : > "${SEEN_DIR}/${id}"; } 2>/dev/null || return 0
  printf -v "SEEN_AT[${id}]" '%(%s)T' -1
  unset "UNSEEN_SET[${id}]"
}

# Finished, unseen: done or failed, and active since it was last shown. A session
# never shown here has nothing to compare against and is not flagged. Only a time
# read from a transcript record counts; an mtime moves on housekeeping and would
# raise a bell an hour after every conversation.
cs_compute_unseen() {
  UNSEEN_SET=()
  local id st
  for id in "${AG_IDS[@]}"; do
    st="${AG_STATE[${id}]}"
    [[ "${st}" == "done" || "${st}" == "failed" ]] || continue
    [[ -v "SEEN_AT[${id}]" ]] || continue
    if [[ "${AG_ACT_SRC[${id}]:-}" == "record" ]] && ((AG_ACT[${id}] > SEEN_AT[${id}])); then
      UNSEEN_SET["${id}"]=1
    fi
  done
}

# Refresh the list and everything derived from it. $1=1 bypasses the cache.
cs_poll() {
  cs_agents_refresh "${1:-0}" || return 1
  cs_activity_refresh
  cs_seen_refresh
  cs_term_sweep
}

# Poll when the interval is up, and only while someone is attached to look.
cs_poll_tick() {
  ((SESSION_ATTACHED > 0)) || return 0
  local now
  printf -v now '%(%s)T' -1
  ((now - LAST_POLL >= POLL_INTERVAL)) || return 0
  cs_poll || true
}

# ── Session List ──────────────────────────────────
# Sort newline-joined lines $3 with sort args $4..., into var $1. Memoized under key $2.
cs_sort_memo() {
  local _out="$1" _key="$2" _in="$3"
  shift 3
  if [[ -n "${SORT_MEMO_IN[${_key}]+x}" && "${SORT_MEMO_IN[${_key}]}" == "${_in}" ]]; then
    printf -v "${_out}" '%s' "${SORT_MEMO_OUT[${_key}]}"
    return
  fi
  local _so
  _so=$(sort "$@" <<< "${_in}")
  SORT_MEMO_IN["${_key}"]="${_in}"
  SORT_MEMO_OUT["${_key}"]="${_so}"
  printf -v "${_out}" '%s' "${_so}"
}

# Sessions active within recent_threshold minutes first: the ones that are not
# dim, then by name. Then the rest, most recent first. Ended sessions (failed,
# stopped) always sort with the rest.
cs_sort_entries() {
  local n=${#ENTRIES_ID[@]}
  local now
  printf -v now '%(%s)T' -1
  RECENT_CUTOFF=$((now - RECENT_THRESHOLD * 60))
  ((n <= 1)) && return 0

  local recent_indices=() older_indices=() i
  for ((i = 0; i < n; i++)); do
    case "${ENTRIES_STATUS[i]}" in
      failed|stopped)
        older_indices+=("${i}")
        ;;
      *)
        if ((ENTRIES_MTIME[i] >= RECENT_CUTOFF)); then
          recent_indices+=("${i}")
        else
          older_indices+=("${i}")
        fi
        ;;
    esac
  done

  # Sort recent by not-dim-first, then name (case-insensitive); index first to handle spaces
  local sorted_recent=""
  if ((${#recent_indices[@]} > 0)); then
    local _rin="" rank look
    for i in "${recent_indices[@]}"; do
      rank=1
      cs_row_look look "${ENTRIES_ID[${i}]}" "${ENTRIES_STATUS[${i}]}"
      [[ "${look}" != "dormant" ]] && rank=0
      _rin+="${_rin:+$'\n'}${i} ${rank} ${ENTRIES_NAME[${i}],,}"
    done
    cs_sort_memo sorted_recent recent "${_rin}" -t' ' -k2,2 -k3
  fi

  # Sort older by last activity, descending
  local sorted_older=""
  if ((${#older_indices[@]} > 0)); then
    local _oin=""
    for i in "${older_indices[@]}"; do
      _oin+="${_oin:+$'\n'}${ENTRIES_MTIME[${i}]} ${i}"
    done
    cs_sort_memo sorted_older older "${_oin}" -rnk1
  fi

  local new_id=() new_name=() new_mtime=() new_status=() new_sid=() new_type=() new_path=()
  local idx
  if [[ -n "${sorted_recent}" ]]; then
    while read -r idx _; do
      new_id+=("${ENTRIES_ID[${idx}]}")
      new_name+=("${ENTRIES_NAME[${idx}]}")
      new_mtime+=("${ENTRIES_MTIME[${idx}]}")
      new_status+=("${ENTRIES_STATUS[${idx}]}")
      new_sid+=("${ENTRIES_SID[${idx}]}")
      new_type+=("${ENTRIES_TYPE[${idx}]}")
      new_path+=("${ENTRIES_PATH[${idx}]}")
    done <<< "${sorted_recent}"
  fi
  if [[ -n "${sorted_older}" ]]; then
    while read -r _ idx; do
      new_id+=("${ENTRIES_ID[${idx}]}")
      new_name+=("${ENTRIES_NAME[${idx}]}")
      new_mtime+=("${ENTRIES_MTIME[${idx}]}")
      new_status+=("${ENTRIES_STATUS[${idx}]}")
      new_sid+=("${ENTRIES_SID[${idx}]}")
      new_type+=("${ENTRIES_TYPE[${idx}]}")
      new_path+=("${ENTRIES_PATH[${idx}]}")
    done <<< "${sorted_older}"
  fi

  ENTRIES_ID=("${new_id[@]}")
  ENTRIES_NAME=("${new_name[@]}")
  ENTRIES_MTIME=("${new_mtime[@]}")
  ENTRIES_STATUS=("${new_status[@]}")
  ENTRIES_SID=("${new_sid[@]}")
  ENTRIES_TYPE=("${new_type[@]}")
  ENTRIES_PATH=("${new_path[@]}")
}

# Build the rows from the last list: this project's background sessions, then
# the other projects that have any. A session inside <project>/.claude/worktrees/
# belongs to <project>.
cs_build_all_entries() {
  cs_entry_clear
  local id name mt proj
  # other project → its session ids, space separated
  local -A other=()
  for id in "${AG_IDS[@]}"; do
    proj="${AG_CWD[${id}]%%/.claude/worktrees/*}"
    if [[ "${proj}" != "${PWD}" ]]; then
      [[ -n "${proj}" ]] && other["${proj}"]+="${id} "
      continue
    fi
    cs_row_fields name mt "${id}"
    cs_entry_append "${id}" "${name}" "${mt}" "${AG_STATE[${id}]}" "${AG_SID[${id}]}" "local" "${AG_CWD[${id}]}"
  done
  cs_sort_entries

  # Other projects: each one that has background sessions, then its sessions, most
  # recent first. Selecting either hops to that project's own view.
  local projs="" sorted=""
  for proj in "${!other[@]}"; do
    projs+="${projs:+$'\n'}${proj}"
  done
  [[ -n "${projs}" ]] && cs_sort_memo sorted projects "${projs}"
  cs_other_projects_names "${sorted}"
  [[ -n "${sorted}" ]] || return 0

  cs_entry_append "__spacer_remote__" "" "0" "" "" "spacer" ""
  cs_entry_append "__hdr_remote__" "other projects" "0" "" "" "header" ""
  local first=1 sanitized leaf lines order
  while IFS= read -r proj; do
    [[ -n "${proj}" ]] || continue
    sanitized="${proj//\//-}"
    sanitized="${sanitized//_/-}"
    leaf="${PROJECT_NAMES[${sanitized}]:-${DISPLAY_NAMES[${proj}]:-${proj##*/}}}"
    if ((first)); then
      first=0
    else
      cs_entry_append "__spacer_proj_${sanitized}__" "" "0" "" "" "spacer" ""
    fi
    cs_entry_append "__proj_${sanitized}__" "${leaf}" "0" "" "" "project" "${proj}"
    lines=""
    for id in ${other[${proj}]}; do
      cs_row_fields name mt "${id}"
      lines+="${lines:+$'\n'}${mt} ${id}"
    done
    cs_sort_memo order "remote:${proj}" "${lines}" -rnk1
    while read -r _ id; do
      [[ -n "${id}" ]] || continue
      cs_row_fields name mt "${id}"
      cs_entry_append "${id}" "${name}" "${mt}" "${AG_STATE[${id}]}" "${AG_SID[${id}]}" "remote" "${proj}"
    done <<< "${order}"
  done <<< "${sorted}"
}

# Name and last-activity time of session $3's row, into the variables named $1
# and $2.
cs_row_fields() {
  local _rf_n="$1" _rf_m="$2" _rf_id="$3"
  local _rf_st="${AG_STATE[${_rf_id}]}" _rf_name="${AG_NAME[${_rf_id}]}" _rf_mt
  if [[ -z "${_rf_name}" || "${_rf_name}" == "${_rf_id}" ]]; then
    # no prompt yet: Claude names it after its own id
    if [[ "${_rf_st}" == "blocked" && "${AG_STATUS[${_rf_id}]}" == "idle" ]]; then
      _rf_name="(new session)"
    else
      _rf_name="${_rf_id}"
    fi
  fi
  case "${_rf_st}" in
    failed|stopped) _rf_name+=" (${_rf_st})" ;;
  esac
  # no transcript yet: order by when it started, and show no age
  if [[ -n "${AG_ACT[${_rf_id}]:-}" ]]; then
    _rf_mt="${AG_ACT[${_rf_id}]}"
  else
    _rf_mt=$(( AG_STARTED[${_rf_id}] / 1000 ))
  fi
  printf -v "${_rf_n}" '%s' "${_rf_name}"
  printf -v "${_rf_m}" '%s' "${_rf_mt}"
}

# Display names depend on which projects are listed. Recompute them only when
# that set changes. $1 is the sorted list of other projects, one per line.
OTHER_PROJECTS_KEY=""
cs_other_projects_names() {
  [[ "$1" == "${OTHER_PROJECTS_KEY}" ]] && return 0
  OTHER_PROJECTS_KEY="$1"
  REMOTE_SERVERS=()
  local p
  while IFS= read -r p; do
    [[ -n "${p}" ]] && REMOTE_SERVERS+=("x|${p}")
  done <<< "$1"
  cs_compute_display_names
}

# Rebuild the rows from what the last poll left, keeping the cursor on its session.
cs_rescan() {
  local selected_id=""
  if ((${#ENTRIES_ID[@]} > 0 && SELECTED < ${#ENTRIES_ID[@]})); then
    selected_id="${ENTRIES_ID[${SELECTED}]}"
  fi
  cs_compute_unseen
  cs_build_all_entries
  cs_search_save_full
  # Restore selection: by ID, then the shown session, then clamp
  local _sel_found=0 idx
  if [[ -n "${selected_id}" ]]; then
    cs_find_entry_index "${selected_id}" idx
    if [[ "${idx}" != "-1" ]]; then
      SELECTED=${idx}
      _sel_found=1
    fi
  fi
  if ((!_sel_found)); then
    if [[ -n "${SHOWN}" ]]; then
      cs_find_entry_index "${SHOWN}" idx
      if [[ "${idx}" != "-1" ]]; then
        SELECTED=${idx}
      fi
    fi
    local n=${#ENTRIES_ID[@]}
    if ((SELECTED >= n && n > 0)); then
      SELECTED=$((n - 1))
    fi
  fi
  if ((SEARCH_ACTIVE)); then
    cs_search_apply_filter
  fi
}

cs_find_entry_index() {
  local target_id="$1" _out="$2"
  for ((fi=0; fi < ${#ENTRIES_ID[@]}; fi++)); do
    if [[ "${ENTRIES_ID[${fi}]}" == "${target_id}" ]]; then
      printf -v "${_out}" '%s' "${fi}"
      return
    fi
  done
  printf -v "${_out}" '%s' "-1"
}

