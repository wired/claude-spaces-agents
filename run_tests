  SEARCH_TERM="0123456789012345678901234567890123456789"
  screen_rows 40 20 colors
  [[ "${row[1]}" != *$'\e[48;5;231m'* ]] || { fail "a cell over a term that fills the pane: $(printf '%q' "${row[1]}")"; return 1; }
}

# ── Tests: attention ─────────────────────────────

# Finished, unseen: by the time the last turn ended, read from the transcript,
# against the last time the session was shown. Never by the file's mtime, and
# never for a session that was never shown here.
test_unseen_rules() {
  local now
  now=$(date +%s)
  # A: finished after it was last shown
  fake_add aaaaaaa1 done idle "finished since"
  fake_transcript aaaaaaa1 $((now - 100))
  seen_at aaaaaaa1 $((now - 200))
  # B: shown after it finished
  fake_add aaaaaaa2 done idle "seen"
  fake_transcript aaaaaaa2 $((now - 300))
  seen_at aaaaaaa2 $((now - 200))
  # C: like B, but its process was stopped since: housekeeping moved the mtime
  fake_add aaaaaaa3 done idle "seen, then stopped"
  fake_transcript aaaaaaa3 $((now - 300))
  seen_at aaaaaaa3 $((now - 200))
  fake_housekeeping aaaaaaa3
  # D: never shown here, so there is nothing to compare against: not flagged
  fake_add aaaaaaa4 done idle "never shown"
  fake_transcript aaaaaaa4 $((now - 300))
  # E: still working, never shown
  fake_add aaaaaaa5 working busy "working"
  # F: a transcript with nothing but housekeeping in it
  fake_add aaaaaaa6 done idle "unreadable"
  echo '{"type":"cost-state"}' > "$(transcript_of aaaaaaa6)"
  seen_at aaaaaaa6 $((now - 200))
  # G: failed after it was last shown
  fake_add aaaaaaa7 failed "" "failed since"
  fake_transcript aaaaaaa7 $((now - 100))
  seen_at aaaaaaa7 $((now - 200))
  # H: still working, though shown before its last record
  fake_add aaaaaaa8 working busy "working, seen"
  fake_transcript aaaaaaa8 $((now - 100))
  seen_at aaaaaaa8 $((now - 200))

  cs_poll 1 || { fail "poll failed"; return 1; }
  cs_rescan
  local flagged
  flagged=$(printf '%s\n' "${!UNSEEN_SET[@]}" | sort | tr '\n' ' ')
  assert_eq "flagged" "${flagged}" "aaaaaaa1 aaaaaaa7 " || return 1
  assert_eq "A read from a record" "${AG_ACT_SRC[aaaaaaa1]}" "record" || return 1
  assert_eq "A last activity" "${AG_ACT[aaaaaaa1]}" "$((now - 100))" || return 1
  assert_eq "C last activity ignores housekeeping" "${AG_ACT[aaaaaaa3]}" "$((now - 300))" || return 1
  assert_eq "F fell back to the mtime" "${AG_ACT_SRC[aaaaaaa6]}" "mtime"
}

