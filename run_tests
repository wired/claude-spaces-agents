# Jump numbers go to session rows, of this project and of the others, and to
# nothing else. With more sessions than numbers, the rows that are not dim come
# first, whatever their project, and dim rows fill what is left in list order.
# The numbers themselves always run in display order.
test_jump_slots() {
  local i idx
  for i in 1 2 3; do
    fake_add "aaaaaaa${i}" done idle "session ${i}"
  done
  fake_add bbbbbbb1 done idle "theirs" "/work/other"
  cs_poll 1 || { fail "poll failed"; return 1; }
  cs_rescan
  cs_compute_jump_slots
  for ((i = 0; i < ${#ENTRIES_ID[@]}; i++)); do
    case "${ENTRIES_TYPE[${i}]}" in
      local|remote) ;;
      *) [[ ! -v "JUMP_SLOT[${i}]" ]] || { fail "a ${ENTRIES_TYPE[${i}]} row got a jump number"; return 1; } ;;
    esac
  done
  assert_eq "slots with four sessions" "${#JUMP_SLOT[@]}" "4" || return 1
  cs_find_entry_index bbbbbbb1 idx
  assert_eq "another project's session, after this project's" "${JUMP_SLOT[${idx}]:-none}" "4" || return 1
  assert_eq "key 4 goes to it" "${JUMP_TARGET[4]:-none}" "${idx}" || return 1

  # More sessions than numbers: thirteen here, three of them not dim, and two in
  # the other project, one of them not dim.
  for i in 4 5 6 7 8 9 a b c d; do
    fake_add "aaaaaaa${i}" done "" "asleep ${i}"
  done
  fake_add bbbbbbb2 done "" "asleep theirs" "/work/other"
  cs_poll 1 || { fail "second poll failed"; return 1; }
  cs_rescan
  cs_compute_jump_slots
  assert_eq "slots given" "${#JUMP_SLOT[@]}" "10" || return 1
  # Down the list: every row that is not dim has a number, and so do the first
  # six dim ones. The numbers go 1 to 9, then 0.
  local dim=0 want=1
  for ((i = 0; i < ${#ENTRIES_ID[@]}; i++)); do
    case "${ENTRIES_TYPE[${i}]}" in
      local|remote) ;;
      *) continue ;;
    esac
    if [[ "${ENTRIES_NAME[${i}]}" == asleep* ]]; then
      dim=$((dim + 1))
      if ((dim > 6)); then
        [[ ! -v "JUMP_SLOT[${i}]" ]] || { fail "dim row ${dim}, '${ENTRIES_NAME[${i}]}', got a jump number"; return 1; }
        continue
      fi
    fi
    assert_eq "number of '${ENTRIES_NAME[${i}]}'" "${JUMP_SLOT[${i}]:-none}" "$((want % 10))" || return 1
    assert_eq "key $((want % 10))" "${JUMP_TARGET[$((want % 10))]:-none}" "${i}" || return 1
    want=$((want + 1))
  done
  cs_find_entry_index bbbbbbb1 idx
  assert_eq "not dim, below thirteen rows of this project" "${JUMP_SLOT[${idx}]:-none}" "0" || return 1

  SHOW_INDEX=0
  cs_compute_jump_slots
  assert_eq "slots with show_index off" "${#JUMP_SLOT[@]}" "0"
}

