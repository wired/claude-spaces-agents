# Stopping a session keeps its terminal: the session can be opened again.
# Removing it kills the terminal with it.
test_term_stop_keeps_remove_kills() {
  fake_add aaaaaaa1 done idle "alpha"
  cs_poll 1 || { fail "poll failed"; return 1; }
  cs_rescan
  show_with_terminal aaaaaaa1 bottom || { fail "setup failed"; return 1; }
  local tp
  tp=$(term_pane_of aaaaaaa1)
  SELECTED=0
  cs_confirm_end stop "Stop? y/N" <<< "y" > /dev/null
  pane_is_alive "${tp}" || { fail "stop killed the terminal"; return 1; }
  assert_eq "still tracked after stop" "$(term_pane_of aaaaaaa1)" "${tp}" || return 1
  if in_main "${tp}"; then
    fail "the terminal stayed beside the welcome screen"
    return 1
  fi
  [[ -f "${STATE_DIR}/term/aaaaaaa1.shown" ]] || { fail "stop forgot that the terminal was open"; return 1; }

  cs_confirm_end rm "Remove (stops work)? y/N" <<< "y" > /dev/null
  if pane_is_alive "${tp}"; then
    fail "remove left the terminal running"
    return 1
  fi
  local n
  n=$(find "${STATE_DIR}/term" -type f | wc -l | tr -d ' ')
  assert_eq "state files left" "${n}" "0"
}

# A terminal can hold a running process. Its session has to be missing from five
# successful polls in a row before it is killed; a failed poll does not count.
test_term_killed_only_when_session_is_gone() {
  fake_add aaaaaaa1 done idle "alpha"
  fake_add aaaaaaa2 done idle "beta"
  cs_poll 1 || { fail "poll failed"; return 1; }
  show_with_terminal aaaaaaa1 bottom || { fail "setup failed"; return 1; }
  cs_show_session aaaaaaa2 || { fail "switch failed"; return 1; }
  local tp i
  tp=$(term_pane_of aaaaaaa1)
  fake_drop aaaaaaa1
  for i in 1 2 3 4; do
    cs_poll 1 || { fail "poll ${i} failed"; return 1; }
  done
  pane_is_alive "${tp}" || { fail "killed after only four polls"; return 1; }
  touch "${FAKE_CLAUDE_DIR}/fail"
  cs_poll 1
  cs_poll 1
  rm -f "${FAKE_CLAUDE_DIR}/fail"
  pane_is_alive "${tp}" || { fail "killed on failed polls"; return 1; }
  cs_poll 1 || { fail "fifth poll failed"; return 1; }
  if pane_is_alive "${tp}"; then
    fail "still running after five polls without its session"
    return 1
  fi
  [[ ! -e "${STATE_DIR}/term/aaaaaaa1" ]] || { fail "its state was kept"; return 1; }
}

