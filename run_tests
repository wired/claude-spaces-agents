# A terminal belongs to its session, not to a pane: it survives a switch away and
# back as the same pane, at the same size, without being sent a SIGWINCH.
test_term_survives_switch() {
  fake_add aaaaaaa1 done idle "alpha"
  fake_add aaaaaaa2 done idle "beta"
  cs_poll 1 || { fail "poll failed"; return 1; }
  show_with_terminal aaaaaaa1 bottom || { fail "setup failed"; return 1; }
  local tp size t0 a0
  tp=$(term_pane_of aaaaaaa1)
  size=$(pane_size "${tp}")
  settle
  t0=$(term_winch "${tp}")
  a0=$(client_winch aaaaaaa1)

  cs_show_session aaaaaaa2 || { fail "switch away failed"; return 1; }
  settle
  pane_is_alive "${tp}" || { fail "the terminal died on the switch"; return 1; }
  if in_main "${tp}"; then
    fail "the terminal stayed beside another session"
    return 1
  fi
  assert_eq "size while parked" "$(pane_size "${tp}")" "${size}" || return 1
  assert_eq "SIGWINCH to the terminal, parked" "$(term_winch "${tp}")" "${t0}" || return 1
  assert_eq "SIGWINCH to the session shown" "$(client_winch aaaaaaa2)" "0" || return 1

  cs_show_session aaaaaaa1 || { fail "switch back failed"; return 1; }
  settle
  assert_eq "the same pane" "$(term_pane_of aaaaaaa1)" "${tp}" || return 1
  in_main "${tp}" || { fail "the terminal did not come back"; return 1; }
  assert_eq "size after coming back" "$(pane_size "${tp}")" "${size}" || return 1
  assert_eq "SIGWINCH to the terminal, back" "$(term_winch "${tp}")" "${t0}" || return 1
  assert_eq "SIGWINCH to its session, back" "$(client_winch aaaaaaa1)" "${a0}"
}

# Two sessions with the same layout: their terminals trade places, and nothing
# is resized.
test_term_same_layout_swap() {
  fake_add aaaaaaa1 done idle "alpha"
  fake_add aaaaaaa2 done idle "beta"
