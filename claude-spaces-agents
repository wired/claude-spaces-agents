# ── Config ────────────────────────────────────────
# Config values get no shell expansion, so a literal ~ would be used verbatim.
cs_expand_tilde() {
  # SC2088: matching the literal tilde is the point.
  # shellcheck disable=SC2088
  if [[ "$1" == "~/"* ]]; then
    printf '%s\n' "${HOME}/${1#\~/}"
  else
    printf '%s\n' "$1"
  fi
}

cs_load_config() {
  mkdir -p "${CS_CONFIG_DIR}" "${CS_DATA_DIR}"
  if [[ ! -f "${CONFIG_FILE}" ]]; then
    cs_create_default_config
  fi
  while IFS='=' read -r key value; do
    [[ -z "${key}" || "${key}" =~ ^[[:space:]]*# ]] && continue
    key="${key// /}"
    value="${value// /}"
    # Validate numeric keys before assignment — values reach bash arithmetic,
    # which recursively evaluates and would execute $(...) in malformed input.
    case "${key}" in
      recent_threshold|window_name_len|min_claude_width|min_claude_height|show_index|poll_interval)
        if [[ ! "${value}" =~ ^[0-9]+$ ]]; then
          echo "WARN: ignoring invalid ${key}=${value} (expected non-negative integer)" >&2
          continue
        fi
        ;;
      picker_width|terminal_height|terminal_width)
        if [[ ! "${value}" =~ ^[0-9]+%?$ ]]; then
          echo "WARN: ignoring invalid ${key}=${value} (expected integer or percentage)" >&2
          continue
        fi
        ;;
      tmux_conf)
        # Expansion only — empty still means "don't source", and a bad path
        # already degrades gracefully via the -f guard in cs_launch.
        value=$(cs_expand_tilde "${value}")
        ;;
      state_root)
        # A literal ~ would create a directory named '~' in $PWD.
        value=$(cs_expand_tilde "${value}")
        value="${value%/}"
        # Relative paths would make the state root follow $PWD and break
        # cross-project discovery. $HOME is refused because cs_init_state
        # chmod 700s the root.
        if [[ "${value}" != /* || "${value}" == "${HOME}" ]]; then
          echo "WARN: ignoring invalid state_root=${value} (expected absolute path, not \$HOME)" >&2
          continue
        fi
        ;;
    esac
    case "${key}" in
      picker_width) PICKER_WIDTH="${value}" ;;
      recent_threshold) RECENT_THRESHOLD="${value}" ;;
      picker_side) PICKER_SIDE="${value}" ;;
      window_name_len) WINDOW_NAME_LEN="${value}" ;;
      tmux_conf) TMUX_CONF="${value}" ;;
      poll_interval) POLL_INTERVAL="${value}" ;;
      terminal_height) TERMINAL_HEIGHT="${value}" ;;
      terminal_width) TERMINAL_WIDTH="${value}" ;;
      min_claude_width) MIN_CLAUDE_WIDTH="${value}" ;;
      min_claude_height) MIN_CLAUDE_HEIGHT="${value}" ;;
      show_index) SHOW_INDEX="${value}" ;;
      prefix) CS_PREFIX="${value}" ;;
      state_root) CS_STATE_ROOT="${value}" ;;
      color_header_bg) CS_CLR_HEADER_BG="${value}" ;;
      color_active) CS_CLR_ACTIVE="${value}" ;;
      color_bell) CS_CLR_BELL="${value}" ;;
      color_running) CS_CLR_RUNNING="${value}" ;;
      color_dormant) CS_CLR_DORMANT="${value}" ;;
      color_selection) CS_CLR_SELECTION="${value}" ;;
      color_chrome) CS_CLR_CHROME="${value}" ;;
      color_section) CS_CLR_SECTION="${value}" ;;
      color_prompt_warn) CS_CLR_PROMPT_WARN="${value}" ;;
      color_prompt_danger) CS_CLR_PROMPT_DANGER="${value}" ;;
      color_bell_menu) CS_CLR_BELL_MENU="${value}" ;;
      color_search_bar) CS_CLR_SEARCH_BAR="${value}" ;;
      color_bold) CS_CLR_BOLD="${value}" ;;
      bind_*) BIND_OVERRIDES["${key}"]="${value}" ;;
    esac
  done < "${CONFIG_FILE}"
}

