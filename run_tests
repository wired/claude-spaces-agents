test_read_state_into() {
  local v rc
  printf 'a\nb\n\n' > "${STATE_DIR}/rsi_multi"
  rm -f "${STATE_DIR}/rsi_missing"
  cs_read_state_into v rsi_multi
  [[ "${v}" == $'a\nb' ]] || { fail "present: got '${v}'"; return 1; }
  cs_read_state_into v rsi_missing
  [[ -z "${v}" ]] || { fail "missing: stale value kept: '${v}'"; return 1; }
  v=$(cs_read_state rsi_multi); rc=$?
  [[ "${v}" == $'a\nb' && ${rc} -eq 0 ]] || { fail "cs_read_state present: '${v}' rc=${rc}"; return 1; }
