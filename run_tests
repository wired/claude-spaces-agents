# mosh drops the dim attribute, so what used to be dim is drawn in a grey: a row
# with no process, the footer, the header of the other projects. Nothing on the
# screen carries the attribute.
test_dim_is_grey() {
  local now
  now=$(date +%s)
  fake_add aaaaaaa1 done idle "alpha"
  fake_add aaaaaaa2 done "" "asleep"
  fake_add bbbbbbb1 done idle "theirs" "/work/other"
  fake_transcript aaaaaaa1 $((now - 7200))
  fake_transcript aaaaaaa2 $((now - 10800))
  cs_poll 1 || { fail "poll failed"; return 1; }
  cs_rescan
  local -a row
  local grey=$'\e\\[38;5;245m[^\e]*'
  local section=$'\e\\[1m\e\\[38;5;245m─ other projects ─'
  local dim=$'\e\\[([0-9];)*2(;[0-9])*m'
  local i
  # 1 header, 2 alpha (selected), 3 asleep, 4 empty, 5 "other projects",
  # 6 the project, 7 its session, 8 empty, 9-10 key hints, 11 empty, 12 the version
  screen_rows 40 20 colors
  [[ "${row[3]}" =~ ${grey}asleep ]] || { fail "a row with no process is not grey: $(printf '%q' "${row[3]}")"; return 1; }
  [[ "${row[10]}" =~ ${grey}Q:detach ]] || { fail "the key hints are not grey: $(printf '%q' "${row[10]}")"; return 1; }
  [[ "${row[5]}" =~ ${section} ]] || { fail "the section header is not bold and grey: $(printf '%q' "${row[5]}")"; return 1; }
  for ((i = 1; i < ${#row[@]}; i++)); do
    [[ "${row[i]}" =~ ${dim} ]] && { fail "row ${i} carries the dim attribute: $(printf '%q' "${row[i]}")"; return 1; }
  done
  return 0
}

# The search field's cursor is a white cell drawn after the term. mosh drops the
# sequence that colours the terminal's own cursor, and that cursor is red on the
# green bar. The cell is there only while the field has the keys and the picker
# is the active pane, which is when tmux showed the cursor, and it never covers
# the term.
test_search_cursor_cell() {
  fake_add aaaaaaa1 done idle "alpha"
  fake_add aaaaaaa2 done idle "beta"
  cs_poll 1 || { fail "poll failed"; return 1; }
