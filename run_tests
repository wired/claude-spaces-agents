# Two sessions with different layouts: the client pane changes size between
# them, and still neither terminal nor the session shown is sent a SIGWINCH,
# because nothing is attached while the terminals move. The session being left
# is not counted: its client dies in the same tmux call.
test_term_different_layout_switch() {
  fake_add aaaaaaa1 done idle "alpha"
  fake_add aaaaaaa2 done idle "beta"
  cs_poll 1 || { fail "poll failed"; return 1; }
  show_with_terminal aaaaaaa1 bottom || { fail "setup A failed"; return 1; }
  show_with_terminal aaaaaaa2 side || { fail "setup B failed"; return 1; }
  local ta tb sa sb ta0 tb0 a0 b0 client_b client_a
  ta=$(term_pane_of aaaaaaa1)
  tb=$(term_pane_of aaaaaaa2)
  sa=$(pane_size "${ta}")
  sb=$(pane_size "${tb}")
  client_b=$(pane_size "${CLIENT_PANE}")
  settle
  ta0=$(term_winch "${ta}")
  tb0=$(term_winch "${tb}")
  a0=$(client_winch aaaaaaa1)
  b0=$(client_winch aaaaaaa2)

  cs_show_session aaaaaaa1 || { fail "switch to A failed"; return 1; }
  settle
  client_a=$(pane_size "${CLIENT_PANE}")
  [[ "${client_a}" != "${client_b}" ]] || { fail "the client pane did not change size (${client_a})"; return 1; }
  in_main "${ta}" || { fail "A's terminal is not in the main window"; return 1; }
  if in_main "${tb}"; then
    fail "B's terminal stayed in the main window"
    return 1
  fi
  assert_eq "A's terminal size" "$(pane_size "${ta}")" "${sa}" || return 1
  assert_eq "B's terminal size, parked" "$(pane_size "${tb}")" "${sb}" || return 1
  assert_eq "SIGWINCH to A's terminal" "$(term_winch "${ta}")" "${ta0}" || return 1
  assert_eq "SIGWINCH to B's terminal" "$(term_winch "${tb}")" "${tb0}" || return 1
  assert_eq "SIGWINCH to A's session" "$(client_winch aaaaaaa1)" "${a0}" || return 1

  cs_show_session aaaaaaa2 || { fail "switch to B failed"; return 1; }
  settle
  assert_eq "the client pane, back at B's size" "$(pane_size "${CLIENT_PANE}")" "${client_b}" || return 1
  assert_eq "B's terminal size, back" "$(pane_size "${tb}")" "${sb}" || return 1
  assert_eq "SIGWINCH to A's terminal, parked" "$(term_winch "${ta}")" "${ta0}" || return 1
  assert_eq "SIGWINCH to B's terminal, back" "$(term_winch "${tb}")" "${tb0}" || return 1
  assert_eq "SIGWINCH to B's session, back" "$(client_winch aaaaaaa2)" "${b0}" || return 1

  # The counters do count: a resize made on purpose reaches both the terminal
  # and the session beside it.
  _tmux resize-pane -t "${tb}" -x "$(( ${sb%x*} - 3 ))"
  settle
  [[ "$(term_winch "${tb}")" -gt "${tb0}" ]] || { fail "a real resize of the terminal was not counted"; return 1; }
  [[ "$(client_winch aaaaaaa2)" -gt "${b0}" ]] || { fail "a real resize of the session was not counted"; return 1; }
}

